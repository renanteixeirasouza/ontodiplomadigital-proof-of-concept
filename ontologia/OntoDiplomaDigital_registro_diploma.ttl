    odd:xsdPath "TSeguranca/CodigoValidacao" ;
    odd:xsdElement "CodigoValidacao" ;
    odd:xsdType "TCodigoValidacao" ;
    odd:sourceNote
        "Rastreabilidade XSD declarada por dcterms:source, odd:xsdPath, odd:xsdElement e odd:xsdType; o padrão lexical permanece definido no XSD Tipos_Basicos_v1.05."@pt .

odd:workloadHours
    a owl:DatatypeProperty ;
    rdfs:label
        "carga horária"@pt ,
        "workload hours"@en ;
    rdfs:comment
        "Carga horária total do curso, em horas."@pt ,
        "Total workload of the program, in hours."@en ;
    rdfs:domain odd:Curso ;
    rdfs:range xsd:decimal .

odd:qualificationName
    a owl:DatatypeProperty ;
    rdfs:label
        "nome da habilitação"@pt ,
        "qualification name"@en ;
    rdfs:comment
        "Nome textual da habilitação associada ao curso."@pt ,
