    odd:xsdType "TData" .

odd:academicDocumentationRequestId
    a owl:DatatypeProperty , owl:FunctionalProperty ;
    owl:deprecated "true"^^xsd:boolean ;
    rdfs:label
        "identificador da documentação acadêmica"@pt ,
        "academic documentation request identifier"@en ;
    rdfs:comment
        "Identificador que vincula os dados de registro do diploma à requisição de documentação acadêmica correspondente."@pt ,
        "Identifier linking diploma registration data to the corresponding academic documentation request."@en ;
    rdfs:domain odd:RegistroDiploma ;
    rdfs:range xsd:string ;
    dcterms:source odd:FonteXsdLeiauteDiplomaDigital , odd:FonteXsdLeiauteDocumentacaoAcademicaRegistro ;
    odd:xsdPath "TDadosRegistro/IdDocumentacaoAcademica" ;
    odd:xsdElement "IdDocumentacaoAcademica" ;
    odd:xsdType "xs:ID" ;
    odd:modelingRationale
        "Propriedade legada substituída por odd:hasAcademicDocumentationRequest. O identificador passou a ser odd:identifier do recurso odd:RequisicaoDocumentacaoAcademica, fazendo com que dcterms:identifier descreva o sujeito correto."@pt ;
    odd:sourceNote
        "O XSD restringe o valor ao padrão ReqDip seguido de 44 dígitos; a ontologia registra a rastreabilidade, mas a validação lexical permanece no XSD."@pt .

odd:diplomaProcessNumber
    a owl:DatatypeProperty ;
    owl:deprecated "true"^^xsd:boolean ;
    rdfs:label
        "número do processo do diploma"@pt ,
        "diploma process number"@en ;
    rdfs:comment
        "Número do processo administrativo associado ao registro ou expedição do diploma."@pt ,
