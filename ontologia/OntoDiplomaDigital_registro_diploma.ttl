    rdfs:domain odd:RegistroDiploma ;
    rdfs:range xsd:string ;
    dcterms:source odd:FonteXsdLeiauteDiplomaDigital , odd:FonteXsdTiposBasicos ;
    odd:xsdPath "TDadosRegistro/LivroRegistro/ProcessoDoDiploma" ;
    odd:xsdElement "ProcessoDoDiploma" ;
    odd:xsdType "TCodProcessoDoDiploma" ;
    odd:modelingRationale
        "Propriedade legada substituída por odd:hasAdministrativeProcess. O número passou a ser odd:identifier do recurso odd:ProcessoAdministrativo, fazendo com que dcterms:identifier descreva o sujeito correto."@pt .

odd:degreeConferralDate
    a owl:DatatypeProperty , owl:FunctionalProperty ;
