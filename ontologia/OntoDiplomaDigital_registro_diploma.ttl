    odd:xsdElement "DataHabilitacao" ;
    odd:xsdType "TData" ;
    odd:modelingRationale
        "dcterms:date foi adotada porque o valor representa uma data do ciclo de vida da habilitação que ocupa a posição de sujeito."@pt .

odd:emphasis
    a owl:DatatypeProperty ;
    rdfs:label
        "ênfase"@pt ,
        "emphasis"@en ;
    rdfs:comment
        "Ênfase textual do curso, quando declarada no leiaute do diploma."@pt ,
        "Textual emphasis of the academic program when declared in the diploma layout."@en ;
    rdfs:domain odd:Curso ;
    rdfs:range xsd:string ;
    dcterms:source odd:FonteXsdLeiauteDiplomaDigital , odd:FonteXsdTiposBasicos ;
    odd:xsdPath "TDadosCurso/Enfase" ;
    odd:xsdElement "Enfase" ;
    odd:xsdType "TString" .

odd:otherAwardedTitle
    a owl:DatatypeProperty ;
    rdfs:label
        "outro título conferido"@pt ,
        "other awarded title"@en ;
    rdfs:comment
        "Título textual conferido ao diplomado quando ele não estiver contemplado no conjunto controlado de títulos gerais."@pt ,
