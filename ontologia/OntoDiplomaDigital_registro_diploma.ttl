    odd:xsdType "TData" ;
    odd:modelingRationale
        "dcterms:date foi mantida por representar uma data do ciclo de vida do registro. dcterms:issued foi removida porque a entidade formalmente expedida é o diploma relacionado, não o registro que ocupa a posição de sujeito."@pt .

