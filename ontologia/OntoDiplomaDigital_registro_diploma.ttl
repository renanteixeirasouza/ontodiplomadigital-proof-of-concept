    odd:xsdType "TData" ;
    odd:modelingRationale
        "dcterms:date foi adotada porque o valor representa uma data do ciclo de vida das informações de tramitação e-MEC que ocupam a posição de sujeito."@pt .

odd:emecProtocolDate
    a owl:DatatypeProperty ;
    rdfs:label
        "data de protocolo e-MEC"@pt ,
        "e-MEC protocol date"@en ;
    rdfs:comment
        "Data de protocolo do processo e-MEC associada ao curso."@pt ,
        "Protocol date of the e-MEC process associated with the academic program."@en ;
    rdfs:domain odd:InformacoesTramitacaoEmec ;
    rdfs:range xsd:date ;
    rdfs:subPropertyOf dcterms:date ;
    dcterms:source odd:FonteXsdLeiauteDiplomaDigital , odd:FonteXsdTiposBasicos ;
    odd:xsdPath "TInformacoesTramitacaoEMEC/DataProtocolo" ;
    odd:xsdElement "DataProtocolo" ;
    odd:xsdType "TData" ;
    odd:modelingRationale
        "dcterms:date foi adotada porque o valor representa uma data do ciclo de vida das informações de tramitação e-MEC que ocupam a posição de sujeito."@pt .

odd:streetAddress
    a owl:DatatypeProperty ;
    rdfs:label
        "logradouro"@pt ,
        "street address"@en ;
    rdfs:comment
        "Logradouro do endereço postal."@pt ,
        "Street address of the postal address."@en ;
    rdfs:domain odd:Endereco ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf locn:thoroughfare , vcard:street-address ;
    dcterms:source odd:FonteXsdLeiauteDiplomaDigital , odd:FonteXsdTiposBasicos ;
    odd:xsdPath "TEndereco/Logradouro" ;
    odd:xsdElement "Logradouro" ;
    odd:xsdType "TString" .

odd:addressNumber
    a owl:DatatypeProperty ;
    rdfs:label
        "número do endereço"@pt ,
        "address number"@en ;
    rdfs:comment
        "Número associado ao logradouro do endereço postal."@pt ,
        "Number associated with the street of the postal address."@en ;
    rdfs:domain odd:Endereco ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf locn:locatorDesignator ;
    dcterms:source odd:FonteXsdLeiauteDiplomaDigital ;
    odd:xsdPath "TEndereco/Numero" ;
    odd:xsdElement "Numero" ;
    odd:xsdType "TString" ;
    odd:modelingRationale
        "locn:locatorDesignator foi adotada porque o valor representa o designador textual ou numerico que localiza o endereco dentro do logradouro, preservando a granularidade do numero predial definida no XSD."@pt .

odd:addressComplement
    a owl:DatatypeProperty ;
    rdfs:label
        "complemento do endereço"@pt ,
        "address complement"@en ;
    rdfs:comment
        "Complemento opcional do endereço postal."@pt ,
        "Optional complement of the postal address."@en ;
    rdfs:domain odd:Endereco ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf schema:extendedAddress ;
    dcterms:source odd:FonteXsdLeiauteDiplomaDigital ;
    odd:xsdPath "TEndereco/Complemento" ;
    odd:xsdElement "Complemento" ;
    odd:xsdType "TString" ;
    odd:modelingRationale
        "schema:extendedAddress foi adotada após a normalização do CSV/ABox, pois o campo passou a registrar complemento postal estruturado extraído do próprio logradouro, como bloco do endereço."@pt .

odd:district
    a owl:DatatypeProperty ;
    rdfs:label
        "bairro"@pt ,
        "district"@en ;
    rdfs:comment
        "Bairro do endereço postal."@pt ,
        "District or neighborhood of the postal address."@en ;
    rdfs:domain odd:Endereco ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf locn:addressArea ;
    dcterms:source odd:FonteXsdLeiauteDiplomaDigital ;
    odd:xsdPath "TEndereco/Bairro" ;
    odd:xsdElement "Bairro" ;
    odd:xsdType "TString" ;
    odd:modelingRationale
        "locn:addressArea foi adotada porque o bairro representa uma area de endereco submunicipal, sem ser tratado como unidade administrativa territorial."@pt .

odd:municipality
    a owl:DatatypeProperty ;
    rdfs:label
        "município"@pt ,
        "municipality"@en ;
    rdfs:comment
        "Nome do município associado ao endereço."@pt ,
        "Name of the municipality associated with the address."@en ;
    rdfs:domain odd:Endereco ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf locn:postName , vcard:locality ;
    dcterms:source odd:FonteXsdLeiauteDiplomaDigital , odd:FonteXsdTiposBasicos ;
    odd:xsdPath "TEndereco/GMunicipio/NomeMunicipio" ;
    odd:xsdElement "NomeMunicipio" , "NomeMunicipioEstrangeiro" ;
    odd:xsdType "TNomeMun" .

odd:federativeUnit
    a owl:DatatypeProperty ;
    rdfs:label
        "UF"@pt ,
        "federative unit"@en ;
    rdfs:comment
        "Unidade federativa associada ao endereço brasileiro."@pt ,
        "Federative unit associated with a Brazilian address."@en ;
    rdfs:domain odd:Endereco ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf locn:adminUnitL2 , vcard:region ;
    dcterms:source odd:FonteXsdLeiauteDiplomaDigital , odd:FonteXsdTiposBasicos ;
    odd:xsdPath "TEndereco/GMunicipio/UF" ;
    odd:xsdElement "UF" ;
    odd:xsdType "TUf" ;
    odd:modelingRationale
        "locn:adminUnitL2 foi adotada porque a UF representa estado ou região administrativa secundária; locn:adminUnitL1 foi removida porque corresponde ao nível superior, quase sempre o país."@pt .

odd:postalCode
    a owl:DatatypeProperty ;
    rdfs:label
        "CEP"@pt ,
        "postal code"@en ;
    rdfs:comment
        "Código de endereçamento postal do endereço."@pt ,
        "Postal code of the address."@en ;
    rdfs:domain odd:Endereco ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf locn:postCode , vcard:postal-code ;
    dcterms:source odd:FonteXsdLeiauteDiplomaDigital ;
    odd:xsdPath "TEndereco/CEP" ;
    odd:xsdElement "CEP" ;
    odd:xsdType "xs:string" .

odd:countryName
    a owl:DatatypeProperty ;
    rdfs:label
        "país"@pt ,
        "country name"@en ;
    rdfs:comment
        "Nome do país associado ao endereço quando a estrutura documental trouxer essa informação."@pt ,
        "Country name associated with the address when this information is present in the documentary structure."@en ;
    rdfs:domain odd:Endereco ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf vcard:country-name ;
    dcterms:source odd:FonteXsdLeiauteHistoricoEscolar , odd:FonteXsdTiposBasicos ;
    odd:xsdElement "Pais" ;
    odd:xsdType "TString" ;
    odd:modelingRationale
        "Foi criada para acomodar o pais em variacoes documentais e alinhamentos de endereco, mesmo sem declaracao direta desse campo no TEndereco do leiaute principal."@pt .

#################################################################
# Restrictions
#################################################################

# Restrições OWL expressam regras formais sobre as classes.
# Elas indicam, por exemplo, cardinalidades mínimas, máximas ou exatas para certas propriedades.
# Explicação didática: são regras do modelo, como dizer que um diploma deve ter uma IES emissora
# ou que um curso deve ter um grau conferido.

# owl:Restriction cria uma regra aplicada à classe declarada em rdfs:subClassOf.
# owl:onProperty informa qual propriedade está sendo regulada pela restrição.
# Explicação didática: primeiro se escolhe o campo/relação, depois se define a regra.
#
# owl:minQualifiedCardinality significa "pelo menos esta quantidade".
# owl:qualifiedCardinality significa "exatamente esta quantidade".
# owl:maxQualifiedCardinality significa "no máximo esta quantidade".
# Explicação didática: essas cardinalidades dizem se uma informação é obrigatória,
# única, opcional ou limitada.
#
# owl:onClass é usado quando o valor esperado é outro recurso/classe.
# owl:onDataRange é usado quando o valor esperado é literal, como texto ou data.
# Explicação didática: onClass aponta para outra coisa do modelo; onDataRange aponta
# para um tipo de dado simples.

# As restrições nomeadas abaixo substituem blank nodes nas classes principais e
# são definidas nesta seção dedicada ao final do TTL.
# Cada classe mantém apenas a referência em `rdfs:subClassOf` ao final do seu bloco,
# o que preserva a leitura limpa e a legibilidade no editor.

odd:RestricaoDiplomaTemTitularMinimo1
    a owl:Restriction ;
    rdfs:label
        "Restrição: diploma tem ao menos 1 titular"@pt ,
        "Restriction: diploma has at least 1 holder"@en ;
    owl:onProperty odd:hasHolder ;
    owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
    owl:onClass odd:Diplomado .

odd:RestricaoDiplomaEmitidoPorExatamente1
    a owl:Restriction ;
    rdfs:label
        "Restrição: diploma é emitido por exatamente 1 IES emissora"@pt ,
        "Restriction: diploma is issued by exactly 1 issuing HEI"@en ;
    owl:onProperty odd:issuedBy ;
    owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
    owl:onClass odd:IesEmissora .

odd:RestricaoDiplomaRegistradoPorExatamente1
    a owl:Restriction ;
    rdfs:label
        "Restrição: diploma é registrado por exatamente 1 IES registradora"@pt ,
        "Restriction: diploma is registered by exactly 1 registering HEI"@en ;
    owl:onProperty odd:registeredBy ;
    owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
    owl:onClass odd:IesRegistradora .

odd:RestricaoDiplomaTemCursoMinimo1
    a owl:Restriction ;
    rdfs:label
        "Restrição: diploma tem ao menos 1 curso"@pt ,
        "Restriction: diploma has at least 1 program"@en ;
    owl:onProperty odd:hasProgram ;
    owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
    owl:onClass odd:Curso .

odd:RestricaoDiplomaTemRegistroMaximo1
    a owl:Restriction ;
    rdfs:label
        "Restrição: diploma tem no máximo 1 registro"@pt ,
        "Restriction: diploma has at most 1 registration"@en ;
    owl:onProperty odd:hasRegistration ;
    owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
    owl:onClass odd:RegistroDiploma .

odd:RestricaoDiplomaTemAssinaturaMinimo1
    a owl:Restriction ;
    rdfs:label
        "Restrição: diploma tem ao menos 1 assinatura digital"@pt ,
        "Restriction: diploma has at least 1 digital signature"@en ;
    owl:onProperty odd:hasSignature ;
    owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
    owl:onClass odd:AssinaturaDigital .

odd:RestricaoDiplomaTemCodigoValidacaoMaximo1
    a owl:Restriction ;
    rdfs:label
        "Restrição: diploma tem no máximo 1 código de validação"@pt ,
        "Restriction: diploma has at most 1 validation code"@en ;
    owl:onProperty odd:hasValidationCode ;
    owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
    owl:onClass odd:CodigoValidacao .

odd:RestricaoDiplomaTemSituacaoMaximo1
    a owl:Restriction ;
    rdfs:label
        "Restrição: diploma tem no máximo 1 situação"@pt ,
        "Restriction: diploma has at most 1 status"@en ;
    owl:onProperty odd:hasStatus ;
    owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
    owl:onClass odd:ConceitoSituacaoDiploma .

odd:RestricaoCursoConfereGrauExatamente1
    a owl:Restriction ;
    rdfs:label
        "Restrição: curso confere exatamente 1 grau"@pt ,
        "Restriction: program awards exactly 1 degree"@en ;
    owl:onProperty odd:awardsDegree ;
    owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
    owl:onClass odd:ConceitoGrauConferido .

odd:RestricaoCursoConfereTituloMaximo1
    a owl:Restriction ;
    rdfs:label
        "Restrição: curso confere no máximo 1 título"@pt ,
        "Restriction: program awards at most 1 title"@en ;
    owl:onProperty odd:awardsTitle ;
    owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
    owl:onClass odd:ConceitoTituloConferido .

odd:RestricaoCursoTemModalidadeOfertaExatamente1
    a owl:Restriction ;
    rdfs:label
        "Restrição: curso tem exatamente 1 modalidade de oferta"@pt ,
        "Restriction: program has exactly 1 mode of delivery"@en ;
    owl:onProperty odd:hasModeOfDelivery ;
    owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
    owl:onClass odd:ConceitoModalidadeOferta .

odd:RestricaoCursoTemTramitacaoEmecMaximo1
    a owl:Restriction ;
    rdfs:label
        "Restrição: curso tem no máximo 1 informação de tramitação e-MEC"@pt ,
        "Restriction: program has at most 1 e-MEC processing information record"@en ;
    owl:onProperty odd:hasEmecProcessingInfo ;
    owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
    owl:onClass odd:InformacoesTramitacaoEmec .

odd:RestricaoCursoTemCodigoEmecMaximo1
    a owl:Restriction ;
    rdfs:label
        "Restrição: curso tem no máximo 1 código e-MEC"@pt ,
        "Restriction: program has at most 1 e-MEC code"@en ;
    owl:onProperty odd:codeEmec ;
    owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
    owl:onDataRange xsd:string .

odd:RestricaoCursoTemOutroTituloConferidoMaximo1
    a owl:Restriction ;
    rdfs:label
        "Restrição: curso tem no máximo 1 outro título conferido"@pt ,
        "Restriction: program has at most 1 other awarded title"@en ;
    owl:onProperty odd:otherAwardedTitle ;
    owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
    owl:onDataRange xsd:string .

odd:RestricaoCursoTemEnderecoExatamente1
    a owl:Restriction ;
    rdfs:label
        "Restrição: curso tem exatamente 1 endereço"@pt ,
        "Restriction: program has exactly 1 address"@en ;
    owl:onProperty odd:hasAddress ;
    owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
    owl:onClass odd:Endereco .

odd:RestricaoCursoEnderecoIndisponivelVerdadeiro
    a owl:Restriction ;
    rdfs:label
        "Restrição: curso declara endereço indisponível"@pt ,
        "Restriction: program declares address unavailable"@en ;
    owl:onProperty odd:courseAddressUnavailable ;
    owl:hasValue "true"^^xsd:boolean .

odd:AlternativaEnderecoCursoJudicial
    a owl:Class ;
    rdfs:label
        "Alternativas de endereço do curso judicial"@pt ,
        "Court-decision program address alternatives"@en ;
    rdfs:comment
        "União OWL entre a presença de exatamente um endereço e a declaração verdadeira de indisponibilidade. A exclusividade é verificada por SHACL."@pt ,
        "OWL union between exactly one address and a true unavailability declaration. Exclusivity is checked by SHACL."@en ;
    skos:definition
        "Classe lógica auxiliar cujos membros satisfazem ao menos uma das condições de endereço admitidas para CursoPorDecisaoJudicial: possuir exatamente um endereço ou declarar verdadeira a indisponibilidade do endereço."@pt ,
        "Auxiliary logical class whose members satisfy at least one of the address conditions admitted for Course by Court Decision: having exactly one address or declaring the address unavailable."@en ;
    skos:scopeNote
        "Use somente como expressão lógica auxiliar na definição de CursoPorDecisaoJudicial. A exclusividade entre endereço informado e indisponibilidade declarada é validada por SHACL e não deve ser inferida da união OWL isoladamente."@pt ,
        "Use only as an auxiliary logical expression in the definition of Course by Court Decision. Exclusivity between a supplied address and declared unavailability is validated by SHACL and must not be inferred from the OWL union alone."@en ;
    odd:sourceNote
        "Não corresponde a um tipo nominal do XSD; formaliza o xs:choice obrigatório de TDadosCursoPorDecisaoJudicial entre EnderecoCurso e EnderecoCurso_Indisponivel."@pt ;
    odd:modelingRationale
        "A classe nomeada torna a união rastreável e reutilizável na especialização CursoPorDecisaoJudicial, enquanto a regra SHACL xone preserva a escolha exclusiva exigida operacionalmente."@pt ;
    skos:example
        "Um curso por decisão judicial com exatamente um endereço informado ou com declaração explícita de endereço indisponível."@pt ;
    owl:unionOf odd:ListaAlternativasEnderecoCursoJudicial1 .

odd:ListaAlternativasEnderecoCursoJudicial1
    a rdf:List ;
    rdf:first odd:RestricaoCursoTemEnderecoExatamente1 ;
    rdf:rest odd:ListaAlternativasEnderecoCursoJudicial2 .

odd:ListaAlternativasEnderecoCursoJudicial2
    a rdf:List ;
    rdf:first odd:RestricaoCursoEnderecoIndisponivelVerdadeiro ;
    rdf:rest rdf:nil .

odd:RestricaoDiplomaTemAmbienteExatamente1
    a owl:Restriction ;
    rdfs:label
        "Restrição: diploma tem exatamente 1 ambiente operacional"@pt ,
        "Restriction: diploma has exactly 1 operational environment"@en ;
    owl:onProperty odd:hasEnvironment ;
    owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
    owl:onClass odd:ConceitoAmbienteOperacional .

odd:RestricaoRegistroDiplomaDataRegistroExatamente1
    a owl:Restriction ;
    rdfs:label
        "Restrição: registro tem exatamente 1 data de registro"@pt ,
        "Restriction: registration has exactly 1 registration date"@en ;
    owl:onProperty odd:registrationDate ;
    owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
    owl:onDataRange xsd:date .

odd:RestricaoRegistroDiplomaSolicitacaoDocumentoExatamente1
    a owl:Restriction ;
    rdfs:label
        "Restrição: registro tem exatamente 1 requisição de documentação acadêmica"@pt ,
        "Restriction: registration has exactly 1 academic documentation request"@en ;
    owl:onProperty odd:hasAcademicDocumentationRequest ;
    owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
    owl:onClass odd:RequisicaoDocumentacaoAcademica .

odd:RestricaoRegistroDiplomaProcessoAdministrativoExatamente1
    a owl:Restriction ;
    rdfs:label
        "Restrição: registro tem exatamente 1 processo administrativo"@pt ,
        "Restriction: registration has exactly 1 administrative process"@en ;
    owl:onProperty odd:hasAdministrativeProcess ;
    owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
    owl:onClass odd:ProcessoAdministrativo .

odd:RestricaoRegistroDiplomaDataConcessaoExatamente1
    a owl:Restriction ;
    rdfs:label
        "Restrição: registro tem exatamente 1 data de concessão de grau"@pt ,
        "Restriction: registration has exactly 1 degree conferral date"@en ;
    owl:onProperty odd:degreeConferralDate ;
    owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
    owl:onDataRange xsd:date .

odd:RestricaoRegistroDiplomaDataExpedicaoExatamente1
    a owl:Restriction ;
    rdfs:label
        "Restrição: registro tem exatamente 1 data de expedição do diploma"@pt ,
        "Restriction: registration has exactly 1 diploma expedition date"@en ;
    owl:onProperty odd:diplomaExpeditionDate ;
    owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
    owl:onDataRange xsd:date .

odd:RestricaoRegistroDiplomaResponsavelExatamente1
    a owl:Restriction ;
    rdfs:label
        "Restrição: registro tem exatamente 1 responsável"@pt ,
        "Restriction: registration has exactly 1 responsible agent"@en ;
    owl:onProperty odd:hasRegistrationResponsible ;
    owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
    owl:onClass odd:ResponsavelRegistro .

odd:RestricaoAssinaturaDigitalCarimboMinimo1
    a owl:Restriction ;
    rdfs:label
        "Restrição: assinatura tem ao menos 1 carimbo de tempo"@pt ,
        "Restriction: signature has at least 1 timestamp"@en ;
    owl:onProperty odd:hasTimestamp ;
    owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
    owl:onClass odd:CarimboTempo .

odd:RestricaoAssinaturaDigitalFormatoMaximo1
    a owl:Restriction ;
    rdfs:label
        "Restrição: assinatura tem no máximo 1 formato"@pt ,
        "Restriction: signature has at most 1 signature format"@en ;
    owl:onProperty odd:hasSignatureFormat ;
    owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
    owl:onClass odd:ConceitoFormatoAssinatura .

odd:RestricaoAssinaturaDigitalPapelMaximo1
    a owl:Restriction ;
    rdfs:label
        "Restrição: assinatura tem no máximo 1 papel"@pt ,
        "Restriction: signature has at most 1 signature role"@en ;
    owl:onProperty odd:hasSignatureRole ;
    owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
    owl:onClass odd:ConceitoPapelAssinatura .

odd:RestricaoHabilitacaoNomeExatamente1
    a owl:Restriction ;
    rdfs:label
        "Restrição: habilitação tem exatamente 1 nome"@pt ,
        "Restriction: qualification track has exactly 1 name"@en ;
    owl:onProperty odd:qualificationName ;
    owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
    owl:onDataRange xsd:string .

odd:RestricaoHabilitacaoDataExatamente1
    a owl:Restriction ;
    rdfs:label
        "Restrição: habilitação tem exatamente 1 data"@pt ,
        "Restriction: qualification track has exactly 1 date"@en ;
    owl:onProperty odd:qualificationDate ;
    owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
    owl:onDataRange xsd:date .

#################################################################
# SKOS controlled vocabularies
#################################################################

# Vocabulários controlados SKOS organizam listas de conceitos padronizados.
# Aqui são usados para valores como modalidade de oferta, grau conferido, título conferido,
# situação do diploma e formato de assinatura.
# Explicação didática: são listas fechadas ou orientadas de opções, como escolher
# "Presencial", "EAD" ou "Semipresencial" para a modalidade do curso.

# skos:ConceptScheme representa o vocabulário controlado como um todo.
# skos:Concept representa cada termo ou opção dentro desse vocabulário.
# Explicação didática: o esquema é a lista organizada; os conceitos são os itens da lista.
#
# skos:prefLabel é o nome principal do conceito; skos:altLabel registra sinônimos
# ou formas alternativas; skos:hiddenLabel registra grafias incorretas úteis para busca.
# Explicação didática: prefLabel é o nome oficial, altLabel são apelidos aceitos,
# hiddenLabel ajuda a encontrar o conceito mesmo quando alguém digita errado.
#
# skos:member indica que um conceito faz parte de uma coleção editorial.
# Explicação didática: coloca itens dentro de uma pasta de navegação, sem criar hierarquia.
#
# skos:notation registra um código curto e controlado para o conceito.
# Explicação didática: é uma sigla estável, como MOD-EAD para Educação a Distância.
#
# skos:topConceptOf indica que o conceito está no nível principal do esquema.
# Explicação didática: marca os grandes grupos que aparecem no topo da lista.

vocab:EsquemaValoresControladosDiploma
    a skos:ConceptScheme ;
    skos:prefLabel
        "Vocabulário controlado do diploma digital"@pt ,
        "Digital diploma controlled vocabulary"@en ;
    skos:definition
        "Esquema SKOS que reúne os valores padronizados usados para descrever o diploma digital e seus principais componentes."@pt ,
        "SKOS scheme that gathers the standardized values used to describe the digital diploma and its main components."@en ;
    skos:scopeNote
        "Use este esquema quando precisar navegar, escolher ou reutilizar os valores padronizados do diploma digital, como grau, título, modalidade, situação, formato e papel de assinatura."@pt ,
        "Use this scheme when you need to browse, choose or reuse the standardized values of the digital diploma, such as degree type, title, delivery mode, status, format and signature role."@en ;
    skos:historyNote
        "Esquema consolidado na revisão 1.0.1 para separar explicitamente a camada terminológica SKOS do núcleo conceitual OWL da ontologia."@pt ,
        "Scheme consolidated in revision 1.0.1 to explicitly separate the SKOS terminological layer from the OWL conceptual core of the ontology."@en ;
    skos:editorialNote
        "Registrar observações internas para manutenção do vocabulário. Se surgir termo recorrente nas fontes, verificar primeiro se ele cabe aqui antes de criar literal solto ou nova categoria paralela."@pt ,
        "Record internal notes for vocabulary maintenance. If a recurring term appears in the sources, check first whether it belongs here before creating a loose literal or a parallel category."@en ;
    skos:hasTopConcept vocab:CategoriaGrauConferido ,
        vocab:CategoriaTituloConferido ,
        vocab:CategoriaModalidadeOferta ,
        vocab:CategoriaSituacaoDiploma ,
        vocab:CategoriaAmbienteOperacional ,
        vocab:CategoriaFormatoAssinatura ,
        vocab:CategoriaPapelAssinatura .

vocab:ColecaoGrausConferidos
    a skos:Collection ;
    skos:prefLabel
        "Graus conferidos"@pt ,
        "Awarded degree types"@en ;
    skos:definition
        "Coleção editorial dos conceitos SKOS usados como valores controlados para o grau conferido pelo curso."@pt ,
        "Editorial collection of SKOS concepts used as controlled values for the degree type awarded by the program."@en ;
    skos:scopeNote
        "Coleção criada para facilitar navegação e curadoria no VocBench. A estrutura hierárquica formal permanece expressa por skos:broader e skos:narrower."@pt ,
        "Collection created to facilitate navigation and curation in VocBench. The formal hierarchical structure remains expressed through skos:broader and skos:narrower."@en ;
    skos:member vocab:Bacharelado , vocab:Licenciatura , vocab:Tecnologia , vocab:CursoSequencial .

vocab:ColecaoTitulosConferidos
    a skos:Collection ;
    skos:prefLabel
        "Títulos conferidos"@pt ,
        "Awarded titles"@en ;
    skos:definition
        "Coleção editorial dos conceitos SKOS usados como valores controlados para o título conferido ao diplomado."@pt ,
        "Editorial collection of SKOS concepts used as controlled values for the title awarded to the graduate."@en ;
    skos:scopeNote
        "Use esta coleção apenas para navegação e revisão terminológica dos títulos gerais previstos no leiaute XSD."@pt ,
        "Use this collection only for navigation and terminological review of the general titles provided by the XSD layout."@en ;
    skos:member vocab:Bacharel , vocab:Licenciado , vocab:Tecnologo , vocab:Medico .

vocab:ColecaoModalidadesOferta
    a skos:Collection ;
    skos:prefLabel
        "Modalidades de oferta"@pt ,
        "Modes of delivery"@en ;
    skos:definition
        "Coleção editorial dos conceitos SKOS usados como valores controlados para a modalidade de oferta do curso."@pt ,
        "Editorial collection of SKOS concepts used as controlled values for the program mode of delivery."@en ;
    skos:scopeNote
        "Coleção de apoio à navegação no VocBench; não cria relação hierárquica entre as modalidades."@pt ,
        "Collection supporting navigation in VocBench; it does not create a hierarchical relation among the delivery modes."@en ;
    skos:member vocab:Presencial , vocab:Ead , vocab:Semipresencial .

vocab:ColecaoSituacoesDiploma
    a skos:Collection ;
    skos:prefLabel
        "Situações do diploma"@pt ,
        "Diploma statuses"@en ;
    skos:definition
        "Coleção editorial dos conceitos SKOS usados como valores controlados para a situação administrativa ou jurídica do diploma digital."@pt ,
        "Editorial collection of SKOS concepts used as controlled values for the administrative or legal status of the digital diploma."@en ;
    skos:scopeNote
        "Coleção útil para consulta e curadoria de estados do diploma, sem substituir a categoria SKOS correspondente."@pt ,
        "Collection useful for querying and curating diploma statuses, without replacing the corresponding SKOS category."@en ;
    skos:member vocab:Ativo , vocab:Anulado , vocab:Revogado .

vocab:ColecaoAmbientesOperacionais
    a skos:Collection ;
    skos:prefLabel
        "Ambientes operacionais"@pt ,
        "Operational environments"@en ;
    skos:definition
        "Coleção editorial dos conceitos SKOS usados como valores controlados do atributo ambiente do diploma digital."@pt ,
        "Editorial collection of SKOS concepts used as controlled values for the digital diploma environment attribute."@en ;
    skos:member vocab:Producao , vocab:Homologacao .

vocab:ColecaoFormatosAssinatura
    a skos:Collection ;
    skos:prefLabel
        "Formatos de assinatura"@pt ,
        "Signature formats"@en ;
    skos:definition
        "Coleção editorial dos conceitos SKOS usados como valores controlados para formatos técnicos de assinatura digital."@pt ,
        "Editorial collection of SKOS concepts used as controlled values for technical digital signature formats."@en ;
    skos:scopeNote
        "Coleção criada para navegação no VocBench; a validade técnica da assinatura continua dependente dos padrões e validações criptográficas aplicáveis."@pt ,
        "Collection created for navigation in VocBench; the technical validity of the signature still depends on applicable cryptographic standards and validations."@en ;
    skos:member vocab:XAdES , vocab:CAdES , vocab:PAdES .

vocab:ColecaoPapeisAssinatura
    a skos:Collection ;
    skos:prefLabel
        "Papéis da assinatura"@pt ,
        "Signature roles"@en ;
    skos:definition
        "Coleção editorial dos conceitos SKOS usados como valores controlados para o papel semântico-administrativo da assinatura digital."@pt ,
        "Editorial collection of SKOS concepts used as controlled values for the semantic-administrative role of the digital signature."@en ;
    skos:scopeNote
        "Coleção criada para navegação e curadoria no VocBench; ela não substitui a ligação formal da assinatura à categoria correspondente."@pt ,
        "Collection created for navigation and curation in VocBench; it does not replace the formal link between the signature and the corresponding category."@en ;
    skos:member
        vocab:AssinaturaPFEmissora ,
        vocab:AssinaturaPJEmissora ,
        vocab:AssinaturaPFResponsavelRegistro ,
        vocab:AssinaturaPJRegistradora ,
        vocab:AssinaturaPJArquivamentoDocumentacaoAcademica .

vocab:CategoriaGrauConferido
    a skos:Concept , odd:ConceitoGrauConferido ;
    skos:prefLabel
        "grau conferido"@pt ,
        "degree type"@en ;
    skos:altLabel
        "grau acadêmico"@pt ;
    skos:hiddenLabel
        "grau conferdo"@pt ;
    skos:definition
        "Categoria de conceitos que representa o tipo de grau acadêmico atribuído ao concluinte do curso."@pt ,
        "Category of concepts representing the type of academic degree awarded to the program completer."@en ;
    skos:scopeNote
        "Use para controlar tipos gerais de grau, como bacharelado, licenciatura, tecnologia e curso sequencial."@pt ,
        "Use to control general degree types such as bachelor, licentiate, technological degree and sequential program degree."@en ;
    skos:example
        "Bacharelado, Licenciatura, Tecnologia e Curso sequencial."@pt ,
        "Bachelor, Licentiate, Technological degree and Sequential program degree."@en ;
    # skos:inScheme indica que este conceito pertence a um esquema conceitual SKOS.
    # Neste caso, vocab:CategoriaGrauConferido faz parte do vocabulário controlado
    # vocab:EsquemaValoresControladosDiploma.
    # Explicação didática: informa em qual lista organizada este conceito está guardado.
    skos:inScheme vocab:EsquemaValoresControladosDiploma ;
    skos:topConceptOf vocab:EsquemaValoresControladosDiploma ;
    # skos:narrower indica conceitos mais específicos dentro de uma hierarquia SKOS.
    # Aqui, a categoria geral "grau conferido" possui como conceitos específicos
    # Bacharelado, Licenciatura, Tecnologia e CursoSequencial.
    # Explicação didática: a categoria "grau conferido" abre uma lista de opções mais específicas
    # que podem ser usadas para classificar o curso.
    skos:narrower vocab:Bacharelado , vocab:Licenciatura , vocab:Tecnologia , vocab:CursoSequencial .

vocab:CategoriaTituloConferido
    a skos:Concept , odd:ConceitoTituloConferido ;
    skos:prefLabel
        "título conferido"@pt ,
        "awarded title"@en ;
    skos:definition
        "Categoria de conceitos que representa a denominação nominal ou profissional atribuída ao egresso."@pt ,
        "Category of concepts representing the nominal or professional title assigned to the graduate."@en ;
    skos:scopeNote
        "Use para títulos gerais controlados previstos no XSD, como Bacharel, Licenciado, Tecnólogo e Médico. Títulos específicos de cursos devem ficar em extensões institucionais."@pt ,
        "Use for general controlled titles provided in the XSD, such as Bachelor, Licentiate, Technologist, and Physician. Course-specific titles should remain in institutional extensions."@en ;
    skos:editorialNote
        "Nota para continuidade: mantenha neste eixo apenas títulos gerais reutilizáveis. Se um curso ou programa exigir um título muito específico, trate isso como extensão institucional e não como novo valor do núcleo."@pt ,
        "Continuation note: keep only reusable general titles in this axis. If a course or program requires a very specific title, treat it as an institutional extension rather than a new core value."@en ;
    skos:inScheme vocab:EsquemaValoresControladosDiploma ;
    skos:topConceptOf vocab:EsquemaValoresControladosDiploma ;
    skos:narrower vocab:Bacharel , vocab:Licenciado , vocab:Tecnologo , vocab:Medico .

vocab:CategoriaModalidadeOferta
    a skos:Concept , odd:ConceitoModalidadeOferta ;
    skos:prefLabel
        "modalidade de oferta"@pt ,
        "mode of delivery"@en ;
    skos:altLabel
        "regime de oferta"@pt ;
    skos:definition
        "Categoria de conceitos que representa o modo institucional pelo qual o curso é ofertado."@pt ,
        "Category of concepts representing the institutional mode by which the academic program is offered."@en ;
    skos:scopeNote
        "Use para modalidades formalmente previstas nos dados do diploma digital, como presencial, educação a distância e semipresencial."@pt ,
        "Use for modes formally expected in digital diploma data, such as on-site, distance learning and blended delivery."@en ;
    skos:editorialNote
        "Nota para continuidade: trate as modalidades como irmãos do mesmo eixo e não como variantes hierárquicas entre si. Se surgir nova modalidade, inclua-a no mesmo nível e preserve a leitura simples do conjunto."@pt ,
        "Continuation note: treat delivery modes as siblings in the same axis, not as hierarchical variants of one another. If a new mode appears, add it at the same level and keep the set easy to read."@en ;
    skos:inScheme vocab:EsquemaValoresControladosDiploma ;
    skos:topConceptOf vocab:EsquemaValoresControladosDiploma ;
    skos:narrower vocab:Presencial , vocab:Ead , vocab:Semipresencial .

vocab:CategoriaSituacaoDiploma
    a skos:Concept , odd:ConceitoSituacaoDiploma ;
    skos:prefLabel
        "situação do diploma"@pt ,
        "diploma status"@en ;
    skos:altLabel
        "estado do diploma"@pt ;
    skos:definition
        "Categoria de conceitos que representa a situação administrativa ou jurídica do diploma digital."@pt ,
        "Category of concepts representing the administrative or legal status of the digital diploma."@en ;
    skos:scopeNote
        "Use para estados institucionais do diploma, especialmente quando a situação precisa ser controlada para consulta, auditoria ou interoperabilidade."@pt ,
        "Use for institutional states of the diploma, especially when status must be controlled for querying, auditing, or interoperability."@en ;
    skos:inScheme vocab:EsquemaValoresControladosDiploma ;
    skos:topConceptOf vocab:EsquemaValoresControladosDiploma ;
    skos:narrower vocab:Ativo , vocab:Anulado , vocab:Revogado .

vocab:CategoriaAmbienteOperacional
    a skos:Concept , odd:ConceitoAmbienteOperacional ;
    skos:prefLabel
        "ambiente operacional"@pt ,
        "operational environment"@en ;
    skos:definition
        "Categoria de conceitos que representa o ambiente operacional declarado no documento de diploma digital."@pt ,
        "Category of concepts representing the operational environment declared in the digital diploma document."@en ;
    skos:scopeNote
        "Use somente para os valores previstos pelo tipo TAmb do XSD; não confundir com tipo ou gênero documental."@pt ,
        "Use only for values defined by the XSD TAmb type; do not confuse with document type or genre."@en ;
    skos:inScheme vocab:EsquemaValoresControladosDiploma ;
    skos:topConceptOf vocab:EsquemaValoresControladosDiploma ;
    skos:narrower vocab:Producao , vocab:Homologacao .

vocab:CategoriaFormatoAssinatura
    a skos:Concept , odd:ConceitoFormatoAssinatura ;
    skos:prefLabel
        "formato de assinatura"@pt ,
        "signature format"@en ;
    skos:definition
        "Categoria de conceitos que representa o perfil técnico ou padrão usado para assinatura digital."@pt ,
        "Category of concepts representing the technical profile or standard used for the digital signature."@en ;
    skos:scopeNote
        "Use para formatos técnicos interoperáveis de assinatura digital."@pt ,
        "Use for interoperable technical digital signature formats."@en ;
    skos:inScheme vocab:EsquemaValoresControladosDiploma ;
    skos:topConceptOf vocab:EsquemaValoresControladosDiploma ;
    skos:narrower vocab:XAdES , vocab:CAdES , vocab:PAdES .

vocab:CategoriaPapelAssinatura
    a skos:Concept , odd:ConceitoPapelAssinatura ;
    skos:prefLabel
        "papel da assinatura"@pt ,
        "signature role"@en ;
    skos:definition
        "Categoria de conceitos que representa o papel semântico-administrativo atribuído a uma assinatura digital no processo do diploma."@pt ,
        "Category of concepts representing the semantic-administrative role assigned to a digital signature in the diploma process."@en ;
    skos:scopeNote
        "Use para distinguir a assinatura da pessoa física da emissora, a assinatura institucional da emissora, a assinatura da pessoa física responsável pelo registro, a assinatura institucional da registradora e a assinatura institucional de arquivamento documental."@pt ,
        "Use to distinguish the issuing party natural person signature, the issuing HEI institutional signature, the registration responsible natural person signature, the registering HEI institutional signature, and the institutional signature for archival of academic documentation."@en ;
    skos:inScheme vocab:EsquemaValoresControladosDiploma ;
    skos:topConceptOf vocab:EsquemaValoresControladosDiploma ;
    skos:narrower
        vocab:AssinaturaPFEmissora ,
        vocab:AssinaturaPJEmissora ,
        vocab:AssinaturaPFResponsavelRegistro ,
        vocab:AssinaturaPJRegistradora ,
        vocab:AssinaturaPJArquivamentoDocumentacaoAcademica .

vocab:Producao
    a skos:Concept , odd:ConceitoAmbienteOperacional ;
    skos:prefLabel
        "Produção"@pt ,
        "Production"@en ;
    skos:altLabel
        "Ambiente de produção"@pt ;
    skos:notation "AMB-PROD"^^xsd:string ;
    skos:definition
        "Ambiente operacional destinado à emissão e ao processamento oficial do diploma digital."@pt ,
        "Operational environment intended for official issuance and processing of the digital diploma."@en ;
    skos:inScheme vocab:EsquemaValoresControladosDiploma ;
    skos:broader vocab:CategoriaAmbienteOperacional .

vocab:Homologacao
    a skos:Concept , odd:ConceitoAmbienteOperacional ;
    skos:prefLabel
        "Homologação"@pt ,
        "Testing"@en ;
    skos:altLabel
        "Ambiente de homologação"@pt ;
    skos:notation "AMB-HOM"^^xsd:string ;
    skos:definition
        "Ambiente operacional destinado a testes, validações e homologação antes do processamento oficial."@pt ,
        "Operational environment intended for testing and validation before official processing."@en ;
    skos:inScheme vocab:EsquemaValoresControladosDiploma ;
    skos:broader vocab:CategoriaAmbienteOperacional .

vocab:Presencial
    a skos:Concept , odd:ConceitoModalidadeOferta ;
    skos:prefLabel
        "Presencial"@pt ,
        "On-site"@en ;
    skos:altLabel
        "Presencial físico"@pt ;
    skos:hiddenLabel
        "presensial"@pt ;
    skos:notation "MOD-PRES"^^xsd:string ;
    skos:definition
        "Modalidade em que as atividades formativas ocorrem predominantemente com presença física do estudante."@pt ,
        "Mode in which educational activities predominantly take place with the student's physical presence."@en ;
    skos:scopeNote
        "Use quando a oferta do curso exigir frequência presencial predominante, mesmo que existam componentes digitais de apoio."@pt ,
        "Use when the academic program requires predominantly in-person attendance, even if digital support components exist."@en ;
    skos:example
        "Curso de graduação ofertado em campus universitário com aulas regulares presenciais."@pt ,
        "Undergraduate program offered on a university campus with regular face-to-face classes."@en ;
    skos:historyNote
        "Conceito preservado da modelagem inicial e formalizado como valor controlado SKOS na revisão 1.0.1."@pt ;
    skos:inScheme vocab:EsquemaValoresControladosDiploma ;
    # skos:broader indica o conceito mais amplo ao qual este conceito pertence.
    # Aqui, Presencial é um tipo específico dentro da categoria geral ModalidadeOferta.
    # Explicação didática: quando alguém escolhe "Presencial" como modalidade de um curso,
    # esse valor está sendo entendido como parte do grupo maior "Modalidade de oferta".
    skos:broader vocab:CategoriaModalidadeOferta .
vocab:Ead
    a skos:Concept , odd:ConceitoModalidadeOferta ;
    skos:prefLabel
        "Educação a Distância"@pt ,
        "Distance Learning"@en ;
    skos:altLabel
        "EaD"@pt ;
    skos:altLabel
        "EAD"@pt ;
    skos:altLabel
        "Ensino a distância"@pt ;
    skos:notation "MOD-EAD"^^xsd:string ;
    skos:definition
        "Modalidade em que as atividades formativas ocorrem predominantemente com mediação tecnológica e interação remota."@pt ,
        "Mode in which educational activities predominantly occur through technological mediation and remote interaction."@en ;
    skos:scopeNote
        "Use quando a oferta do curso for caracterizada institucionalmente como educação a distância."@pt ,
        "Use when the academic program is institutionally characterized as distance learning."@en ;
    skos:example
        "Curso ofertado em plataforma virtual com avaliações, materiais e mediação pedagógica remota."@pt ,
        "Program delivered through a virtual platform with remote assessment, materials and pedagogical mediation."@en ;
    skos:changeNote
        "Rótulos alternativos foram ampliados para contemplar formas de busca frequentes na documentação administrativa."@pt ;
    skos:inScheme vocab:EsquemaValoresControladosDiploma ;
    skos:broader vocab:CategoriaModalidadeOferta .

vocab:Semipresencial
    a skos:Concept , odd:ConceitoModalidadeOferta ;
    skos:prefLabel
        "Semipresencial"@pt ,
        "Blended Delivery"@en ;
    skos:altLabel
        "modalidade híbrida"@pt ;
    skos:notation "MOD-SEMI"^^xsd:string ;
    skos:definition
        "Modalidade em que o curso combina atividades presenciais e atividades mediadas por tecnologia."@pt ,
        "Mode in which the academic program combines on-site activities and technology-mediated activities."@en ;
    skos:scopeNote
        "Use quando o curso estiver formalmente identificado como semipresencial no leiaute ou em documentação institucional compatível."@pt ,
        "Use when the academic program is formally identified as blended in the layout or in compatible institutional documentation."@en ;
    skos:inScheme vocab:EsquemaValoresControladosDiploma ;
    skos:broader vocab:CategoriaModalidadeOferta .

vocab:Bacharelado
    a skos:Concept , odd:ConceitoGrauConferido ;
    skos:prefLabel
        "Bacharelado"@pt ,
        "Bachelor"@en ;
    skos:altLabel
        "Grau de bacharel"@pt ;
    skos:notation "GRA-BACH"^^xsd:string ;
    skos:definition
        "Grau acadêmico atribuído a concluinte de curso superior de bacharelado."@pt ,
        "Academic degree awarded to a graduate of a bachelor's higher education program."@en ;
    skos:scopeNote
        "Use para identificar o tipo de grau, não o título profissional específico do egresso."@pt ,
        "Use to identify the degree type, not the graduate's specific professional title."@en ;
    skos:example
        "Bacharelado em Ciência da Informação."@pt ,
        "Bachelor in Information Science."@en ;
    skos:inScheme vocab:EsquemaValoresControladosDiploma ;
    skos:broader vocab:CategoriaGrauConferido .

vocab:Licenciatura
    a skos:Concept , odd:ConceitoGrauConferido ;
    skos:prefLabel
        "Licenciatura"@pt ,
        "Licentiate"@en ;
    skos:notation "GRA-LIC"^^xsd:string ;
    skos:definition
        "Grau acadêmico atribuído a concluinte de curso superior orientado à formação para docência."@pt ,
        "Academic degree awarded to a graduate of a higher education program oriented toward teacher education."@en ;
    skos:scopeNote
        "Use quando o curso conduzir à formação em licenciatura."@pt ,
        "Use when the program leads to a licentiate degree."@en ;
    skos:inScheme vocab:EsquemaValoresControladosDiploma ;
    skos:broader vocab:CategoriaGrauConferido .

vocab:Tecnologia
    a skos:Concept , odd:ConceitoGrauConferido ;
    skos:prefLabel
        "Tecnologia"@pt ,
        "Technological Degree"@en ;
    skos:notation "GRA-TEC"^^xsd:string ;
    skos:definition
        "Grau acadêmico atribuído a concluinte de curso superior de tecnologia."@pt ,
        "Academic degree awarded to a graduate of a higher technological education program."@en ;
    skos:scopeNote
        "Use quando o curso estiver formalmente classificado como curso superior de tecnologia."@pt ,
        "Use when the program is formally classified as a higher technological program."@en ;
    skos:inScheme vocab:EsquemaValoresControladosDiploma ;
    skos:broader vocab:CategoriaGrauConferido .

vocab:CursoSequencial
    a skos:Concept , odd:ConceitoGrauConferido ;
    skos:prefLabel
        "Curso sequencial"@pt ,
        "Sequential Program Degree"@en ;
    skos:notation "GRA-SEQ"^^xsd:string ;
    skos:definition
        "Grau acadêmico associado a curso sequencial, conforme previsão do leiaute do diploma."@pt ,
        "Academic degree associated with a sequential program, as provided in the diploma layout."@en ;
    skos:scopeNote
        "Use quando o grau conferido estiver formalmente classificado como curso sequencial."@pt ,
        "Use when the awarded degree is formally classified as a sequential program degree."@en ;
    skos:inScheme vocab:EsquemaValoresControladosDiploma ;
    skos:broader vocab:CategoriaGrauConferido .

vocab:Bacharel
    a skos:Concept , odd:ConceitoTituloConferido ;
    skos:prefLabel
        "Bacharel"@pt ,
        "Bachelor"@en ;
    skos:notation "TIT-BACH"^^xsd:string ;
    skos:definition
        "Título geral conferido ao diplomado quando o leiaute registrar a forma Bacharel."@pt ,
        "General title awarded to the graduate when the layout records the form Bachelor."@en ;
    skos:scopeNote
        "Use como título controlado geral, distinto do grau Bacharelado."@pt ,
        "Use as a general controlled title, distinct from the Bachelor degree type."@en ;
    skos:inScheme vocab:EsquemaValoresControladosDiploma ;
    skos:broader vocab:CategoriaTituloConferido .

vocab:Licenciado
    a skos:Concept , odd:ConceitoTituloConferido ;
    skos:prefLabel
        "Licenciado"@pt ,
        "Licentiate"@en ;
    skos:notation "TIT-LIC"^^xsd:string ;
    skos:definition
        "Título geral conferido ao diplomado quando o leiaute registrar a forma Licenciado."@pt ,
        "General title awarded to the graduate when the layout records the form Licentiate."@en ;
    skos:scopeNote
        "Use como título controlado geral previsto no XSD."@pt ,
        "Use as a general controlled title provided in the XSD."@en ;
    skos:inScheme vocab:EsquemaValoresControladosDiploma ;
    skos:broader vocab:CategoriaTituloConferido .

vocab:Tecnologo
    a skos:Concept , odd:ConceitoTituloConferido ;
    skos:prefLabel
        "Tecnólogo"@pt ,
        "Technologist"@en ;
    skos:altLabel
        "Tecnologo"@pt ;
    skos:notation "TIT-TEC"^^xsd:string ;
    skos:definition
        "Título geral conferido ao diplomado quando o leiaute registrar a forma Tecnólogo."@pt ,
        "General title awarded to the graduate when the layout records the form Technologist."@en ;
    skos:scopeNote
        "Use como título controlado geral previsto no XSD, sem representar especialidade de curso."@pt ,
        "Use as a general controlled title provided in the XSD, without representing a course specialization."@en ;
    skos:inScheme vocab:EsquemaValoresControladosDiploma ;
    skos:broader vocab:CategoriaTituloConferido .

vocab:Medico
    a skos:Concept , odd:ConceitoTituloConferido ;
    skos:prefLabel
        "Médico"@pt ,
        "Physician"@en ;
    skos:altLabel
        "Medico"@pt ;
    skos:notation "TIT-MED"^^xsd:string ;
    skos:definition
        "Título geral conferido ao diplomado quando o leiaute registrar a forma Médico."@pt ,
        "General title awarded to the graduate when the layout records the form Physician."@en ;
    skos:scopeNote
        "Use como título controlado geral previsto no XSD."@pt ,
        "Use as a general controlled title provided in the XSD."@en ;
    skos:inScheme vocab:EsquemaValoresControladosDiploma ;
    skos:broader vocab:CategoriaTituloConferido .

vocab:Ativo
    a skos:Concept , odd:ConceitoSituacaoDiploma ;
    skos:prefLabel
        "Ativo"@pt ,
        "Active"@en ;
    skos:notation "SIT-ATV"^^xsd:string ;
    skos:definition
        "Situação em que o diploma digital permanece válido e sem restrição administrativa registrada."@pt ,
        "Status in which the digital diploma remains valid and without registered administrative restriction."@en ;
    skos:scopeNote
        "Use para diplomas emitidos e registrados cuja validade não tenha sido suspensa, anulada ou revogada."@pt ,
        "Use for diplomas issued and registered whose validity has not been suspended, annulled or revoked."@en ;
    skos:inScheme vocab:EsquemaValoresControladosDiploma ;
    skos:broader vocab:CategoriaSituacaoDiploma .

vocab:Anulado
    a skos:Concept , odd:ConceitoSituacaoDiploma ;
    skos:prefLabel
        "Anulado"@pt ,
        "Annulled"@en ;
    skos:notation "SIT-ANL"^^xsd:string ;
    skos:definition
        "Situação em que o diploma digital teve sua validade anulada por decisão administrativa ou jurídica."@pt ,
        "Status in which the digital diploma had its validity annulled by administrative or legal decision."@en ;
    skos:scopeNote
        "Use quando houver ato formal de anulação do diploma."@pt ,
        "Use when there is a formal act annulling the diploma."@en ;
    skos:inScheme vocab:EsquemaValoresControladosDiploma ;
    skos:broader vocab:CategoriaSituacaoDiploma ;
    skos:related vocab:Revogado .

vocab:Revogado
    a skos:Concept , odd:ConceitoSituacaoDiploma ;
    skos:prefLabel
        "Revogado"@pt ,
        "Revoked"@en ;
    skos:notation "SIT-REV"^^xsd:string ;
    skos:definition
        "Situação em que o diploma digital teve seus efeitos revogados posteriormente à emissão."@pt ,
        "Status in which the digital diploma had its effects revoked after issuance."@en ;
    skos:scopeNote
        "Use quando o diploma permanecer historicamente registrável, mas sem efeitos vigentes por ato de revogação."@pt ,
        "Use when the diploma remains historically recordable but no longer produces effects due to a revocation act."@en ;
    skos:inScheme vocab:EsquemaValoresControladosDiploma ;
    skos:broader vocab:CategoriaSituacaoDiploma ;
    skos:related vocab:Anulado .

vocab:XAdES
    a skos:Concept , odd:ConceitoFormatoAssinatura ;
    skos:prefLabel
        "XAdES"@pt ,
        "XAdES"@en ;
    skos:notation "SIG-XADES"^^xsd:string ;
    skos:definition
        "Perfil de assinatura eletrônica avançada baseado em XML."@pt ,
        "Advanced electronic signature profile based on XML."@en ;
    skos:scopeNote
        "Use quando a assinatura digital do diploma for codificada segundo o padrão XAdES."@pt ,
        "Use when the diploma digital signature is encoded according to the XAdES standard."@en ;
    skos:inScheme vocab:EsquemaValoresControladosDiploma ;
    skos:broader vocab:CategoriaFormatoAssinatura ;
    skos:related vocab:CAdES , vocab:PAdES .

vocab:CAdES
    a skos:Concept , odd:ConceitoFormatoAssinatura ;
    skos:prefLabel
        "CAdES"@pt ,
        "CAdES"@en ;
    skos:notation "SIG-CADES"^^xsd:string ;
    skos:definition
        "Perfil de assinatura eletrônica avançada baseado em CMS."@pt ,
        "Advanced electronic signature profile based on CMS."@en ;
    skos:scopeNote
        "Use quando a assinatura digital do diploma for codificada segundo o padrão CAdES."@pt ,
        "Use when the diploma digital signature is encoded according to the CAdES standard."@en ;
    skos:inScheme vocab:EsquemaValoresControladosDiploma ;
    skos:broader vocab:CategoriaFormatoAssinatura ;
    skos:related vocab:XAdES , vocab:PAdES .

vocab:PAdES
    a skos:Concept , odd:ConceitoFormatoAssinatura ;
    skos:prefLabel
        "PAdES"@pt ,
        "PAdES"@en ;
    skos:notation "SIG-PADES"^^xsd:string ;
    skos:definition
        "Perfil de assinatura eletrônica avançada aplicado a documentos PDF."@pt ,
        "Advanced electronic signature profile applied to PDF documents."@en ;
    skos:scopeNote
        "Use quando a assinatura digital do diploma for expressa em documentos PDF assinados segundo PAdES."@pt ,
        "Use when the diploma digital signature is expressed in PDF documents signed according to PAdES."@en ;
    skos:inScheme vocab:EsquemaValoresControladosDiploma ;
    skos:broader vocab:CategoriaFormatoAssinatura ;
    skos:related vocab:XAdES , vocab:CAdES .

vocab:AssinaturaPFEmissora
    a skos:Concept , odd:ConceitoPapelAssinatura ;
    skos:prefLabel
        "assinatura PF da emissora"@pt ,
        "issuing party natural person signature"@en ;
    skos:altLabel
        "assinatura de pessoa física da emissora"@pt ;
    skos:notation "PAP-ASS-PF-EMI"^^xsd:string ;
    skos:definition
        "Papel de assinatura atribuído à assinatura digital realizada por pessoa física que atua em nome da IES emissora."@pt ,
        "Signature role assigned to a digital signature performed by a natural person acting on behalf of the issuing HEI."@en ;
    skos:scopeNote
        "Use quando a assinatura representar o ato pessoal do signatário da emissão, e não o reconhecimento institucional da pessoa jurídica."@pt ,
        "Use when the signature represents the personal act of the issuance signer rather than the institutional recognition of the legal entity."@en ;
    skos:inScheme vocab:EsquemaValoresControladosDiploma ;
    skos:broader vocab:CategoriaPapelAssinatura ;
    skos:related vocab:AssinaturaPJEmissora .

vocab:AssinaturaPJEmissora
    a skos:Concept , odd:ConceitoPapelAssinatura ;
    skos:prefLabel
        "assinatura PJ da emissora"@pt ,
        "issuing HEI institutional signature"@en ;
    skos:altLabel
        "assinatura institucional da emissora"@pt ;
    skos:notation "PAP-ASS-PJ-EMI"^^xsd:string ;
    skos:definition
        "Papel de assinatura atribuído à assinatura digital que expressa o reconhecimento institucional da IES emissora como pessoa jurídica."@pt ,
        "Signature role assigned to a digital signature that expresses the institutional recognition of the issuing HEI as a legal entity."@en ;
    skos:scopeNote
        "Use quando a assinatura representar a chancela institucional da emissora, distinta da assinatura pessoal do agente emissor."@pt ,
        "Use when the signature represents the issuing institution's formal institutional endorsement, distinct from the signer personal act."@en ;
    skos:inScheme vocab:EsquemaValoresControladosDiploma ;
    skos:broader vocab:CategoriaPapelAssinatura ;
    skos:related vocab:AssinaturaPFEmissora .

vocab:AssinaturaPFResponsavelRegistro
    a skos:Concept , odd:ConceitoPapelAssinatura ;
    skos:prefLabel
        "assinatura PF do responsável pelo registro"@pt ,
        "registration responsible natural person signature"@en ;
    skos:altLabel
        "assinatura de pessoa física responsável pelo registro"@pt ;
    skos:notation "PAP-ASS-PF-RESPREG"^^xsd:string ;
    skos:definition
        "Papel de assinatura atribuído à assinatura digital realizada pela pessoa física explicitamente responsável pelo ato de registro do diploma."@pt ,
        "Signature role assigned to a digital signature performed by the natural person explicitly responsible for the act of diploma registration."@en ;
    skos:scopeNote
        "Use quando a assinatura corresponder ao responsável pelo registro identificado administrativamente no processo."@pt ,
        "Use when the signature corresponds to the registration responsible person administratively identified in the process."@en ;
    skos:inScheme vocab:EsquemaValoresControladosDiploma ;
    skos:broader vocab:CategoriaPapelAssinatura ;
    skos:related vocab:AssinaturaPJRegistradora .

vocab:AssinaturaPJRegistradora
    a skos:Concept , odd:ConceitoPapelAssinatura ;
    skos:prefLabel
        "assinatura PJ da registradora"@pt ,
        "registering HEI institutional signature"@en ;
    skos:altLabel
        "assinatura institucional da registradora"@pt ;
    skos:notation "PAP-ASS-PJ-REG"^^xsd:string ;
    skos:definition
        "Papel de assinatura atribuído à assinatura digital que expressa o reconhecimento institucional da IES registradora como pessoa jurídica."@pt ,
        "Signature role assigned to a digital signature that expresses the institutional recognition of the registering HEI as a legal entity."@en ;
    skos:scopeNote
        "Use quando a assinatura representar a formalização institucional do registro pela IES registradora."@pt ,
        "Use when the signature represents the institutional formalization of the registration by the registering HEI."@en ;
    skos:inScheme vocab:EsquemaValoresControladosDiploma ;
    skos:broader vocab:CategoriaPapelAssinatura ;
    skos:related vocab:AssinaturaPFResponsavelRegistro .

vocab:AssinaturaPJArquivamentoDocumentacaoAcademica
    a skos:Concept , odd:ConceitoPapelAssinatura ;
    skos:prefLabel
        "assinatura PJ de arquivamento da documentação acadêmica"@pt ,
        "academic documentation archival institutional signature"@en ;
    skos:altLabel
        "assinatura institucional de arquivamento documental"@pt ;
    skos:notation "PAP-ASS-PJ-ARQDOC"^^xsd:string ;
    skos:definition
        "Papel de assinatura atribuído à assinatura digital que expressa a responsabilidade institucional pelo arquivamento da documentação acadêmica."@pt ,
        "Signature role assigned to a digital signature that expresses institutional responsibility for archiving academic documentation."@en ;
    skos:scopeNote
        "Use quando a assinatura tiver função principal de reconhecer institucionalmente o arquivamento ou a custódia da documentação acadêmica."@pt ,
        "Use when the signature has the main function of institutionally recognizing the archival or custody of academic documentation."@en ;
    skos:inScheme vocab:EsquemaValoresControladosDiploma ;
    skos:broader vocab:CategoriaPapelAssinatura .
