@prefix odd: <https://w3id.org/ufes/ontodiplomadigital#> .
@prefix vocab: <https://w3id.org/ufes/ontodiplomadigital#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix schema: <https://schema.org/> .
# vann é usado para declarar metadados do namespace da ontologia, como o prefixo preferencial
# e a URI base recomendada para reutilização por pessoas e sistemas.
# Explicação didática: informa qual apelido curto a ontologia prefere usar para seus termos.
@prefix vann: <http://purl.org/vocab/vann/> .
@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix locn: <http://www.w3.org/ns/locn#> .
@prefix vcard: <http://www.w3.org/2006/vcard/ns#> .
@prefix dbo: <http://dbpedia.org/ontology/> .

<https://w3id.org/ufes/ontodiplomadigital>
    # Em Turtle, o termo "a" é uma forma abreviada de rdf:type.
    # Explicação didática: diz qual é o tipo daquele recurso.
    # Aqui, a URI principal é declarada como uma ontologia OWL.
    a owl:Ontology ;
    # rdfs:label e rdfs:comment ajudam humanos e ferramentas a lerem o recurso.
    # Explicação didática: label é o nome visível; comment é uma explicação curta.
    # Política textual: rótulos, comentários e descrições em português usam @pt;
    # o complemento internacional usa @en.
    dcterms:title
        "OntoDiplomaDigital"@pt ,
        "OntoDiplomaDigital"@en ;
    dcterms:description
        "Modelo organizado do diploma digital brasileiro, pensado para reunir em um só lugar os principais elementos do domínio, apoiar consulta e manutenção, e facilitar a continuidade do trabalho para quem precisa entender, reutilizar ou aprofundar o conteúdo depois."@pt ,
        "Organized model of the Brazilian digital diploma, designed to bring together the main elements of the domain in one place, support consultation and maintenance, and make it easier for later contributors to understand, reuse or deepen the content."@en ;
    dcterms:creator "Renan Teixeira de Souza" ;
    dcterms:created "2026-04-20"^^xsd:date ;
    dcterms:modified "2026-08-22"^^xsd:date ;
    dcterms:language "pt" ,
        "en" ;
    dcterms:subject
        "Diploma Digital"@pt ,
        "Digital Diploma"@en ;
    dcterms:type
        "Ontologia operacional de domínio"@pt ,
        "Operational domain ontology"@en ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    # Licença humana: Creative Commons Attribution 4.0 International (CC BY 4.0).
    # Human-readable license note: Creative Commons Attribution 4.0 International (CC BY 4.0).
    # A fonte web externa do MEC está representada por odd:FontePortalMecDiplomaDigitalDados.
    # Vide esse recurso na seção "Documentary sources" para consultar o link oficial em dcterms:identifier:
    # https://www.gov.br/mec/pt-br/diploma-digital/dados
    # Explicação didática: este item aponta para a página oficial do MEC onde os arquivos técnicos
    # do Diploma Digital podem ser consultados.
    dcterms:source odd:FontePortalMecDiplomaDigitalDados ,
        odd:FonteXsdNormalizado ,
        odd:FonteXsdXmlDsigCore ,
        # FonteXsdXmlDsigCore representa o XSD de assinatura digital XML.
        # Sua função é justificar a modelagem de AssinaturaDigital e das relações técnicas
        # associadas a ds:Signature, autenticidade e integridade do diploma digital.
        # Explicação didática: esta fonte explica a parte técnica que permite confiar
        # que o diploma digital foi assinado e não foi alterado.
        odd:FonteXsdTiposBasicos ,
        odd:FonteXsdLeiauteDiplomaDigital ,
        odd:FonteXsdLeiauteHistoricoEscolar ,
        odd:FonteXsdLeiauteCurriculoEscolar ,
        odd:FonteXsdLeiauteDocumentacaoAcademicaRegistro ,
        odd:FonteXsdLeiauteArquivoFiscalizacao ,
        odd:FonteXsdLeiauteListaDiplomasAnulados ,
        odd:FonteXsdDiplomaDigital ,
        odd:FonteXsdHistoricoEscolarDigital ,
        odd:FonteXsdCurriculoEscolarDigital ,
        odd:FonteXsdDocumentacaoAcademicaRegistro ,
        odd:FonteXsdArquivoFiscalizacao ,
        odd:FonteXsdListaDiplomasAnulados ;
    dcterms:conformsTo odd:FonteXsdXmlDsigCore ,
    # dcterms:conformsTo indica que a ontologia foi modelada em conformidade ou aderência metodológica
    # às estruturas, restrições e especificações técnicas dos XSDs listados, diferindo de dcterms:source,
    # que registra a origem documental consultada.
    # Explicação didática: não apenas consultei esses XSDs; modelei a ontologia respeitando
    # a forma como eles organizam os dados do Diploma Digital.
        odd:FonteXsdTiposBasicos ,
        odd:FonteXsdLeiauteDiplomaDigital ,
        odd:FonteXsdLeiauteHistoricoEscolar ,
        odd:FonteXsdLeiauteCurriculoEscolar ,
        odd:FonteXsdLeiauteDocumentacaoAcademicaRegistro ,
        odd:FonteXsdLeiauteArquivoFiscalizacao ,
        odd:FonteXsdLeiauteListaDiplomasAnulados ,
        odd:FonteXsdDiplomaDigital ,
        odd:FonteXsdHistoricoEscolarDigital ,
        odd:FonteXsdCurriculoEscolarDigital ,
        odd:FonteXsdDocumentacaoAcademicaRegistro ,
        odd:FonteXsdArquivoFiscalizacao ,
        odd:FonteXsdListaDiplomasAnulados ;
    dcterms:bibliographicCitation
        "Gruber, T. R. (1993). A translation approach to portable ontology specifications."@en ,
        "Borst, W. N. (1997). Construction of Engineering Ontologies for Knowledge Sharing and Reuse."@en ,
        "Studer, R.; Benjamins, V. R.; Fensel, D. (1998). Knowledge engineering: principles and methods."@en ;
    odd:methodologicalFoundation
        "A ontologia é concebida como especificação formal e explícita de uma conceitualização compartilhada, conforme a tradição conceitual de Gruber (1993), Borst (1997) e Studer, Benjamins e Fensel (1998)."@pt ;
    odd:modelingRationale
        "No cabeçalho, dcterms:source registra as fontes documentais consultadas e dcterms:conformsTo registra os XSDs adotados como referência de conformidade. Os mesmos recursos podem aparecer nos dois predicados porque cumprem funções diferentes."@pt ,
        "In the header, dcterms:source records the consulted documentary sources and dcterms:conformsTo records the XSDs adopted as conformance references. The same resources may appear in both predicates because they serve different functions."@en ;
    vann:preferredNamespacePrefix "odd" ;
    # O prefixo "odd" abrevia OntoDiplomaDigital e identifica o namespace local da ontologia,
    # facilitando a leitura dos recursos próprios do modelo sem repetir a URI completa.
    # Explicação didática: em vez de escrever o endereço completo da ontologia a cada termo,
    # usa-se "odd" como apelido curto.
    vann:preferredNamespaceUri "https://w3id.org/ufes/ontodiplomadigital#" ;
    owl:versionIRI <https://w3id.org/ufes/ontodiplomadigital/1.17> ;
    owl:versionInfo "1.17.0-registro-diploma" ;
    rdfs:label
        "OntoDiplomaDigital"@pt ,
        "OntoDiplomaDigital"@en ;
    rdfs:comment
        "Versão orientada ao aprofundamento do registro do diploma, com acréscimo de classes e propriedades derivadas de TDadosRegistro, TLivroRegistro, TSeguranca e TInfoAssinantes no XSD do Leiaute Diploma Digital v1.05."@pt ,
        "Version focused on deepening diploma registration modeling, adding classes and properties derived from TDadosRegistro, TLivroRegistro, TSeguranca and TInfoAssinantes in the Digital Diploma Layout XSD v1.05."@en .

#################################################################
# Annotation properties
#################################################################

# Propriedades de anotação servem para documentar a ontologia.
# Elas explicam origem, decisões de modelagem e rastreabilidade, mas não criam relações
# operacionais entre instâncias como as propriedades de objeto ou de dados.
#
# Explicação didática: são notas explicativas dentro do TTL, úteis para entender o porquê
# de uma decisão, mas não representam dados reais de um diploma.

# rdfs:subPropertyOf declara que uma propriedade é mais específica do que outra.
# Explicação didática: a propriedade "nota de fonte" fica dentro do grupo maior
# "anotação de rastreabilidade da fonte", como uma especialização.

odd:methodologicalAnnotation
    a owl:AnnotationProperty ;
    rdfs:label
        "anotação metodológica"@pt ,
        "methodological annotation"@en ;
    rdfs:comment
        "Propriedade de anotação agregadora usada para organizar notas metodológicas, rastreabilidade documental, decisões de modelagem e vínculos de competência."@pt ,
        "Grouping annotation property used to organize methodological notes, documentary traceability, modeling decisions and competency links."@en .

odd:sourceTraceAnnotation
    a owl:AnnotationProperty ;
    rdfs:subPropertyOf odd:methodologicalAnnotation ;
    rdfs:label
        "anotação de rastreabilidade da fonte"@pt ,
        "source trace annotation"@en ;
    rdfs:comment
        "Agrupa anotações voltadas à origem documental, ao elemento XSD, ao tipo XSD ou ao caminho técnico de uma decisão de modelagem."@pt ,
        "Groups annotations about documentary origin, XSD element, XSD type or technical path of a modeling decision."@en .

odd:controlledVocabularyAnnotation
    a owl:AnnotationProperty ;
    rdfs:subPropertyOf odd:methodologicalAnnotation ;
    rdfs:label
        "anotação de vocabulário controlado"@pt ,
        "controlled vocabulary annotation"@en ;
    rdfs:comment
        "Agrupa anotações que identificam o esquema SKOS e a categoria conceitual que controlam os valores aceitos por uma propriedade."@pt ,
        "Groups annotations identifying the SKOS scheme and conceptual category controlling the values accepted by a property."@en .

odd:competencyAnnotation
    a owl:AnnotationProperty ;
    rdfs:subPropertyOf odd:methodologicalAnnotation ;
    rdfs:label
        "anotação de competência"@pt ,
        "competency annotation"@en ;
    rdfs:comment
        "Agrupa anotações que registram as perguntas de verificação do trabalho e os objetivos usados para checar se o modelo cobre o que precisa responder."@pt ,
        "Groups annotations that record the project's verification questions and the objectives used to check whether the model covers what it needs to answer."@en .

odd:sourceNote
    a owl:AnnotationProperty ;
    rdfs:subPropertyOf odd:sourceTraceAnnotation ;
    rdfs:label
        "nota de fonte"@pt ,
        "source note"@en ;
    rdfs:comment
        "Registra observações metodológicas ou documentais sobre a origem de um termo, classe ou propriedade."@pt ,
        "Records methodological or documentary observations about the origin of a term, class or property."@en .

odd:xsdElement
    a owl:AnnotationProperty ;
    rdfs:subPropertyOf odd:sourceTraceAnnotation ;
    rdfs:label
        "elemento XSD"@pt ,
        "XSD element"@en ;
    rdfs:comment
        "Registra o nome do elemento XSD que fundamenta ou inspira a propriedade, classe ou decisão de modelagem."@pt ,
        "Records the XSD element name that grounds or inspires the property, class or modeling decision."@en .

odd:xsdType
    a owl:AnnotationProperty ;
    rdfs:subPropertyOf odd:sourceTraceAnnotation ;
    rdfs:label
        "tipo XSD"@pt ,
        "XSD type"@en ;
    rdfs:comment
        "Registra o tipo XSD associado à propriedade, classe ou decisão de modelagem."@pt ,
        "Records the XSD type associated with the property, class or modeling decision."@en .

odd:xsdPath
    a owl:AnnotationProperty ;
    rdfs:subPropertyOf odd:sourceTraceAnnotation ;
    rdfs:label
        "caminho XSD"@pt ,
        "XSD path"@en ;
    rdfs:comment
        "Registra um caminho técnico aproximado no leiaute XSD, quando necessário para rastreabilidade documental."@pt ,
        "Records an approximate technical path in the XSD layout when needed for documentary traceability."@en .

odd:controlledByScheme
    a owl:AnnotationProperty ;
    rdfs:subPropertyOf odd:controlledVocabularyAnnotation ;
    rdfs:label
        "controlado por esquema conceitual"@pt ,
        "controlled by concept scheme"@en ;
    rdfs:comment
        "Indica o esquema SKOS que controla os conceitos aceitos como objeto de uma propriedade."@pt ,
        "Indicates the SKOS scheme that controls the concepts accepted as the object of a property."@en .

odd:controlledConceptCategory
    a owl:AnnotationProperty ;
    rdfs:subPropertyOf odd:controlledVocabularyAnnotation ;
    rdfs:label
        "categoria de conceito controlado"@pt ,
        "controlled concept category"@en ;
    rdfs:comment
        "Indica a categoria SKOS específica usada para organizar os conceitos aceitos por uma propriedade."@pt ,
        "Indicates the specific SKOS category used to organize the concepts accepted by a property."@en .

odd:competencyQuestion
    a owl:AnnotationProperty ;
    rdfs:subPropertyOf odd:competencyAnnotation ;
    rdfs:label
        "questão de competência"@pt ,
        "competency question"@en ;
    rdfs:comment
        "Associa classes ou propriedades às questões de competência da ontologia."@pt ,
        "Associates classes or properties with the ontology competency questions."@en .

odd:modelingRationale
    a owl:AnnotationProperty ;
    rdfs:subPropertyOf odd:methodologicalAnnotation ;
    rdfs:label
        "racional de modelagem"@pt ,
        "modeling rationale"@en ;
    rdfs:comment
        "Registra a justificativa de modelagem usada para fins metodológicos e acadêmicos."@pt ,
        "Records the modeling rationale used for methodological and academic purposes."@en .

odd:methodologicalFoundation
    a owl:AnnotationProperty ;
    rdfs:subPropertyOf odd:methodologicalAnnotation ;
    rdfs:label
        "fundamentação metodológica"@pt ,
        "methodological foundation"@en ;
    rdfs:comment
        "Registra a base teórico-metodológica usada para caracterizar a ontologia como artefato de representação do conhecimento."@pt ,
        "Records the theoretical and methodological basis used to characterize the ontology as a knowledge representation artifact."@en .

#################################################################
# Documentary sources
#################################################################

# Fontes documentais registram os documentos técnicos usados como base.
# Nesta ontologia, indicam principalmente os XSDs oficiais e a página institucional do MEC
# consultados para justificar classes, propriedades e restrições.
# Explicação didática: esta seção mostra de onde vieram as informações usadas para construir
# a ontologia.

# dcterms:identifier, dcterms:description e dcterms:format descrevem a fonte documental.
# Explicação didática: identifier informa o nome ou link da fonte; description explica
# o que ela é; format indica o tipo do documento, como HTML ou XSD.

odd:FontePortalMecDiplomaDigitalDados
    a foaf:Document ;
    rdfs:label
        "Página oficial do MEC sobre o Pacote XSD v1.05 do Diploma Digital"@pt ,
        "Official MEC page about the Digital Diploma XSD Package v1.05"@en ;
    dcterms:identifier "https://www.gov.br/mec/pt-br/diploma-digital/dados"^^xsd:anyURI ;
    dcterms:description
        "Página institucional do Ministério da Educação usada como fonte web de proveniência e acesso aos arquivos XSD do Pacote XSD v1.05 do Diploma Digital. Não é modelada como padrão de conformidade; a conformidade técnica permanece atribuída aos XSDs individualmente declarados."@pt ,
        "Institutional page of the Brazilian Ministry of Education used as a web provenance and access source for the Digital Diploma XSD Package v1.05 files. It is not modeled as a conformance standard; technical conformance remains assigned to the individually declared XSDs."@en ;
    dcterms:publisher
        "Ministério da Educação"@pt ,
        "Brazilian Ministry of Education"@en ;
    dcterms:format "text/html" ;
    odd:modelingRationale
        "O recurso foi incluído apenas como fonte de proveniência e acesso ao pacote XSD. A conformidade da ontologia permanece vinculada aos XSDs técnicos, e não à página HTML do MEC."@pt .

odd:FonteXsdNormalizado
    a dcterms:Location ;
    rdfs:label
        "Diretório XSD normalizado do Diploma Digital"@pt ,
        "Normalized XSD directory for the Digital Diploma"@en ;
    dcterms:identifier "xsd_normalizado_diploma_digital" ;
    dcterms:description
        "Diretório local que reúne os XSDs normalizados usados como base de consulta, conferência e leitura dos schemas do Diploma Digital."@pt ,
        "Local directory containing the normalized XSDs used as a consultation, verification and reading base for the Digital Diploma schemas."@en ;
    dcterms:format "folder" ;
    odd:modelingRationale
        "O diretório é registrado como fonte local de consulta para preservar a rastreabilidade entre a leitura didática e os arquivos XSD normalizados usados no trabalho."@pt .

odd:FonteXsdXmlDsigCore
    a dcterms:Standard ;
    rdfs:label
        "XML Digital Signature Core Schema v1.1"@pt ;
    dcterms:identifier "xmldsigcore-schema_v1.1" ;
    dcterms:description
        "XSD de referência para a assinatura digital XML, usado para justificar a presença de ds:Signature nos leiautes e a modelagem das classes e propriedades relacionadas à assinatura digital."@pt ,
        "Reference XSD for XML digital signatures, used to justify the presence of ds:Signature in the layouts and the modeling of classes and properties related to digital signatures."@en ;
    dcterms:format "XSD" .

odd:FonteXsdTiposBasicos
    a dcterms:Standard ;
    rdfs:label
        "Tipos básicos do Diploma Digital do MEC"@pt ;
    dcterms:identifier "Tipos_Basicos_v1.05" ;
    dcterms:description
        "XSD transversal que define tipos reutilizáveis, padrões lexicais, identificadores, códigos institucionais, datas, dados pessoais, dados de IES e valores controlados como modalidade, grau conferido, título conferido e dados de registro."@pt ,
        "Cross-cutting XSD that defines reusable types, lexical patterns, identifiers, institutional codes, dates, personal data, HEI data and controlled values such as mode of delivery, awarded degree type, awarded title and registration data."@en ;
    dcterms:format "XSD" .

odd:FonteXsdLeiauteDiplomaDigital
    a dcterms:Standard ;
    rdfs:label
        "Leiaute Diploma Digital v1.05"@pt ;
    dcterms:identifier "Leiaute Diploma Digital v1.05" ;
    dcterms:description
        "XSD de leiaute que orienta a estrutura interna do Diploma Digital, servindo como base para a representação de diploma, diplomado, curso, IES emissora, registro, segurança, assinatura e elementos de identificação do documento."@pt ,
        "Layout XSD that guides the internal structure of the Digital Diploma, serving as the basis for representing the diploma, graduate, program, issuing HEI, registration, security, signature and document identification elements."@en ;
    dcterms:format "XSD" .

odd:FonteXsdLeiauteHistoricoEscolar
    a dcterms:Standard ;
    rdfs:label
        "Leiaute Histórico Escolar v1.05"@pt ;
    dcterms:identifier "Leiaute Histórico Escolar v1.05" ;
    dcterms:description
        "XSD de leiaute que estrutura o Histórico Escolar Digital, incluindo dados do estudante, curso, IES emissora, trajetória acadêmica, componentes curriculares, carga horária, registros acadêmicos e informações de segurança."@pt ,
        "Layout XSD that structures the Digital Academic Transcript, including student data, program data, issuing HEI, academic trajectory, curricular components, workload, academic records and security information."@en ;
    dcterms:format "XSD" .

odd:FonteXsdLeiauteCurriculoEscolar
    a dcterms:Standard ;
    rdfs:label
        "Leiaute Currículo Escolar v1.05"@pt ;
    dcterms:identifier "Leiaute Currículo Escolar v1.05" ;
    dcterms:description
        "XSD de leiaute que descreve o Currículo Escolar Digital e o Projeto Pedagógico de Curso, abrangendo dados mínimos do curso, IES emissora, unidades curriculares, áreas, etiquetas, atividades complementares, critérios de integralização e segurança."@pt ,
        "Layout XSD that describes the Digital Curriculum Record and the program pedagogical project, covering minimum program data, issuing HEI, curricular units, areas, labels, complementary activities, completion criteria and security."@en ;
    dcterms:format "XSD" .

odd:FonteXsdLeiauteDocumentacaoAcademicaRegistro
    a dcterms:Standard ;
    rdfs:label
        "Leiaute Documentação Acadêmica Registro Diploma Digital v1.05"@pt ;
    dcterms:identifier "Leiaute Documentação Academica Registro Diploma Digital v1.05" ;
    dcterms:description
        "XSD de leiaute que define a documentação acadêmica usada na emissão e no registro do Diploma Digital, incluindo requisições de registro, dados do diploma, dados privados do diplomado, documentação comprobatória, termo de responsabilidade e variações como segunda via e decisão judicial."@pt ,
        "Layout XSD that defines the academic documentation used for issuing and registering the Digital Diploma, including registration requests, diploma data, graduate private data, supporting documentation, responsibility statement and variants such as duplicate issuance and court decision."@en ;
    dcterms:format "XSD" .

odd:FonteXsdLeiauteArquivoFiscalizacao
    a dcterms:Standard ;
    rdfs:label
        "Leiaute Arquivo Fiscalização v1.05"@pt ;
    dcterms:identifier "Leiaute Arquivo Fiscalização v1.05" ;
    dcterms:description
        "XSD de leiaute que estrutura o arquivo de fiscalização enviado ao MEC, com dados de diplomas emitidos e registrados, IES emissora, curso, registro, URLs de documentos digitais e elementos de controle para acompanhamento institucional."@pt ,
        "Layout XSD that structures the inspection file submitted to MEC, with data on issued and registered diplomas, issuing HEI, program, registration, digital document URLs and control elements for institutional monitoring."@en ;
    dcterms:format "XSD" .

odd:FonteXsdLeiauteListaDiplomasAnulados
    a dcterms:Standard ;
    rdfs:label
        "Leiaute Lista de Diplomas Anulados v1.05"@pt ;
    dcterms:identifier "Leiaute Lista de Diplomas Anulados v1.05" ;
    dcterms:description
        "XSD de leiaute que estrutura a lista de diplomas com registro anulado, apoiando a representação de situação administrativa do diploma e de eventos de invalidação ou restrição vinculados ao registro."@pt ,
        "Layout XSD that structures the list of diplomas with annulled registration, supporting the representation of diploma administrative status and invalidation or restriction events linked to registration."@en ;
    dcterms:format "XSD" .

odd:FonteXsdDiplomaDigital
    a dcterms:Standard ;
    rdfs:label
        "Diploma Digital v1.05"@pt ;
    dcterms:identifier "Diploma Digital_v1.05" ;
    dcterms:description
        "XSD de documento que declara o elemento raiz Diploma e referencia o leiaute correspondente, funcionando como ponto de entrada documental para o recurso Diploma Digital na ontologia."@pt ,
        "Document XSD that declares the Diploma root element and references the corresponding layout, acting as the documentary entry point for the Digital Diploma resource in the ontology."@en ;
    dcterms:format "XSD" .

odd:FonteXsdHistoricoEscolarDigital
    a dcterms:Standard ;
    rdfs:label
        "Histórico Escolar Digital v1.05"@pt ;
    dcterms:identifier "Histórico Escolar Digital_v1.05" ;
    dcterms:description
        "XSD de documento que declara os elementos raiz do Histórico Escolar Digital, incluindo versões parcial, final e segunda via, e referencia o leiaute usado para representar a documentação acadêmica de suporte ao diploma."@pt ,
        "Document XSD that declares the root elements of the Digital Academic Transcript, including partial, final and duplicate versions, and references the layout used to represent academic documentation supporting the diploma."@en ;
    dcterms:format "XSD" .

odd:FonteXsdCurriculoEscolarDigital
    a dcterms:Standard ;
    rdfs:label
        "Currículo Escolar Digital v1.05"@pt ;
    dcterms:identifier "Currículo Escolar Digital v1.05" ;
    dcterms:description
        "XSD de documento que declara o elemento raiz CurriculoEscolar e referencia seu leiaute, apoiando a compreensão da estrutura curricular e dos critérios de integralização relacionados ao curso."@pt ,
        "Document XSD that declares the CurriculoEscolar root element and references its layout, supporting the understanding of the curricular structure and completion criteria related to the program."@en ;
    dcterms:format "XSD" .

odd:FonteXsdDocumentacaoAcademicaRegistro
    a dcterms:Standard ;
    rdfs:label
        "Documentação Acadêmica Registro Diploma Digital v1.05"@pt ;
    dcterms:identifier "Documentação Academica Registro Diploma Digital_v1.05" ;
    dcterms:description
        "XSD de documento que declara o elemento raiz DocumentacaoAcademicaRegistro e referencia o leiaute de documentação acadêmica para emissão e registro, servindo como fonte para relações entre diploma, registro, documentação comprobatória e dados privados do diplomado."@pt ,
        "Document XSD that declares the DocumentacaoAcademicaRegistro root element and references the academic documentation layout for issuance and registration, serving as a source for relations among diploma, registration, supporting documentation and graduate private data."@en ;
    dcterms:format "XSD" .

odd:FonteXsdArquivoFiscalizacao
    a dcterms:Standard ;
    rdfs:label
        "Arquivo Fiscalização v1.05"@pt ;
    dcterms:identifier "Arquivo Fiscalização v1.05" ;
    dcterms:description
        "XSD de documento que declara o elemento raiz ArquivoFiscalizacao e referencia o leiaute usado para fiscalização de diplomas emitidos e registrados, apoiando a rastreabilidade administrativa do domínio."@pt ,
        "Document XSD that declares the ArquivoFiscalizacao root element and references the layout used for inspecting issued and registered diplomas, supporting administrative traceability in the domain."@en ;
    dcterms:format "XSD" .

odd:FonteXsdListaDiplomasAnulados
    a dcterms:Standard ;
    rdfs:label
        "Lista de Diplomas Anulados v1.05"@pt ;
    dcterms:identifier "Lista de Diplomas Anulados v1.05" ;
    dcterms:description
        "XSD de documento que declara o elemento raiz ListaDiplomasAnulados e referencia o leiaute de diplomas com registro anulado, apoiando a modelagem de situações administrativas como anulação e restrições de validade."@pt ,
        "Document XSD that declares the ListaDiplomasAnulados root element and references the layout for diplomas with annulled registration, supporting the modeling of administrative situations such as annulment and validity restrictions."@en ;
    dcterms:format "XSD" .

#################################################################
# Competency questions
#################################################################

# Questões de competência são perguntas que a ontologia deve ajudar a responder.
# Elas delimitam o escopo da modelagem e conectam o TTL aos objetivos da pesquisa.
# Explicação didática: são perguntas de teste para verificar se a ontologia realmente
# representa o que a pesquisa precisa explicar ou consultar.

odd:ObjetivoEspecifico
    a owl:Class ;
    rdfs:label
        "Objetivo específico"@pt ,
        "Specific Objective"@en ;
    rdfs:comment
        "Meta prática do trabalho ligada à construção, revisão, validação ou uso da ontologia."@pt ,
        "Practical project goal related to the construction, review, validation or use of the ontology."@en ;
    skos:definition
        "Objetivo do trabalho usado para orientar a construção da ontologia e mostrar o que ela precisa cumprir no domínio."@pt ,
        "Project objective used to guide ontology construction and show what it needs to accomplish in the domain."@en ;
    skos:scopeNote
        "Use esta classe para registrar metas do trabalho e nao para entidades do dominio do diploma digital nem para tarefas operacionais de um caso concreto."@pt ,
        "Use this class to record project goals and not digital diploma domain entities or operational tasks of a concrete case."@en ;
    odd:sourceNote
        "Classe metodologica interna do projeto, derivada do quadro de objetivos especificos usado na dissertacao para orientar a modelagem e a avaliacao da ontologia."@pt ;
    odd:modelingRationale
        "Foi modelada como classe para registrar, no proprio TTL, a ligacao entre objetivos da pesquisa e decisoes de modelagem."@pt ;
    skos:example
        "Implementar a ontologia e realizar prova de conceito em ambiente de consulta semantica."@pt .

odd:OE1
    a odd:ObjetivoEspecifico ;
    rdfs:label "Análise normativa e técnica do MEC"@pt ;
    rdfs:label "MEC normative and technical analysis"@en ;
    skos:definition
        "Analisar os padrões normativos e técnicos estabelecidos pelo Ministério da Educação (MEC) para a implementação do diploma digital no Brasil, com foco nos elementos que compõem o subdomínio do Registro do Diploma."@pt ,
        "Analyze the normative and technical standards established by the Brazilian Ministry of Education (MEC) for implementing the digital diploma in Brazil, focusing on the elements that compose the Diploma Registration subdomain."@en .

odd:OE2
    a odd:ObjetivoEspecifico ;
    rdfs:label "Identificação de ontologias e vocabulários relevantes"@pt ;
    rdfs:label "Identification of relevant ontologies and vocabularies"@en ;
    skos:definition
        "Identificar ontologias, vocabulários controlados e esquemas de metadados relevantes ao contexto da representação interoperável dos dados de certificação acadêmica do diploma digital brasileiro."@pt ,
        "Identify ontologies, controlled vocabularies, and metadata schemes relevant to the interoperable representation of academic certification data in the Brazilian digital diploma context."@en .

odd:OE3
    a odd:ObjetivoEspecifico ;
    rdfs:label "Construção do modelo conceitual"@pt ;
    rdfs:label "Conceptual model construction"@en ;
    skos:definition
        "Construir um modelo conceitual do subdomínio do Registro do Diploma, representando as entidades, relações e restrições essenciais à certificação acadêmica digital."@pt ,
        "Build a conceptual model of the Diploma Registration subdomain, representing the entities, relationships, and constraints essential to digital academic certification."@en .

odd:OE4
    a odd:ObjetivoEspecifico ;
    rdfs:label "Mapeamento conceitual e relacional"@pt ;
    rdfs:label "Conceptual and relational mapping"@en ;
    skos:definition
        "Mapear os elementos conceituais e relacionais necessários à modelagem de uma ontologia operacional de domínio centrada nos dados públicos de certificação do diploma digital."@pt ,
        "Map the conceptual and relational elements required to model an operational domain ontology centered on public digital diploma certification data."@en .

odd:OE5
    a odd:ObjetivoEspecifico ;
    rdfs:label "Implementação da ontologia"@pt ;
    rdfs:label "Ontology implementation"@en ;
    skos:definition
        "Implementar uma ontologia operacional baseada em padrões da Web Semântica compatíveis com os princípios da interoperabilidade semântica e dos dados abertos ligados."@pt ,
        "Implement an operational ontology based on Semantic Web standards compatible with the principles of semantic interoperability and Linked Open Data."@en .

odd:OE6
    a odd:ObjetivoEspecifico ;
    rdfs:label "Prova de conceito"@pt ;
    rdfs:label "Proof of concept"@en ;
    skos:definition
        "Realizar uma prova de conceito para verificar a viabilidade de representação, transformação e recuperação semântica de dados sintéticos do Registro do Diploma e demonstrar, no conjunto de teste, uma integração federada baseada em identificador compartilhado."@pt ,
        "Conduct a proof of concept to verify the feasibility of representing, transforming, and semantically retrieving synthetic Diploma Registration data and demonstrate, in the test dataset, a federated integration based on a shared identifier."@en .

odd:QuestaoCompetencia
    a owl:Class ;
    rdfs:label
        "Questão de competência"@pt ,
        "Competency Question"@en ;
    rdfs:comment
        "Pergunta de controle que ajuda a verificar se o modelo cobre o que o projeto precisa responder, consultar ou explicar."@pt ,
        "Control question that helps verify whether the model covers what the project needs to answer, consult or explain."@en ;
    skos:definition
        "Pergunta de referência usada para checar a cobertura semântica do TTL e orientar a representação em RDF e a documentação do XML."@pt ,
        "Reference question used to check TTL semantic coverage and guide RDF representation and XML documentation."@en ;
    skos:scopeNote
        "Use esta classe para registrar perguntas que orientam a modelagem, a validacao e a cobertura do TTL/RDF. No XML, elas aparecem como apoio metodologico e documental, e nao como elemento estrutural do dominio."@pt ,
        "Use this class to record questions that guide modeling, validation and TTL/RDF coverage. In XML, they appear as methodological and documentary support, not as structural domain elements."@en ;
    odd:sourceNote
        "Classe metodologica interna do projeto, derivada do quadro de questoes de competencia associado aos objetivos especificos da dissertacao."@pt ;
    odd:modelingRationale
        "Foi modelada como classe para registrar, no proprio TTL, as perguntas usadas para verificar a cobertura semantica da ontologia."@pt ;
    skos:example
        "Quais elementos representados permitem recuperar o registro, a assinatura digital, o carimbo do tempo e o codigo de validacao de determinado diploma?"@pt .

odd:QC1
    a odd:QuestaoCompetencia ;
    rdfs:label "IES emissora e registradora do diploma"@pt ;
    rdfs:label "Issuing and registering HEIs of the diploma"@en ;
    skos:definition
        "Quais são a IES emissora e a IES registradora de determinado diploma digital?"@pt ,
        "Which are the issuing HEI and the registering HEI of a given digital diploma?"@en ;
    odd:hasRelatedObjective odd:OE1 , odd:OE3 , odd:OE6 .

odd:QC2
    a odd:QuestaoCompetencia ;
    rdfs:label "Elementos de registro, assinatura e validação do diploma"@pt ;
    rdfs:label "Diploma registration, signature, and validation elements"@en ;
    skos:definition
        "Quais elementos representados permitem recuperar o registro, a assinatura digital, o carimbo do tempo e o código de validação de determinado diploma?"@pt ,
        "Which represented elements allow retrieval of the registration, digital signature, timestamp, and validation code of a given diploma?"@en ;
    odd:hasRelatedObjective odd:OE1 , odd:OE4 , odd:OE6 .

odd:QC3
    a odd:QuestaoCompetencia ;
    rdfs:label "Diplomas por IES, período e modalidade"@pt ;
    rdfs:label "Diplomas by HEI, period, and modality"@en ;
    skos:definition
        "Quais diplomas foram emitidos por determinada IES, em período definido, segundo a modalidade de oferta do curso?"@pt ,
        "Which diplomas were issued by a given HEI, in a defined period, according to the course delivery mode?"@en ;
    odd:hasRelatedObjective odd:OE5 , odd:OE6 .

odd:QC4
    a odd:QuestaoCompetencia ;
    rdfs:label "Titular, curso, grau e título do diploma"@pt ;
    rdfs:label "Diploma holder, course, degree, and title"@en ;
    skos:definition
        "Quem é o titular de determinado diploma, qual curso concluiu e quais grau e título foram conferidos?"@pt ,
        "Who is the holder of a given diploma, which course was completed, and which degree and title were awarded?"@en ;
    odd:hasRelatedObjective odd:OE3 , odd:OE5 , odd:OE6 .

odd:QC5
    a odd:QuestaoCompetencia ;
    rdfs:label "Valores controlados de grau, título, modalidade, situação e assinatura"@pt ;
    rdfs:label "Controlled values for degree, title, modality, status, and signature"@en ;
    skos:definition
        "Quais valores controlados qualificam grau, título, modalidade, situação do diploma e formato ou papel da assinatura?"@pt ,
        "Which controlled values qualify degree, title, delivery mode, diploma status, and signature format or role?"@en ;
    odd:hasRelatedObjective odd:OE2 , odd:OE4 , odd:OE5 , odd:OE6 .

odd:QC6
    a odd:QuestaoCompetencia ;
    rdfs:label "Proveniência do registro do diploma"@pt ;
    rdfs:label "Provenance of diploma registration"@en ;
    skos:definition
        "Qual é a proveniência do registro, incluindo IES registradora, agentes, data e processo administrativo?"@pt ,
        "What is the provenance of the registration, including the registering HEI, agents, date, and administrative process?"@en ;
    odd:hasRelatedObjective odd:OE4 , odd:OE5 , odd:OE6 .

odd:QC7
    a odd:QuestaoCompetencia ;
    rdfs:label "Plataforma governamental de acesso no conjunto sintético"@pt ;
    rdfs:label "Government access platform in the synthetic dataset"@en ;
    skos:definition
        "Por meio de qual plataforma governamental o diploma de determinado cidadão, identificado por CPF, é representado como acessível no conjunto sintético?"@pt ,
        "Through which government platform is the diploma of a given citizen, identified by CPF, represented as accessible in the synthetic dataset?"@en ;
    odd:hasRelatedObjective odd:OE5 , odd:OE6 .

#################################################################
# Classes
#################################################################

# Classes representam os tipos principais de coisas do domínio.
# Exemplos: DiplomaDigital, Diplomado, Curso, RegistroDiploma, InstituicaoEnsinoSuperior
# e Endereco.
# Explicação didática: classes funcionam como categorias; por exemplo, "Curso" é uma categoria
# para agrupar cursos concretos que possam aparecer nos dados.

# rdfs:subClassOf declara que uma classe é um tipo mais específico de outra classe.
# Explicação didática: quando IesEmissora é subclasse de InstituicaoEnsinoSuperior,
# toda IES emissora é entendida como uma instituição de ensino superior.

odd:DiplomaDigital
    a owl:Class ;
    rdfs:label
        "Diploma Digital"@pt ,
        "Digital Diploma"@en ;
    rdfs:comment
        "Documento digital oficial que certifica a conclusão de curso de graduação, com validade jurídica assegurada por assinatura digital e carimbo de tempo conforme regulamentação brasileira."@pt ,
        "Official digital document certifying completion of an undergraduate program, with legal validity ensured by digital signature and timestamp according to Brazilian regulation."@en ;
    rdfs:subClassOf prov:Entity , schema:DigitalDocument ;
    # owl:disjointWith declara que duas classes são conceitualmente disjuntas:
    # uma mesma instância não deve pertencer simultaneamente às classes separadas por essa relação.
    # Exemplo: um DiplomaDigital não deve ser também um Diplomado, Curso ou RegistroDiploma.
    # Explicação didática: evita confundir coisas diferentes; um documento de diploma
    # não deve ser tratado como se fosse a pessoa diplomada ou o curso.
    owl:disjointWith odd:Diplomado ,
        odd:Curso ,
        odd:RegistroDiploma ,
        odd:AssinaturaDigital ,
        odd:CodigoValidacao ,
        odd:HistoricoEscolarDigital ;
    skos:prefLabel
        "diploma digital"@pt ,
        "digital diploma"@en ;
    skos:altLabel
        "diploma eletrônico"@pt ,
        "electronic diploma"@en ;
    skos:definition
        "Documento digital oficial que comprova a conclusão de curso superior e sua validade institucional."@pt ,
        "Official digital document that proves completion of a higher education program and its institutional validity."@en ;
    odd:sourceNote
        "Entidade central do domínio, mantida como classe OWL por representar um tipo de recurso institucional e não um conceito de vocabulário controlado. Sua base documental está em TDiploma e TInfDiploma no XSD Leiaute Diploma Digital v1.05, exposto pelo XSD Diploma Digital_v1.05."@pt ;
    # As restrições nomeadas desta classe ficam agrupadas na seção final "# Restrictions".
    odd:competencyQuestion odd:QC1 , odd:QC2 , odd:QC3 , odd:QC7 ;
    odd:modelingRationale
        "Foi modelada como classe OWL porque representa o documento central do dominio, com instancias, propriedades e restricoes proprias."@pt ;
    skos:scopeNote
        "Na leitura didática, esta classe pode ser entendida como o objeto documental central em torno do qual as demais entidades e relações orbitam."@pt ;
    skos:example
        "Um diploma digital emitido por uma universidade federal e assinado eletronicamente."@pt .

odd:DiplomaDigital
    rdfs:subClassOf
        odd:RestricaoDiplomaTemTitularMinimo1 ,
        odd:RestricaoDiplomaEmitidoPorExatamente1 ,
        odd:RestricaoDiplomaRegistradoPorExatamente1 ,
        odd:RestricaoDiplomaTemCursoMinimo1 ,
        odd:RestricaoDiplomaTemRegistroMaximo1 ,
        odd:RestricaoDiplomaTemAmbienteExatamente1 ,
        odd:RestricaoDiplomaTemAssinaturaMinimo1 ,
        odd:RestricaoDiplomaTemCodigoValidacaoMaximo1 ,
        odd:RestricaoDiplomaTemSituacaoMaximo1 .

odd:Diplomado
    a owl:Class ;
    rdfs:label
        "Diplomado"@pt ,
        "Graduate"@en ;
    rdfs:comment
        "Pessoa que concluiu um curso de graduação e é titular de diploma digital emitido ou registrado por uma IES."@pt ,
        "Person who completed an undergraduate program and holds a digital diploma issued or registered by a higher education institution."@en ;
    rdfs:subClassOf foaf:Person , prov:Person , schema:Person ;
    owl:disjointWith odd:Curso , odd:RegistroDiploma ;
    skos:prefLabel
        "diplomado"@pt ,
        "graduate"@en ;
    skos:altLabel
        "egresso"@pt ;
    skos:definition
        "Pessoa que concluiu um curso superior e figura como titular do diploma digital correspondente."@pt ,
        "Person who completed a higher education program and is the holder of the corresponding digital diploma."@en ;
    odd:sourceNote
        "Classe consolidada a partir dos termos 'aluno', 'estudante' e 'diplomado', visando reduzir ambiguidades terminológicas."@pt ;
    odd:modelingRationale
        "Foi modelada como subclasse de schema:Person para representar um papel mais especifico do que a nocao generica de pessoa, sem equivalencia total com o vocabulario externo."@pt ;
    odd:competencyQuestion odd:QC4 , odd:QC7 ;
    skos:scopeNote
        "Use esta classe para a pessoa que concluiu o curso e é titular do diploma, e não para qualquer estudante em processo de formação."@pt ;
    skos:example
        "Egresso identificado como titular do diploma digital correspondente ao curso concluido."@pt .

odd:LocalNaturalidade
    a owl:Class ;
    rdfs:label
        "Local de naturalidade"@pt ,
        "Birthplace"@en ;
    rdfs:comment
        "Local de nascimento informado para o diplomado pela estrutura complexa TNaturalidade do XSD do Diploma Digital."@pt ,
        "Birthplace reported for the graduate by the TNaturalidade complex structure of the Digital Diploma XSD."@en ;
    rdfs:subClassOf dbo:Place , schema:Place ;
    skos:prefLabel
        "local de naturalidade"@pt ,
        "birthplace"@en ;
    skos:definition
        "Recurso geográfico que materializa a naturalidade do diplomado como município brasileiro, identificado por código IBGE, nome e UF, ou como município estrangeiro identificado por nome."@pt ,
        "Geographic resource that represents the graduate's birthplace as a Brazilian municipality identified by IBGE code, name and federative unit, or as a foreign municipality identified by name."@en ;
    dcterms:source odd:FonteXsdLeiauteDiplomaDigital , odd:FonteXsdTiposBasicos , odd:FonteXsdNormalizado ;
    odd:xsdPath
        "TDadosDiplomado/Naturalidade" ,
        "TDadosDiplomadoPorDecisaoJudicial/Naturalidade" ;
    odd:xsdElement "Naturalidade" ;
    odd:xsdType "TNaturalidade" ;
    odd:sourceNote
        "No XSD normalizado, TNaturalidade reutiliza GMunicipio. Esse grupo admite a sequência brasileira CodigoMunicipio, NomeMunicipio e UF ou a sequência estrangeira NomeMunicipioEstrangeiro. No ramo por decisão judicial, Naturalidade pode ser substituída por Naturalidade_Indisponivel."@pt ;
    odd:modelingRationale
        "A estrutura complexa foi modelada como recurso, e não como literal, para preservar seus componentes, permitir identificação por código IBGE e viabilizar alinhamento interoperável com dbo:Place e dbo:birthPlace."@pt ;
    skos:scopeNote
        "Use esta classe somente para o lugar de nascimento associado ao diplomado. Não a utilize para representar endereço residencial, endereço institucional, nacionalidade ou UF de emissão de documento."@pt ;
    skos:example
        "São José do Calçado, identificado pelo código IBGE 3204807 e pela UF ES, como local de naturalidade de um diplomado."@pt .

odd:InstituicaoEnsinoSuperior
    a owl:Class ;
    rdfs:label
        "Instituição de Ensino Superior"@pt ,
        "Higher Education Institution"@en ;
    rdfs:comment
        "Instituição de ensino superior envolvida na emissão, registro ou manutenção de dados acadêmicos relacionados ao diploma digital."@pt ,
        "Higher education institution involved in issuing, registering or maintaining academic data related to the digital diploma."@en ;
    rdfs:subClassOf foaf:Organization , prov:Organization , schema:CollegeOrUniversity ;
    skos:prefLabel
        "instituição de ensino superior"@pt ,
        "higher education institution"@en ;
    skos:altLabel
        "IES"@pt ,
        "instituição de educação superior"@pt ;
    skos:definition
        "Organização de ensino superior que participa da emissão, registro ou manutenção dos dados do diploma digital."@pt ,
        "Higher education organization that participates in issuing, registering or maintaining digital diploma data."@en ;
    odd:sourceNote
        "A classe foi alinhada por subclasse a schema:CollegeOrUniversity, classe do Schema.org usada para organizações de ensino superior. No TTL, esse alinhamento funciona como aproximação de interoperabilidade, enquanto a classe local permanece restrita ao contexto operacional do diploma digital."@pt ;
    odd:modelingRationale
        "Optou-se por usar rdfs:subClassOf, e não owl:equivalentClass, para evitar afirmar que toda instância de schema:CollegeOrUniversity pertença automaticamente ao escopo desta ontologia. Aqui, apenas instituições efetivamente envolvidas na emissão, no registro ou na manutenção de dados do diploma digital são instâncias de odd:InstituicaoEnsinoSuperior."@pt ;
    odd:competencyQuestion odd:QC1 , odd:QC3 , odd:QC6 ;
    skos:scopeNote
        "Use esta classe quando o modelo precisar representar genericamente uma IES, sem fixar ainda se ela atua como emissora, registradora ou mantenedora dos dados. Quando a funcao institucional estiver definida, prefira a subclasse correspondente."@pt ;
    skos:example
        "Instituicao de ensino superior referenciada genericamente antes da especializacao como IES emissora ou IES registradora."@pt .

odd:Endereco
    a owl:Class ;
    rdfs:label
        "Endereço"@pt ,
        "Address"@en ;
    rdfs:comment
        "Estrutura postal associada a instituição de ensino superior ou curso, conforme o tipo TEndereco dos leiautes XSD do MEC."@pt ,
        "Postal structure associated with a higher education institution or academic program, according to the TEndereco type in the MEC XSD layouts."@en ;
    rdfs:subClassOf locn:Address , vcard:Address ;
    skos:prefLabel
        "endereço"@pt ,
        "address"@en ;
    skos:altLabel
        "endereço postal"@pt ;
    skos:definition
        "Estrutura de localização postal usada para registrar logradouro, município, UF, CEP e país quando aplicável."@pt ,
        "Postal location structure used to record street address, municipality, region, postal code and country when applicable."@en ;
    skos:scopeNote
        "Use esta classe para a estrutura postal associada a instituicoes, cursos ou outras entidades do modelo. Nao use para representar o agente, a instituicao ou o documento que possui o endereco."@pt ,
        "Use this class for the postal structure associated with institutions, programs, or other model entities. Do not use it to represent the agent, institution, or document that holds the address."@en ;
    dcterms:source odd:FonteXsdLeiauteDiplomaDigital , odd:FonteXsdTiposBasicos ;
    odd:xsdElement "Endereco" , "EnderecoCurso" ;
    odd:xsdType "TEndereco" ;
    odd:sourceNote
        "Derivada do tipo TEndereco dos leiautes XSD do MEC, reutilizada para enderecos institucionais e de curso sem multiplicar classes estruturais equivalentes."@pt ;
    odd:modelingRationale
        "Foi modelada como classe para alinhar os campos de endereco do XSD a vocabularios externos especializados sem criar uma camada adicional de mapeamento."@pt ;
    skos:example
        "Endereco da sede da IES emissora com logradouro, municipio, UF e CEP."@pt .

odd:IesEmissora
    a owl:Class ;
    rdfs:label
        "IES Emissora"@pt ,
        "Issuing HEI"@en ;
    rdfs:comment
        "Instituição de Ensino Superior que exerce o papel de emissão do diploma digital e de geração dos dados acadêmicos correspondentes."@pt ,
        "Higher Education Institution that performs the role of issuing the digital diploma and generating the corresponding academic data."@en ;
    rdfs:subClassOf odd:InstituicaoEnsinoSuperior ;
    skos:prefLabel
        "IES emissora"@pt ,
        "issuing HEI"@en ;
    skos:altLabel
        "instituição emissora"@pt ;
    skos:definition
        "Instituição de ensino superior que exerce a função de emissão do diploma digital e fornece os dados acadêmicos associados ao documento."@pt ,
        "Higher education institution that performs the issuing function for the digital diploma and provides the academic data associated with the document."@en ;
    odd:sourceNote
        "Especializacao criada no projeto a partir da funcao de emissao identificada nos leiautes XSD e na regulamentacao do diploma digital, para distinguir semanticamente o papel de emissao do papel de registro."@pt ;
    odd:modelingRationale
        "Foi modelada como subclasse de odd:InstituicaoEnsinoSuperior para representar um papel institucional no fluxo do diploma digital. A separacao semantica em relacao a odd:IesRegistradora distingue funcoes, mas nao exige que sejam instituicoes diferentes."@pt ;
    skos:scopeNote
        "Use esta classe para a IES que exerce o papel de emissao do diploma e gera os dados academicos correspondentes. Esta classificacao representa funcao institucional e nao implica necessariamente identidade institucional distinta da odd:IesRegistradora. Quando a mesma IES tambem exercer o papel de registro, o mesmo individuo pode receber ambos os tipos."@pt ;
    skos:example
        "No cenario em que a universidade apenas emite e outra instituicao registra, a IES emissora e a IES registradora sao individuos distintos. No cenario em que a mesma universidade emite e registra, um unico individuo pode ser tipado como odd:IesEmissora e odd:IesRegistradora."@pt .

odd:IesRegistradora
    a owl:Class ;
    rdfs:label
        "IES Registradora"@pt ,
        "Registering HEI"@en ;
    rdfs:comment
        "Instituição de Ensino Superior que exerce o papel de registro do diploma digital e formaliza sua validade institucional."@pt ,
        "Higher Education Institution that performs the role of registering the digital diploma and formalizing its institutional validity."@en ;
    rdfs:subClassOf odd:InstituicaoEnsinoSuperior ;
    skos:prefLabel
        "IES registradora"@pt ,
        "registering HEI"@en ;
    skos:altLabel
        "instituição registradora"@pt ;
    skos:definition
        "Instituição de ensino superior que exerce a função de registro do diploma digital e formaliza sua validade institucional."@pt ,
        "Higher education institution that performs the registration function for the digital diploma and formalizes its institutional validity."@en ;
    odd:sourceNote
        "Especializacao criada no projeto a partir da funcao de registro identificada nos leiautes XSD e na regulamentacao do diploma digital, para distinguir semanticamente a instituicao autorizada a registrar do papel de emissao."@pt ;
    odd:modelingRationale
        "Foi modelada como subclasse de odd:InstituicaoEnsinoSuperior para representar um papel institucional proprio no fluxo do diploma digital. A separacao semantica em relacao a odd:IesEmissora distingue funcoes, mas nao exige que sejam instituicoes diferentes."@pt ;
    skos:scopeNote
        "Use esta classe para a IES que exerce o papel de registro institucional do diploma. Esta classificacao representa funcao institucional e nao implica necessariamente identidade institucional distinta da odd:IesEmissora. Quando a mesma IES tambem exercer o papel de emissao, o mesmo individuo pode receber ambos os tipos."@pt ;
    skos:example
        "No cenario em que uma instituicao recebe o diploma emitido por outra e efetiva o registro, a IES registradora e distinta da IES emissora. No cenario em que a mesma instituicao emite e registra, um unico individuo pode ser tipado como odd:IesRegistradora e odd:IesEmissora."@pt .

odd:Curso
    a owl:Class ;
    rdfs:label
        "Curso"@pt ,
        "Academic Program"@en ;
    rdfs:comment
        "Estrutura formativa concluída pelo diplomado, vinculada ao diploma digital e identificada por metadados institucionais e regulatórios."@pt ,
        "Educational program completed by the graduate, linked to the digital diploma and identified by institutional and regulatory metadata."@en ;
    rdfs:subClassOf prov:Entity ;
    owl:disjointWith odd:RegistroDiploma ;
    skos:prefLabel
        "curso"@pt ,
        "academic program"@en ;
    skos:altLabel
        "curso superior"@pt ;
    skos:definition
        "Estrutura formativa concluída pelo diplomado e vinculada ao diploma digital."@pt ,
        "Educational structure completed by the graduate and linked to the digital diploma."@en ;
    odd:sourceNote
        "Corresponde ao bloco DadosCurso do leiaute oficial do MEC, incluindo as especializacoes TDadosCursoNSF e TDadosCursoPorDecisaoJudicial no XSD Leiaute Diploma Digital v1.05."@pt ;
    odd:competencyQuestion odd:QC3 , odd:QC4 ;
    skos:scopeNote
        "Use para representar o curso concluido ao qual se vinculam grau conferido, titulo conferido, modalidade, habilitacoes e metadados regulatorios."@pt ;
    odd:modelingRationale
        "Foi modelado como classe porque concentra valores controlados, habilitacoes, dados regulatorios e vinculos com diplomado e diploma."@pt ;
    skos:example
        "Curso de graduacao vinculado ao diploma, com modalidade presencial, grau bacharelado e titulo conferido ao concluinte."@pt .

odd:CursoNSF
    a owl:Class ;
    rdfs:label
        "Curso NSF"@pt ,
        "NSF Academic Program"@en ;
    rdfs:comment
        "Especializacao de Curso para representar o bloco TDadosCursoNSF, usado no contexto de diplomacao fora do sistema federal."@pt ,
        "Specialization of Academic Program representing the TDadosCursoNSF block used in non-federal-system graduation contexts."@en ;
    rdfs:subClassOf odd:Curso ,
        odd:RestricaoCursoTemEnderecoExatamente1 ;
    skos:prefLabel
        "curso NSF"@pt ,
        "NSF academic program"@en ;
    skos:altLabel
        "curso fora do sistema federal"@pt ;
    skos:definition
        "Curso modelado a partir da variante NSF do leiaute, preservando a semantica de curso e a especializacao documental do XSD."@pt ,
        "Academic program modeled from the NSF layout variant, preserving both the program semantics and the documentary specialization of the XSD."@en ;
    dcterms:source odd:FonteXsdLeiauteDiplomaDigital ;
    odd:xsdElement "DadosCurso" ;
    odd:xsdType "TDadosCursoNSF" ;
    odd:sourceNote
        "Subclasse adotada para registrar que o XSD distingue TDadosCursoNSF de TDadosCurso sem exigir uma remodelagem completa das demais entidades do curso."@pt ;
    skos:scopeNote
        "Use quando a origem estrutural do curso vier explicitamente do ramo NSF."@pt ;
    odd:modelingRationale
        "Foi modelada como subclasse para preservar a variante estrutural NSF sem romper a semantica geral de odd:Curso."@pt ;
    skos:example
        "Curso modelado a partir do ramo TDadosCursoNSF em um caso de diploma fora do sistema federal."@pt .

odd:CursoPorDecisaoJudicial
    a owl:Class ;
    rdfs:label
        "Curso por Decisão Judicial"@pt ,
        "Academic Program by Court Decision"@en ;
    rdfs:comment
        "Especialização de Curso para diplomas emitidos por decisão judicial, na qual o endereço do curso pode ser substituído por declaração expressa de indisponibilidade."@pt ,
        "Specialization of Academic Program for diplomas issued by court decision, in which the program address may be replaced by an explicit unavailability declaration."@en ;
    rdfs:subClassOf odd:Curso ,
        odd:AlternativaEnderecoCursoJudicial ;
    owl:disjointWith odd:CursoNSF ;
    skos:prefLabel
        "curso por decisão judicial"@pt ,
        "academic program by court decision"@en ;
    skos:altLabel
        "curso judicial"@pt ;
    skos:definition
        "Curso representado pela variante TDadosCursoPorDecisaoJudicial, com escolha entre endereço informado e declaração de indisponibilidade."@pt ,
        "Academic program represented by the TDadosCursoPorDecisaoJudicial variant, with a choice between a supplied address and an unavailability declaration."@en ;
    dcterms:source odd:FonteXsdLeiauteDiplomaDigital ;
    odd:xsdElement "DadosCurso" ;
    odd:xsdType "TDadosCursoPorDecisaoJudicial" ;
    odd:xsdPath "TDadosCursoPorDecisaoJudicial/(EnderecoCurso|EnderecoCurso_Indisponivel)" ;
    odd:sourceNote
        "O XSD declara um xs:choice obrigatório entre EnderecoCurso, do tipo TEndereco, e EnderecoCurso_Indisponivel, do tipo TVazio."@pt ;
    skos:scopeNote
        "Use somente quando a origem estrutural do curso for o ramo por decisão judicial. A indisponibilidade deve vir expressamente da fonte e não pode ser inferida da simples ausência de endereço."@pt ;
    odd:modelingRationale
        "A variante foi promovida a subclasse porque possui regra de integridade própria e reutilizável. A união OWL documenta as alternativas; a exclusividade é validada de forma bloqueante por SHACL sob semântica de mundo fechado."@pt ;
    skos:example
        "Curso de diploma emitido por decisão judicial com endereço informado ou com declaração explícita EnderecoCurso_Indisponivel."@pt .

odd:Curso
    rdfs:subClassOf
        odd:RestricaoCursoConfereGrauExatamente1 ,
        odd:RestricaoCursoConfereTituloMaximo1 ,
        odd:RestricaoCursoTemModalidadeOfertaExatamente1 ,
        odd:RestricaoCursoTemTramitacaoEmecMaximo1 ,
        odd:RestricaoCursoTemCodigoEmecMaximo1 ,
        odd:RestricaoCursoTemOutroTituloConferidoMaximo1 .

odd:Habilitacao
    a owl:Class ;
    rdfs:label
        "Habilitação"@pt ,
        "Qualification Track"@en ;
    rdfs:comment
        "Estrutura associada ao curso para registrar habilitações específicas e suas datas, quando previstas no leiaute do diploma."@pt ,
        "Structure associated with the academic program to record specific qualification tracks and their dates when provided in the diploma layout."@en ;
    rdfs:subClassOf prov:Entity ;
    skos:prefLabel
        "habilitação"@pt ,
        "qualification track"@en ;
    skos:altLabel
        "habilitação específica"@pt ;
    skos:definition
        "Estrutura acadêmica associada ao curso para registrar uma habilitação específica."@pt ,
        "Academic structure associated with the program to record a specific qualification track."@en ;
    skos:scopeNote
        "Use esta classe para habilitacoes especificas associadas ao curso. Nao use para representar grau conferido, titulo conferido ou modalidade de oferta, que pertencem a camadas semanticas diferentes."@pt ,
        "Use this class for specific qualification tracks associated with the program. Do not use it to represent awarded degree, awarded title, or mode of delivery, which belong to different semantic layers."@en ;
    odd:sourceNote
        "Derivada do tipo THabilitacao do leiaute do MEC, com os campos NomeHabilitacao e DataHabilitacao."@pt ;
    odd:modelingRationale
        "Foi modelada como classe para identificar habilitacoes especificas do curso, inclusive quando houver mais de uma no mesmo caso."@pt ;
    skos:example
        "Habilitacao especifica de um curso com nome proprio e data de habilitacao associada."@pt .

odd:Habilitacao
    rdfs:subClassOf
        odd:RestricaoHabilitacaoNomeExatamente1 ,
        odd:RestricaoHabilitacaoDataExatamente1 .

odd:InformacoesTramitacaoEmec
    a owl:Class ;
    rdfs:label
        "Informações de tramitação e-MEC"@pt ,
        "e-MEC processing information"@en ;
    rdfs:comment
        "Estrutura alternativa ao código e-MEC do curso, usada para registrar informações de tramitação processual quando o código não está disponível."@pt ,
        "Structure alternative to the program e-MEC code, used to record processing information when the code is not available."@en ;
    rdfs:subClassOf prov:Entity ;
    skos:prefLabel
        "informações de tramitação e-MEC"@pt ,
        "e-MEC processing information"@en ;
    skos:altLabel
        "dados de tramitação e-MEC"@pt ;
    skos:definition
        "Estrutura usada quando o curso não possui código e-MEC, mas possui dados processuais de tramitação."@pt ,
        "Structure used when the academic program has no e-MEC code but has procedural processing data."@en ;
    skos:scopeNote
        "Use esta classe quando o curso nao tiver codigo e-MEC informado, mas possuir numero, tipo e datas de tramitacao processual. Nao use para substituir o proprio curso nem para representar ato regulatorio completo."@pt ,
        "Use this class when the program has no reported e-MEC code but has procedural processing number, type, and dates. Do not use it to replace the program itself or to represent a complete regulatory act."@en ;
    odd:sourceNote
        "Derivada do tipo TInformacoesTramitacaoEMEC, usado no XSD como alternativa a CodigoCursoEMEC e tambem em atos regulatorios e polos."@pt ;
    odd:modelingRationale
        "Foi modelada como classe para agrupar os dados processuais do e-MEC e evitar sua dispersao em literais soltos no curso."@pt ;
    skos:example
        "Informacoes processuais de tramitacao e-MEC usadas quando o curso ainda nao possui codigo e-MEC consolidado."@pt .

odd:RegistroDiploma
    a owl:Class ;
    rdfs:label
        "Registro do Diploma"@pt ,
        "Diploma Registration"@en ;
    rdfs:comment
        "Ato formal de registro do diploma, incluindo informações de livro, folha, sequência, data e instituição registradora."@pt ,
        "Formal act of diploma registration, including registry book, page, sequence, date and registering institution information."@en ;
    rdfs:subClassOf prov:Activity ;
    skos:prefLabel
        "registro do diploma"@pt ,
        "diploma registration"@en ;
    skos:altLabel
        "ato de registro do diploma"@pt ;
    skos:definition
        "Ato formal pelo qual o diploma digital é registrado institucionalmente."@pt ,
        "Formal act by which the digital diploma is institutionally registered."@en ;
    skos:scopeNote
        "Use esta classe para o ato ou evento de registro do diploma, com seus dados de livro, folha, sequencia, data e agentes envolvidos. Nao use para representar o diploma em si nem a instituicao registradora isoladamente."@pt ,
        "Use this class for the act or event of diploma registration, with its book, page, sequence, date, and involved agents. Do not use it to represent the diploma itself or the registering institution in isolation."@en ;
    odd:sourceNote
        "Formaliza o bloco TDadosRegistro/TLivroRegistro do leiaute do diploma digital, incluindo suas especializacoes NSF e judicial, com dados de registro, datas e responsavel pelo registro."@pt ;
    odd:competencyQuestion odd:QC2 , odd:QC6 ;
    odd:modelingRationale
        "Foi modelada como atividade porque o registro tem temporalidade, agentes responsaveis e metadados proprios, distintos do diploma e da instituicao registradora."@pt ;
    skos:example
        "Ato de registro de um diploma com data de registro, numero sequencial, livro, folha e vinculacao a IES registradora."@pt .

odd:RegistroDiploma
    rdfs:subClassOf
        odd:RestricaoRegistroDiplomaDataRegistroExatamente1 ,
        odd:RestricaoRegistroDiplomaSolicitacaoDocumentoExatamente1 ,
        odd:RestricaoRegistroDiplomaProcessoAdministrativoExatamente1 ,
        odd:RestricaoRegistroDiplomaDataConcessaoExatamente1 ,
        odd:RestricaoRegistroDiplomaDataExpedicaoExatamente1 ,
        odd:RestricaoRegistroDiplomaResponsavelExatamente1 .

odd:RegistroDiplomaNSF
    a owl:Class ;
    rdfs:label
        "Registro do Diploma NSF"@pt ,
        "NSF Diploma Registration"@en ;
    rdfs:comment
        "Especializacao de RegistroDiploma para representar o bloco TDadosRegistroNSF no contexto de universidades fora do sistema federal."@pt ,
        "Specialization of Diploma Registration representing the TDadosRegistroNSF block in non-federal-system university contexts."@en ;
    rdfs:subClassOf odd:RegistroDiploma ;
    skos:prefLabel
        "registro do diploma NSF"@pt ,
        "NSF diploma registration"@en ;
    skos:altLabel
        "registro NSF do diploma"@pt ;
    skos:definition
        "Ato formal de registro do diploma quando a estrutura documental do XSD utiliza a variante TDadosRegistroNSF."@pt ,
        "Formal act of diploma registration when the documentary structure of the XSD uses the TDadosRegistroNSF variant."@en ;
    dcterms:source odd:FonteXsdLeiauteDiplomaDigital ;
    odd:xsdElement "DadosRegistro" ;
    odd:xsdType "TDadosRegistroNSF" ;
    odd:sourceNote
        "Subclasse adotada para explicitar a especializacao semantica reaproveitavel de TDadosRegistroNSF sem promover automaticamente subclasses NSF para IES, assinantes ou seguranca."@pt ;
    skos:scopeNote
        "Use quando a origem estrutural do registro vier explicitamente do ramo NSF."@pt ;
    odd:modelingRationale
        "Foi modelada como subclasse para preservar a variante estrutural TDadosRegistroNSF e permitir consultas especificas sobre esse ramo documental."@pt ;
    skos:example
        "Registro de diploma modelado a partir da variante TDadosRegistroNSF, mantendo a semantica do ato de registro e sua origem estrutural especifica."@pt .

odd:ResponsavelRegistro
    a owl:Class ;
    rdfs:label
        "Responsável pelo Registro"@pt ,
        "Registration Responsible Person"@en ;
    rdfs:comment
        "Pessoa indicada no bloco LivroRegistro como responsável administrativo pelo registro do diploma."@pt ,
        "Person indicated in the LivroRegistro block as administratively responsible for the diploma registration."@en ;
    rdfs:subClassOf foaf:Person , prov:Person , schema:Person ;
    skos:prefLabel
        "responsável pelo registro"@pt ,
        "registration responsible person"@en ;
    skos:altLabel
        "responsável administrativo pelo registro"@pt ;
    skos:definition
        "Agente humano responsável pelo ato administrativo de registro do diploma no âmbito da IES registradora."@pt ,
        "Human agent responsible for the administrative act of diploma registration within the registering HEI."@en ;
    dcterms:source odd:FonteXsdLeiauteDiplomaDigital , odd:FonteXsdTiposBasicos ;
    odd:xsdPath "TDadosRegistro/LivroRegistro/ResponsavelRegistro" ;
    odd:xsdElement "ResponsavelRegistro" ;
    odd:sourceNote
        "Classe criada na v1_17 para representar explicitamente o agente indicado no XSD em ResponsavelRegistro, sem confundi-lo com a IES registradora nem com o diplomado."@pt ;
    odd:modelingRationale
        "Foi modelada como classe propria para individualizar o agente administrativo responsavel pelo registro e distingui-lo da instituicao registradora e do assinante do registro."@pt ;
    odd:competencyQuestion odd:QC6 ;
    skos:scopeNote
        "Use esta classe para a pessoa explicitamente indicada no bloco LivroRegistro como responsavel administrativo pelo registro. Nao use para representar a IES registradora nem o assinante declarado no bloco Assinantes."@pt ;
    skos:example
        "Servidor ou gestor informado no LivroRegistro como responsavel pelo ato administrativo de registro do diploma."@pt .

odd:AssinanteRegistro
    a owl:Class ;
    rdfs:label
        "Assinante do Registro"@pt ,
        "Registration Signer"@en ;
    rdfs:comment
        "Pessoa ou agente indicado no bloco Assinantes associado aos dados de registro do diploma."@pt ,
        "Person or agent indicated in the Assinantes block associated with the diploma registration data."@en ;
    rdfs:subClassOf foaf:Person , prov:Agent , schema:Person ;
    skos:prefLabel
        "assinante do registro"@pt ,
        "registration signer"@en ;
    skos:altLabel
        "assinante administrativo"@pt ;
    skos:definition
        "Agente que assina ou declara cargo no contexto administrativo do registro do diploma."@pt ,
        "Agent who signs or declares a role in the administrative context of diploma registration."@en ;
    dcterms:source odd:FonteXsdLeiauteDiplomaDigital , odd:FonteXsdTiposBasicos ;
    odd:xsdPath "TDadosRegistro/Assinantes/Assinante" ;
    odd:xsdElement "Assinantes" , "Assinante" ;
    odd:xsdType "TInfoAssinantes" ;
    odd:sourceNote
        "Esta classe representa o assinante administrativo informado no bloco Assinantes. Ela não substitui a classe AssinaturaDigital, que representa ds:Signature e a dimensão criptográfica da assinatura XML."@pt ;
    odd:modelingRationale
        "Foi modelada separadamente de odd:AssinaturaDigital para distinguir o agente administrativo informado no bloco Assinantes do artefato criptografico da assinatura."@pt ;
    odd:competencyQuestion odd:QC6 ;
    skos:scopeNote
        "Use esta classe para o agente listado no bloco Assinantes relativo ao registro, quando o foco for o papel administrativo declarado no documento. Nao use para representar o artefato criptografico da assinatura nem, sem qualificacao, o responsavel pelo registro."@pt ;
    skos:example
        "Reitor, diretor ou outro signatario indicado no bloco Assinantes dos dados de registro do diploma."@pt .

odd:AssinanteEmissao
    a owl:Class ;
    rdfs:label
        "Assinante da Emissão"@pt ,
        "Issuance Signer"@en ;
    rdfs:comment
        "Pessoa ou agente indicado no bloco Assinantes associado aos dados de emissão do diploma."@pt ,
        "Person or agent indicated in the Assinantes block associated with the diploma issuance data."@en ;
    rdfs:subClassOf odd:RepresentanteInstitucionalEmissora , foaf:Person , prov:Agent , schema:Person ;
    skos:prefLabel
        "assinante da emissão"@pt ,
        "issuance signer"@en ;
    skos:altLabel
        "assinante administrativo da emissão"@pt ;
    skos:definition
        "Agente que assina ou declara cargo no contexto administrativo da emissão do diploma."@pt ,
        "Agent who signs or declares a role in the administrative context of diploma issuance."@en ;
    skos:scopeNote
        "Use esta classe para a pessoa identificada no bloco Assinantes dos dados de emissao do diploma. Nao use para representar a IES emissora, o signatario do TermoResponsabilidadeEmissora ou a assinatura digital criptografica em si."@pt ,
        "Use this class for the person identified in the Assinantes block of the diploma issuance data. Do not use it to represent the issuing HEI, the signer of the TermoResponsabilidadeEmissora, or the cryptographic digital signature itself."@en ;
    dcterms:source odd:FonteXsdLeiauteDiplomaDigital , odd:FonteXsdTiposBasicos ;
    odd:xsdPath
        "TDadosDiploma/Assinantes/Assinante" ,
        "TDadosDiplomaNSF/Assinantes/Assinante" ,
        "TDadosDiplomaPorDecisaoJudicial/Assinantes/Assinante" ;
    odd:xsdElement "Assinantes" , "Assinante" ;
    odd:xsdType "TInfoAssinantes" ;
    odd:sourceNote
        "Esta classe representa o assinante administrativo informado no bloco Assinantes da emissão. Ela não substitui a classe AssinaturaDigital, que representa ds:Signature e a dimensão criptográfica da assinatura XML."@pt ;
    odd:modelingRationale
        "Foi modelada separadamente de odd:AssinaturaDigital e de odd:SignatarioTermoResponsabilidadeEmissora para distinguir o assinante administrativo da emissao do artefato criptografico e do signatario do termo."@pt ;
    skos:example
        "O reitor ou dirigente academico informado no bloco Assinantes do diploma como responsavel pela emissao."@pt ;
    odd:competencyQuestion odd:QC2 .

odd:RepresentanteInstitucionalEmissora
    a owl:Class ;
    rdfs:label
        "Representante Institucional da Emissora"@pt ,
        "Issuing HEI Institutional Representative"@en ;
    rdfs:comment
        "Agente humano que atua institucionalmente em nome da IES emissora em atos administrativos de emissão, responsabilidade ou formalização documental do diploma digital."@pt ,
        "Human agent who acts institutionally on behalf of the issuing HEI in administrative acts of issuance, responsibility, or documentary formalization of the digital diploma."@en ;
    rdfs:subClassOf foaf:Person , prov:Agent , schema:Person ;
    skos:prefLabel
        "representante institucional da emissora"@pt ,
        "issuing HEI institutional representative"@en ;
    skos:altLabel
        "agente institucional da emissora"@pt ,
        "representante da emissora"@pt ;
    skos:definition
        "Superclasse semântica criada para agrupar, no lado da emissão, agentes humanos que representam institucionalmente a IES emissora sem confundi-los com a própria instituição, com a assinatura digital criptográfica ou com a cadeia certificadora técnica."@pt ,
        "Semantic superclass created to group, on the issuance side, human agents who institutionally represent the issuing HEI without conflating them with the institution itself, the cryptographic digital signature, or the technical certification chain."@en ;
    skos:scopeNote
        "Use esta classe como superclasse agregadora para papeis humanos exercidos em nome da IES emissora, como odd:AssinanteEmissao e odd:SignatarioTermoResponsabilidadeEmissora. Nao use como se fosse elemento ou tipo declarado literalmente nos XSDs oficiais, nem para representar a IES emissora, a assinatura digital ou a cadeia certificadora tecnica."@pt ,
        "Use this class as an aggregating superclass for human roles performed on behalf of the issuing HEI, such as odd:AssinanteEmissao and odd:SignatarioTermoResponsabilidadeEmissora. Do not use it as if it were an element or type literally declared in the official XSDs, nor to represent the issuing HEI, the digital signature, or the technical certification chain."@en ;
    dcterms:source odd:FonteXsdLeiauteDiplomaDigital , odd:FonteXsdLeiauteDocumentacaoAcademicaRegistro ;
    odd:sourceNote
        "Esta classe nao aparece nominalmente como tipo ou elemento autonomo nos XSDs oficiais. Ela foi introduzida por leitura integrada do bloco de assinantes da emissao com o TermoResponsabilidadeEmissora, combinada com a interpretacao regulatoria da IN 05 sobre a responsabilidade institucional da emissora."@pt ;
    odd:modelingRationale
        "Foi modelada como superclasse agregadora para reunir, sem colapsar, os papeis humanos da emissora e evitar o uso de odd:AgenteCertificador como ator academico-regulatorio."@pt ;
    skos:example
        "O reitor que assina a emissao do diploma e o dirigente que subscreve o termo de responsabilidade da emissora podem ser consultados como representantes institucionais da emissora, ainda que aparecam em estruturas diferentes do leiaute."@pt .

odd:SignatarioTermoResponsabilidadeEmissora
    a owl:Class ;
    rdfs:label
        "Signatário do Termo de Responsabilidade da Emissora"@pt ,
        "Issuance Responsibility Statement Signer"@en ;
    rdfs:comment
        "Pessoa física identificada no termo de responsabilidade da IES emissora anexado à documentação acadêmica."@pt ,
        "Natural person identified in the issuing HEI responsibility statement attached to the academic documentation."@en ;
    rdfs:subClassOf odd:RepresentanteInstitucionalEmissora , foaf:Person , prov:Agent , schema:Person ;
    skos:prefLabel
        "signatário do termo de responsabilidade da emissora"@pt ,
        "issuance responsibility statement signer"@en ;
    skos:altLabel
        "signatário da responsabilidade da emissora"@pt ;
    skos:definition
        "Agente humano que assina o TermoResponsabilidadeEmissora e formaliza a responsabilidade da IES emissora sobre a documentação acadêmica submetida."@pt ,
        "Human agent who signs the TermoResponsabilidadeEmissora and formalizes the issuing HEI responsibility over the submitted academic documentation."@en ;
    dcterms:source odd:FonteXsdLeiauteDocumentacaoAcademicaRegistro , odd:FonteXsdTiposBasicos ;
    odd:xsdPath
        "TRegistroReq/TermoResponsabilidadeEmissora" ,
        "TRegistroReqNSF/TermoResponsabilidadeEmissora" ,
        "TRegistroPorDecisaoJudicialReq/TermoResponsabilidadeEmissora" ,
        "TRegistroSegundaViaReq/TermoResponsabilidadeEmissora" ;
    odd:xsdElement "TermoResponsabilidadeEmissora" ;
    odd:xsdType "TTermoResponsabilidade" ;
    skos:scopeNote
        "Use esta classe para a pessoa fisica reconstruida semanticamente a partir dos campos Nome, CPF, Cargo e AtoDesignacao do TTermoResponsabilidade. Nao use para representar a IES emissora, o ResponsavelRegistro, o AssinanteEmissao ou a assinatura digital em si, nem para supor que essa pessoa exista como classe nomeada literalmente no XSD."@pt ,
        "Use this class for the natural person semantically reconstructed from the Name, CPF, Role and AppointmentAct fields of TTermoResponsabilidade. Do not use it to represent the issuing HEI, the ResponsavelRegistro, the AssinanteEmissao, or the digital signature itself, nor to assume that this person exists as a literally named class in the XSD."@en ;
    odd:sourceNote
        "O XSD nao declara uma classe autonoma para essa pessoa; ele apenas fornece atributos literais em TTermoResponsabilidade, como Nome, CPF, Cargo e AtoDesignacao. A classe foi derivada dessa estrutura e da leitura da IN 05 sobre a responsabilidade assumida pela emissora no processo de registro."@pt ;
    odd:modelingRationale
        "Foi modelada como classe propria para individualizar a pessoa do termo de responsabilidade e liga-la semanticamente a odd:DocumentacaoAcademica sem afirmar aninhamento literal no XSD."@pt ;
    skos:example
        "O dirigente da IES emissora identificado por nome, CPF, cargo e ato de designacao no TermoResponsabilidadeEmissora."@pt ;
    odd:competencyQuestion odd:QC2 .

odd:AssinaturaDigital
    a owl:Class ;
    rdfs:label
        "Assinatura Digital"@pt ,
        "Digital Signature"@en ;
    rdfs:comment
        "Elemento criptográfico associado ao diploma digital para garantir autenticidade, integridade e não repúdio."@pt ,
        "Cryptographic element associated with the digital diploma to ensure authenticity, integrity and non-repudiation."@en ;
    rdfs:subClassOf prov:Entity ;
    skos:prefLabel
        "assinatura digital"@pt ,
        "digital signature"@en ;
    skos:definition
        "Elemento técnico que assegura autenticidade, integridade e não repúdio do diploma digital."@pt ,
        "Technical element that ensures authenticity, integrity and non-repudiation of the digital diploma."@en ;
    skos:scopeNote
        "Use esta classe para representar a assinatura digital como artefato tecnico e criptografico, incluindo relacoes com formato, papel institucional, carimbo de tempo e certificacao. Nao use para representar a pessoa que assina, a instituicao signataria ou o cargo administrativo declarado no XML."@pt ,
        "Use this class to represent the digital signature as a technical and cryptographic artifact, including relations to format, institutional role, timestamp, and certification. Do not use it to represent the signing person, the signing institution, or the administrative role declared in the XML."@en ;
    odd:sourceNote
        "Abstrai semanticamente a assinatura XML referenciada como ds:Signature nos leiautes do MEC e definida no XSD xmldsigcore-schema_v1.1."@pt ;
    odd:modelingRationale
        "Foi modelada como classe propria porque funciona como artefato tecnico individualizavel, com propriedades de formato, papel, vinculo institucional, tempo e certificacao."@pt ;
    skos:example
        "Uma ds:Signature em padrao XAdES associada ao diploma digital e vinculada semanticamente a uma IES emissora ou registradora."@pt ;
    odd:competencyQuestion odd:QC2 , odd:QC6 .

odd:AssinaturaDigital
    rdfs:subClassOf
        odd:RestricaoAssinaturaDigitalCarimboMinimo1 ,
        odd:RestricaoAssinaturaDigitalFormatoMaximo1 ,
        odd:RestricaoAssinaturaDigitalPapelMaximo1 .

odd:CarimboTempo
    a owl:Class ;
    rdfs:label
        "Carimbo de Tempo"@pt ,
        "Timestamp"@en ;
    rdfs:comment
        "Registro temporal associado à assinatura digital, atestando o momento da assinatura segundo a ICPasil."@pt ,
        "Temporal record associated with the digital signature, attesting signature time according to ICPasil."@en ;
    rdfs:subClassOf prov:InstantaneousEvent ;
    skos:prefLabel
        "carimbo de tempo"@pt ,
        "timestamp"@en ;
    skos:altLabel
        "marca temporal"@pt ;
    skos:definition
        "Registro temporal associado à assinatura digital que comprova o momento em que a assinatura foi realizada ou validada."@pt ,
        "Temporal record associated with the digital signature that proves the time at which the signature was performed or validated."@en ;
    skos:scopeNote
        "Use esta classe para a evidencia temporal vinculada a odd:AssinaturaDigital. Nao use para representar genericamente qualquer data do processo academico, como data de emissao, colacao de grau ou data de registro."@pt ,
        "Use this class for the temporal evidence linked to odd:AssinaturaDigital. Do not use it to generically represent any date in the academic process, such as issuance date, graduation date, or registration date."@en ;
    odd:sourceNote
        "Classe tecnica complementar derivada da leitura da assinatura digital e de seus metadados temporais no contexto de autenticidade e validacao do diploma digital."@pt ;
    odd:modelingRationale
        "Foi modelado como classe para representar a evidencia temporal da assinatura sem reduzi-la a um literal isolado."@pt ;
    skos:example
        "Carimbo temporal associado a uma ds:Signature para demonstrar o momento de validacao da assinatura do diploma."@pt .

odd:CodigoValidacao
    a owl:Class ;
    rdfs:label
        "Código de Validação"@pt ,
        "Validation Code"@en ;
    rdfs:comment
        "Identificador verificável publicamente que permite consultar a autenticidade de um diploma digital."@pt ,
        "Publicly verifiable identifier that allows consulting the authenticity of a digital diploma."@en ;
    rdfs:subClassOf prov:Entity ;
    skos:prefLabel
        "código de validação"@pt ,
        "validation code"@en ;
    skos:altLabel
        "código verificador"@pt ,
        "código de consulta"@pt ;
    skos:definition
        "Identificador textual usado para consulta pública e verificação da autenticidade do diploma digital."@pt ,
        "Textual identifier used for public consultation and verification of the authenticity of the digital diploma."@en ;
    skos:scopeNote
        "Use esta classe para o identificador verificavel associado ao diploma digital. Nao use para representar a URL de consulta, a plataforma de acesso ou a assinatura digital."@pt ,
        "Use this class for the verifiable identifier associated with the digital diploma. Do not use it to represent the consultation URL, the access platform, or the digital signature."@en ;
    odd:sourceNote
        "Mantido como entidade OWL, não como conceito SKOS, pois representa um identificador individual verificável e não um termo de vocabulário controlado."@pt ;
    odd:competencyQuestion odd:QC2 ;
    odd:modelingRationale
        "Foi modelado como classe para individualizar o identificador de verificacao e distingui-lo da plataforma de consulta e da assinatura."@pt ;
    skos:example
        "Codigo textual usado por um usuario para consultar publicamente a autenticidade de um diploma digital."@pt .

odd:HistoricoEscolarDigital
    a owl:Class ;
    rdfs:label
        "Histórico Escolar Digital"@pt ,
        "Digital Academic Transcript"@en ;
    rdfs:comment
        "Registro digital da trajetória acadêmica do diplomado, utilizado como suporte informacional ao diploma digital."@pt ,
        "Digital record of the graduate academic trajectory used as informational support for the digital diploma."@en ;
    rdfs:subClassOf prov:Entity , schema:DigitalDocument ;
    skos:prefLabel
        "histórico escolar digital"@pt ,
        "digital academic transcript"@en ;
    skos:altLabel
        "histórico acadêmico digital"@pt ;
    skos:definition
        "Documento digital que registra a trajetória acadêmica do estudante e subsidia a emissão ou validação do diploma digital."@pt ,
        "Digital document that records the student's academic trajectory and supports the issuance or validation of the digital diploma."@en ;
    skos:scopeNote
        "Use esta classe para o documento historico escolar digital vinculado ao ecossistema do diploma. Nao use para representar o diploma em si nem o conjunto documental agregado de odd:DocumentacaoAcademica."@pt ,
        "Use this class for the digital academic transcript document linked to the diploma ecosystem. Do not use it to represent the diploma itself or the aggregated documentary set of odd:DocumentacaoAcademica."@en ;
    odd:sourceNote
        "Classe derivada do leiaute do Historico Escolar Digital e integrada ao modelo como documento de apoio informacional ao diploma digital."@pt ;
    odd:modelingRationale
        "Foi modelado como classe propria para representar um documento distinto do diploma, com funcao especifica de comprovar a trajetoria academica."@pt ;
    skos:example
        "Historico escolar digital anexado ou relacionado ao diploma para demonstrar disciplinas, carga horaria e trajetoria academica do concluinte."@pt .

odd:DocumentacaoAcademica
    a owl:Class ;
    rdfs:label
        "Documentação Acadêmica"@pt ,
        "Academic Documentation"@en ;
    rdfs:comment
        "Pacote documental acadêmico usado na emissão e no registro do diploma digital, reunindo evidências acadêmicas e, no TTL atual, servindo também como ponto de acesso semântico ao termo de responsabilidade da emissora."@pt ,
        "Academic documentary package used in the issuance and registration of the digital diploma, gathering academic evidence and, in the current TTL, also serving as a semantic access point to the issuing HEI responsibility statement."@en ;
    rdfs:subClassOf prov:Collection ;
    skos:prefLabel
        "documentação acadêmica"@pt ,
        "academic documentation"@en ;
    skos:altLabel
        "documentação comprobatória"@pt ;
    skos:definition
        "Conjunto ou pacote documental que reúne evidências acadêmicas e elementos documentais associados ao processo de emissão e registro do diploma digital."@pt ,
        "Documentary set or package that gathers academic evidence and documentary elements associated with the process of issuing and registering the digital diploma."@en ;
    skos:scopeNote
        "No TTL atual, esta classe funciona como aproximação controlada da documentação acadêmica submetida para registro. Ela não individualiza separadamente o elemento raiz DocumentacaoAcademicaRegistro e não deve ser lida como equivalência literal apenas a DocumentacaoComprobatoria do XSD."@pt ,
        "In the current TTL, this class works as a controlled approximation of the academic documentation submitted for registration. It does not separately individualize the DocumentacaoAcademicaRegistro root element and should not be read as a literal equivalence only to the XSD DocumentacaoComprobatoria."@en ;
    odd:sourceNote
        "A classe agrega semanticamente a documentação acadêmica de apoio ao registro a partir dos XSDs de leiaute de documentação acadêmica e do documento-raiz DocumentacaoAcademicaRegistro."@pt ;
    odd:modelingRationale
        "Foi modelada como colecao documental para representar o pacote enviado a registradora sem criar, nesta versao, uma classe separada para o envelope XML."@pt ;
    skos:example
        "O conjunto documental submetido para registro contendo evidencias academicas e, no TTL atual, o ponto de acesso semantico ao termo de responsabilidade da emissora."@pt .

odd:RequisicaoDocumentacaoAcademica
    a owl:Class ;
    rdfs:label
        "Requisição de Documentação Acadêmica"@pt ,
        "Academic Documentation Request"@en ;
    rdfs:comment
        "Recurso que representa a requisição identificada no registro e que referencia a documentação acadêmica correspondente."@pt ,
        "Resource representing the request identified in the registration and referring to the corresponding academic documentation."@en ;
    rdfs:subClassOf prov:Entity ;
    skos:definition
        "Requisição administrativa individualizada pelo identificador IdDocumentacaoAcademica do XSD e relacionada ao ato de registro do diploma."@pt ,
        "Administrative request individualized by the XSD IdDocumentacaoAcademica identifier and related to the diploma registration act."@en ;
    skos:scopeNote
        "Use para identificar a requisição, não o pacote documental odd:DocumentacaoAcademica nem o próprio registro do diploma."@pt ,
        "Use to identify the request, not the odd:DocumentacaoAcademica package or the diploma registration itself."@en ;
    odd:sourceNote
        "Derivada de TDadosRegistro/IdDocumentacaoAcademica, cujo valor segue o padrão ReqDip acrescido de 44 dígitos."@pt ;
    odd:modelingRationale
        "A promoção a recurso próprio permite aplicar odd:identifier, e consequentemente dcterms:identifier, ao sujeito que é efetivamente identificado."@pt .

odd:ProcessoAdministrativo
    a owl:Class ;
    rdfs:label
        "Processo Administrativo do Diploma"@pt ,
        "Diploma Administrative Process"@en ;
    rdfs:comment
        "Processo administrativo associado ao registro ou à expedição do diploma digital."@pt ,
        "Administrative process associated with the registration or issuance of the digital diploma."@en ;
    rdfs:subClassOf prov:Entity ;
    skos:definition
        "Recurso administrativo individualizado pelo número ProcessoDoDiploma informado no livro de registro."@pt ,
        "Administrative resource individualized by the ProcessoDoDiploma number recorded in the registry book."@en ;
    skos:scopeNote
        "Use para o processo administrativo relacionado ao registro; não use seu número como identificador do próprio odd:RegistroDiploma."@pt ,
        "Use for the administrative process related to the registration; do not use its number as the identifier of odd:RegistroDiploma itself."@en ;
    odd:sourceNote
        "Derivada de TDadosRegistro/LivroRegistro/ProcessoDoDiploma, do tipo TCodProcessoDoDiploma."@pt ;
    odd:modelingRationale
        "A promoção a recurso próprio separa a identidade do processo da identidade do ato de registro e permite seu alinhamento correto com dcterms:identifier."@pt .

odd:AgenteCertificador
    a owl:Class ;
    rdfs:label
        "Agente Certificador"@pt ,
        "Certifying Agent"@en ;
    rdfs:comment
        "Agente organizacional de natureza técnica, associado complementarmente à cadeia de confiança criptográfica da assinatura digital, sem representar por si só os atores administrativos de emissão ou registro do diploma."@pt ,
        "Technical organizational agent complementarily associated with the cryptographic trust chain of the digital signature, not by itself representing the administrative actors of diploma issuance or registration."@en ;
    rdfs:subClassOf prov:Organization ;
    skos:prefLabel
        "agente certificador"@pt ,
        "certifying agent"@en ;
    skos:altLabel
        "entidade certificadora"@pt ,
        "certificador técnico da assinatura"@pt ;
    skos:definition
        "Organização modelada apenas como apoio semântico opcional para representar elementos técnicos da cadeia certificadora, da infraestrutura X.509 ou da confiança criptográfica associada à assinatura digital."@pt ,
        "Organization modeled only as optional semantic support to represent technical elements of the certification chain, X.509 infrastructure, or cryptographic trust associated with the digital signature."@en ;
    skos:scopeNote
        "Não use esta classe para representar IES emissora, IES registradora, responsável pelo registro, assinante da emissão ou signatário do termo de responsabilidade. Esses papéis pertencem ao núcleo acadêmico-regulatório e devem ser modelados por classes próprias."@pt ,
        "Do not use this class to represent issuing HEI, registering HEI, registration responsible person, issuance signer, or issuance responsibility statement signer. Those roles belong to the academic-regulatory core and must be modeled by dedicated classes."@en ;
    skos:example
        "Elemento organizacional inferido da cadeia certificadora ou do certificado digital associado a ds:Signature."@pt ,
        "Organizational element inferred from the certification chain or digital certificate associated with ds:Signature."@en ;
    odd:sourceNote
        "Classe mantida no TTL apenas como extensao tecnica complementar, inspirada na camada XMLDSig/X.509 e nao como papel literal explicitamente nomeado no XSD do fluxo academico-regulatorio."@pt ;
    odd:modelingRationale
        "Seu uso foi mantido no plano tecnico para representar a cadeia de confianca da assinatura sem confundir esse papel com atores institucionais ou administrativos."@pt .

odd:PlataformaGoverno
    a owl:Class ;
    rdfs:label
        "Plataforma Governamental"@pt ,
        "Government Platform"@en ;
    rdfs:comment
        "Plataforma digital do governo capaz de consumir dados interoperáveis do diploma digital, como o Gov.br."@pt ,
        "Government digital platform able to consume interoperable digital diploma data, such as Gov.br."@en ;
    rdfs:subClassOf prov:SoftwareAgent ;
    skos:prefLabel
        "plataforma governamental"@pt ,
        "government platform"@en ;
    skos:definition
        "Plataforma digital governamental capaz de consultar, validar ou interoperar com dados do diploma digital."@pt ,
        "Government digital platform capable of consulting, validating or interoperating with digital diploma data."@en ;
    skos:scopeNote
        "Use esta classe para plataformas governamentais consumidoras ou intermediadoras de dados interoperaveis do diploma digital. Nao use para representar a IES, o codigo de validacao ou o portal interno da propria instituicao."@pt ,
        "Use this class for government platforms that consume or intermediate interoperable digital diploma data. Do not use it to represent the HEI, the validation code, or the institution own internal portal."@en ;
    odd:sourceNote
        "Classe introduzida como apoio ao cenario de interoperabilidade e acesso externo ao diploma digital, especialmente para responder a questoes de competencia sobre plataformas governamentais como Gov.br."@pt ;
    odd:modelingRationale
        "Foi modelada como classe para explicitar o ponto de consumo governamental do grafo e distingui-lo de documentos, codigos e instituicoes."@pt ;
    skos:example
        "Gov.br consumindo ou exibindo dados interoperaveis de um diploma digital validado."@pt ;
    odd:competencyQuestion odd:QC7 .

odd:ValorControlado
    a owl:Class ;
    rdfs:label
        "valor controlado"@pt ,
        "controlled value"@en ;
    rdfs:comment
        "Classe auxiliar local usada para organizar, no plano operacional do TTL, valores controlados modelados como conceitos SKOS reutilizáveis."@pt ,
        "Local auxiliary class used to organize, at the operational TTL level, controlled values modeled as reusable SKOS concepts."@en ;
    rdfs:subClassOf skos:Concept ;
    skos:definition
        "Classe abstrata local que agrupa conceitos SKOS usados como valores controlados em propriedades da ontologia, sem substituir os conceitos concretos do vocabulário."@pt ,
        "Local abstract class that groups SKOS concepts used as controlled values in ontology properties, without replacing the concrete concepts of the vocabulary."@en ;
    skos:scopeNote
        "Use esta classe apenas como superclasse abstrata local para categorias conceituais controladas. Ela serve para organizar operacionalmente os conceitos SKOS usados como valores em propriedades. Nao use esta classe para modelar documentos, agentes, instituicoes, individuos factuais da ABox ou como valor final de uma propriedade."@pt ,
        "Use this class only as a local abstract superclass for controlled conceptual categories. It serves to operationally organize SKOS concepts used as property values. Do not use this class to model documents, agents, institutions, factual ABox individuals, or as the final value of a property."@en ;
    odd:sourceNote
        "Classe introduzida no TTL para organizar semanticamente, em camada local de apoio, os valores controlados derivados de enumeracoes do leiaute e de decisoes de modelagem do vocabulario operacional."@pt ;
    odd:modelingRationale
        "Foi modelada como classe abstrata local para tipar de modo uniforme categorias auxiliares que organizam conceitos SKOS no uso operacional da ontologia. O valor efetivamente consumido nas propriedades continua sendo um skos:Concept identificado por URI propria."@pt ;
    skos:example
        "As classes ConceitoGrauConferido, ConceitoFormatoAssinatura e ConceitoPapelAssinatura sao subclasses de ValorControlado."@pt .

odd:ConceitoGrauConferido
    a owl:Class ;
    rdfs:label
        "conceito de grau conferido"@pt ,
        "degree type concept"@en ;
    rdfs:comment
        "Classe categorial auxiliar local usada para organizar os valores controlados que qualificam o grau acadêmico associado ao curso no contexto do diploma digital."@pt ,
        "Local auxiliary categorical class used to organize the controlled values that qualify the academic degree associated with the program in the context of the digital diploma."@en ;
    rdfs:subClassOf odd:ValorControlado ;
    skos:definition
        "Categoria de valor controlado que representa o tipo de grau acadêmico conferido pelo curso."@pt ,
        "Controlled value category that represents the type of academic degree awarded by the program."@en ;
    skos:scopeNote
        "Use esta classe para tipar a categoria auxiliar local que organiza conceitos como Bacharelado, Licenciatura, Tecnologia e CursoSequencial. Nao use a propria classe como valor final de um diploma; o valor final deve ser o conceito SKOS concreto correspondente."@pt ,
        "Use this class to type the local auxiliary category that organizes concepts such as Bacharelado, Licenciatura, Tecnologia, and CursoSequencial. Do not use the class itself as the final value of a diploma; the final value must be the corresponding concrete SKOS concept."@en ;
    odd:sourceNote
        "Categoria criada para agrupar, em SKOS, os graus gerais previstos no leiaute e reutilizados como valores controlados da ontologia operacional."@pt ;
    odd:modelingRationale
        "Foi modelada como subclasse de odd:ValorControlado para separar, no plano operacional local, a categoria de grau dos conceitos SKOS concretos usados nas propriedades."@pt ;
    skos:example
        "Bacharelado, Licenciatura, Tecnologia e CursoSequencial."@pt .

odd:ConceitoTituloConferido
    a owl:Class ;
    rdfs:label
        "conceito de título conferido"@pt ,
        "awarded title concept"@en ;
    rdfs:comment
        "Classe categorial auxiliar local usada para organizar os valores controlados que expressam a denominação geral atribuída ao diplomado."@pt ,
        "Local auxiliary categorical class used to organize the controlled values that express the general title assigned to the graduate."@en ;
    rdfs:subClassOf odd:ValorControlado ;
    skos:definition
        "Categoria de valor controlado que representa o título geral conferido ao diplomado."@pt ,
        "Controlled value category that represents the general title awarded to the graduate."@en ;
    skos:scopeNote
        "Use esta classe para tipar a categoria auxiliar local que organiza titulos gerais como Bacharel, Licenciado, Tecnologo e Medico. Nao use a classe para representar o curso especifico, o nome completo da titulacao institucional ou o valor final da propriedade; para isso, use o conceito SKOS concreto."@pt ,
        "Use this class to type the local auxiliary category that organizes general titles such as Bacharel, Licenciado, Tecnologo, and Medico. Do not use the class to represent the specific program, the full institutional title name, or the final property value; use the concrete SKOS concept for that."@en ;
    odd:sourceNote
        "Categoria criada para organizar em SKOS os titulos gerais reutilizaveis previstos no leiaute do diploma digital."@pt ;
    odd:modelingRationale
        "Foi modelada como subclasse de odd:ValorControlado para separar, no plano operacional local, a categoria de titulo dos conceitos SKOS concretos usados nas propriedades."@pt ;
    skos:example
        "Bacharel, Licenciado, Tecnologo e Medico."@pt .

odd:ConceitoModalidadeOferta
    a owl:Class ;
    rdfs:label
        "conceito de modalidade de oferta"@pt ,
        "mode of delivery concept"@en ;
    rdfs:comment
        "Classe categorial auxiliar local usada para agrupar os valores controlados que descrevem o regime institucional de oferta do curso."@pt ,
        "Local auxiliary categorical class used to group the controlled values that describe the institutional mode of delivery of the program."@en ;
    rdfs:subClassOf odd:ValorControlado ;
    skos:definition
        "Categoria de valor controlado que representa a modalidade institucional de oferta do curso."@pt ,
        "Controlled value category that represents the institutional mode of delivery of the program."@en ;
    skos:scopeNote
        "Use esta classe para tipar a categoria auxiliar local que organiza modalidades como Presencial e Semipresencial. Nao use para representar o curso inteiro, sua infraestrutura fisica ou o valor final da propriedade; para isso, use o conceito SKOS concreto."@pt ,
        "Use this class to type the local auxiliary category that organizes modalities such as Presencial and Semipresencial. Do not use it to represent the whole program, its physical infrastructure, or the final property value; use the concrete SKOS concept instead."@en ;
    odd:sourceNote
        "Categoria criada para organizar em SKOS as modalidades de oferta reutilizadas como valores controlados no modelo do diploma digital."@pt ;
    odd:modelingRationale
        "Foi modelada como subclasse de odd:ValorControlado para separar, no plano operacional local, a categoria de modalidade dos conceitos SKOS concretos usados nas propriedades."@pt ;
    skos:example
        "Presencial e Semipresencial."@pt .

odd:ConceitoSituacaoDiploma
    a owl:Class ;
    rdfs:label
        "conceito de situação do diploma"@pt ,
        "diploma status concept"@en ;
    rdfs:comment
        "Classe categorial auxiliar local usada para organizar os valores controlados que indicam o estado administrativo ou jurídico do diploma digital."@pt ,
        "Local auxiliary categorical class used to organize the controlled values that indicate the administrative or legal status of the digital diploma."@en ;
    rdfs:subClassOf odd:ValorControlado ;
    skos:definition
        "Categoria de valor controlado que representa a situação administrativa ou jurídica do diploma digital."@pt ,
        "Controlled value category that represents the administrative or legal status of the digital diploma."@en ;
    skos:scopeNote
        "Use esta classe para tipar a categoria auxiliar local que organiza estados administrativos do diploma, como Ativo, Anulado e Revogado. Nao use para representar o diploma, o ato juridico completo que levou a cada situacao ou o valor final da propriedade; para isso, use o conceito SKOS concreto."@pt ,
        "Use this class to type the local auxiliary category that organizes administrative diploma states such as Ativo, Anulado, and Revogado. Do not use it to represent the diploma, the complete legal act that led to each status, or the final property value; use the concrete SKOS concept for that."@en ;
    odd:sourceNote
        "Categoria consolidada no TTL para representar estados administrativos e juridicos relevantes ao ciclo de vida do diploma digital."@pt ;
    odd:modelingRationale
        "Foi modelada como subclasse de odd:ValorControlado para separar, no plano operacional local, a categoria de situacao dos conceitos SKOS concretos usados nas propriedades."@pt ;
    skos:example
        "Ativo, Anulado e Revogado."@pt .

odd:ConceitoAmbienteOperacional
    a owl:Class ;
    rdfs:label
        "conceito de ambiente operacional"@pt ,
        "operational environment concept"@en ;
    rdfs:comment
        "Categoria local para conceitos SKOS que representam o ambiente operacional declarado no diploma digital."@pt ,
        "Local category for SKOS concepts representing the operational environment declared in the digital diploma."@en ;
    rdfs:subClassOf odd:ValorControlado ;
    skos:definition
        "Categoria de valor controlado cujos membros representam o ambiente operacional declarado para a emissão do diploma digital."@pt ,
        "Controlled value category whose members represent the operational environment declared for digital diploma issuance."@en ;
    skos:scopeNote
        "Use para os valores controlados produção e homologação definidos pelo tipo TAmb do XSD."@pt ,
        "Use for the controlled production and testing values defined by the XSD TAmb type."@en ;
    odd:sourceNote
        "Derivada do atributo ambiente de TInfDiploma, tipado por TAmb no XSD, cujos valores controlados distinguem Produção e Homologação."@pt ;
    odd:modelingRationale
        "Substitui o literal livre de odd:environment por conceitos identificados por IRI, sem confundir ambiente operacional com dcterms:type."@pt ;
    skos:example
        "Produção e Homologação."@pt .

odd:ConceitoFormatoAssinatura
    a owl:Class ;
    rdfs:label
        "conceito de formato de assinatura"@pt ,
        "signature format concept"@en ;
    rdfs:comment
        "Classe categorial auxiliar local usada para organizar os valores controlados que identificam o perfil técnico ou padrão criptográfico da assinatura digital."@pt ,
        "Local auxiliary categorical class used to organize the controlled values that identify the technical profile or cryptographic standard of the digital signature."@en ;
    rdfs:subClassOf odd:ValorControlado ;
    skos:definition
        "Categoria de valor controlado que representa o formato técnico da assinatura digital."@pt ,
        "Controlled value category that represents the technical format of the digital signature."@en ;
    skos:scopeNote
        "Use esta classe para tipar a categoria auxiliar local que organiza formatos como XAdES, CAdES e PAdES. Nao use a classe para representar a assinatura digital individual, o certificado associado ou o valor final da propriedade; para isso, use o conceito SKOS concreto."@pt ,
        "Use this class to type the local auxiliary category that organizes formats such as XAdES, CAdES, and PAdES. Do not use the class to represent the individual digital signature, the associated certificate, or the final property value; use the concrete SKOS concept instead."@en ;
    odd:sourceNote
        "Categoria criada para organizar, em SKOS, formatos tecnicos de assinatura derivados da camada de assinatura digital e de seus padroes complementares."@pt ;
    odd:modelingRationale
        "Foi modelada como subclasse de odd:ValorControlado para separar, no plano operacional local, a categoria de formato dos conceitos SKOS concretos usados nas propriedades."@pt ;
    skos:example
        "XAdES, CAdES e PAdES."@pt .

odd:ConceitoPapelAssinatura
    a owl:Class ;
    rdfs:label
        "conceito de papel da assinatura"@pt ,
        "signature role concept"@en ;
    rdfs:comment
        "Classe categorial auxiliar local usada para organizar os valores controlados que distinguem a função semântico-administrativa exercida por cada assinatura digital no processo do diploma."@pt ,
        "Local auxiliary categorical class used to organize the controlled values that distinguish the semantic-administrative function performed by each digital signature in the diploma process."@en ;
    rdfs:subClassOf odd:ValorControlado ;
    skos:definition
        "Categoria de valor controlado que representa o papel semântico-administrativo exercido por uma assinatura digital no processo do diploma."@pt ,
        "Controlled value category that represents the semantic-administrative role performed by a digital signature in the diploma process."@en ;
    skos:scopeNote
        "Use esta classe para tipar a categoria auxiliar local que organiza papeis como AssinaturaPFEmissora, AssinaturaPJEmissora, AssinaturaPFResponsavelRegistro e AssinaturaPJRegistradora. Nao use para representar o agente humano, a instituicao, a assinatura digital individual ou o valor final da propriedade; para isso, use o conceito SKOS concreto."@pt ,
        "Use this class to type the local auxiliary category that organizes roles such as AssinaturaPFEmissora, AssinaturaPJEmissora, AssinaturaPFResponsavelRegistro, and AssinaturaPJRegistradora. Do not use it to represent the human agent, the institution, the individual digital signature, or the final property value; use the concrete SKOS concept instead."@en ;
    odd:sourceNote
        "Categoria criada no TTL por leitura integrada dos papeis institucionais e pessoais de assinatura no processo de emissao, registro e arquivamento documental."@pt ;
    odd:modelingRationale
        "Foi modelada como subclasse de odd:ValorControlado para separar, no plano operacional local, a categoria de papel dos conceitos SKOS concretos usados nas propriedades."@pt ;
    skos:example
        "AssinaturaPFEmissora, AssinaturaPJEmissora, AssinaturaPFResponsavelRegistro e AssinaturaPJRegistradora."@pt .

#################################################################
# Object properties
#################################################################

# Propriedades de objeto ligam um recurso a outro recurso.
# Exemplo: um DiplomaDigital tem titular Diplomado, emitido por IesEmissora
# e pode ter endereço, curso, registro, assinatura e código de validação.
# Explicação didática: servem para criar ligações entre coisas, como ligar um diploma
# à pessoa que recebeu esse diploma.

# rdfs:domain indica o tipo esperado do recurso de onde a propriedade parte.
# Exemplo: se odd:hasHolder tem rdfs:domain odd:DiplomaDigital, a relação começa em um DiplomaDigital.
# Explicação didática: informa qual tipo de coisa pode usar aquela relação.
#
# rdfs:range indica o tipo esperado do objeto de uma propriedade.
# Exemplo: se odd:hasHolder tem rdfs:range odd:Diplomado, então o valor apontado por essa relação
# deve ser interpretado como um Diplomado.
# Explicação didática: informa que tipo de coisa deve aparecer do outro lado da relação.
#
# rdfs:subPropertyOf declara que uma propriedade local especializa uma propriedade mais ampla.
# Exemplo: odd:issuedBy é uma forma específica de prov:wasAttributedTo no contexto do diploma.
# Explicação didática: reaproveita vocabulários conhecidos sem perder o significado específico
# criado para esta ontologia.
#
# owl:FunctionalProperty indica que a propriedade deve ter, no máximo, um valor para cada sujeito.
# Exemplo: um diploma deve ter uma IES emissora principal.
# Explicação didática: evita que a mesma informação principal seja preenchida com vários valores.
#
# owl:inverseOf declara que duas propriedades expressam a mesma relação em sentidos opostos.
# Exemplo: odd:hasHolder liga DiplomaDigital -> Diplomado, enquanto odd:holdsDiploma liga Diplomado -> DiplomaDigital.
# Explicação didática: é como dizer a mesma relação de ida e volta.
# Se o diploma "tem titular" Renan, então Renan tem a relação inversa "titular de" com esse diploma.

odd:hasControlledValue
    a owl:ObjectProperty ;
    rdfs:label
        "tem valor controlado"@pt ,
        "has controlled value"@en ;
    rdfs:comment
        "Propriedade abstrata que agrupa relações cujo objeto deve ser um conceito SKOS pertencente a vocabulário controlado."@pt ,
        "Abstract property grouping relations whose object must be a SKOS concept belonging to a controlled vocabulary."@en ;
    rdfs:range odd:ValorControlado ;
    odd:controlledByScheme vocab:EsquemaValoresControladosDiploma ;
    odd:modelingRationale
        "Foi criada para agrupar propriedades cujo objeto deve ser um valor controlado SKOS, distinguindo-as das relacoes entre entidades do dominio."@pt ;
    skos:scopeNote
        "Não usar diretamente nos dados. Use suas subpropriedades específicas, como awardsDegree, awardsTitle, hasModeOfDelivery, hasStatus, hasEnvironment e hasSignatureFormat."@pt .

odd:hasEnvironment
    a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label
        "tem ambiente operacional"@pt ,
        "has operational environment"@en ;
    rdfs:comment
        "Relaciona o diploma digital ao conceito controlado que representa seu ambiente operacional."@pt ,
        "Relates the digital diploma to the controlled concept representing its operational environment."@en ;
    rdfs:domain odd:DiplomaDigital ;
    rdfs:range odd:ConceitoAmbienteOperacional ;
    rdfs:subPropertyOf odd:hasControlledValue ;
    dcterms:source odd:FonteXsdLeiauteDiplomaDigital , odd:FonteXsdTiposBasicos ;
    odd:xsdPath "TInfDiploma/@ambiente" ;
    odd:xsdElement "@ambiente" ;
    odd:xsdType "TAmb" ;
    odd:controlledByScheme vocab:EsquemaValoresControladosDiploma ;
    odd:modelingRationale
        "O objeto é um conceito SKOS identificado por IRI, evitando confundir ambiente operacional com a natureza documental expressa por dcterms:type."@pt .

odd:hasRelatedObjective
    a owl:ObjectProperty ;
    rdfs:label
        "tem objetivo relacionado"@pt ,
        "has related objective"@en ;
    rdfs:comment
        "Relaciona uma questão de competência ao objetivo específico da pesquisa que ela operacionaliza ou valida."@pt ,
        "Relates a competency question to the specific research objective that it operationalizes or validates."@en ;
    rdfs:domain odd:QuestaoCompetencia ;
    rdfs:range odd:ObjetivoEspecifico ;
    odd:modelingRationale
        "Foi criada para registrar a rastreabilidade entre questoes de competencia e objetivos especificos da pesquisa."@pt .

odd:hasHolder
    a owl:ObjectProperty ;
    rdfs:label
        "tem titular"@pt ,
        "has holder"@en ;
    rdfs:comment
        "Relaciona o diploma digital ao diplomado que dele é titular."@pt ,
        "Relates the digital diploma to the graduate who holds it."@en ;
    rdfs:domain odd:DiplomaDigital ;
    rdfs:range odd:Diplomado ;
    owl:inverseOf odd:holdsDiploma ;
    odd:sourceNote
        "A relação deriva da associação entre o bloco Diplomado e o documento Diploma nos XSDs Diploma Digital_v1.05 e Leiaute Diploma Digital v1.05."@pt ;
    skos:scopeNote
        "Propriedade usada para explicitar a relação entre o documento diploma e a pessoa titular."@pt .

odd:holdsDiploma
    a owl:ObjectProperty ;
    rdfs:label
        "titular de"@pt ,
        "holds diploma"@en ;
    rdfs:comment
        "Relaciona o diplomado ao diploma digital do qual é titular."@pt ,
        "Relates the graduate to the digital diploma he or she holds."@en ;
    rdfs:domain odd:Diplomado ;
    rdfs:range odd:DiplomaDigital .

odd:hasBirthPlace
    a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label
        "tem local de naturalidade"@pt ,
        "has birthplace"@en ;
    rdfs:comment
        "Relaciona o diplomado ao local de nascimento informado no elemento Naturalidade do XSD."@pt ,
        "Relates the graduate to the birthplace reported in the Naturalidade element of the XSD."@en ;
    rdfs:domain odd:Diplomado ;
    rdfs:range odd:LocalNaturalidade ;
    rdfs:subPropertyOf dbo:birthPlace ;
    dcterms:source odd:FonteXsdLeiauteDiplomaDigital , odd:FonteXsdTiposBasicos , odd:FonteXsdNormalizado ;
    odd:xsdPath
        "TDadosDiplomado/Naturalidade" ,
        "TDadosDiplomadoPorDecisaoJudicial/Naturalidade" ;
    odd:xsdElement "Naturalidade" ;
    odd:xsdType "TNaturalidade" ;
    odd:sourceNote
        "A propriedade é funcional porque cada bloco de dados do diplomado admite no máximo um elemento Naturalidade. Não foi imposta cardinalidade mínima em OWL, pois o ramo por decisão judicial permite Naturalidade_Indisponivel."@pt ;
    odd:modelingRationale
        "A propriedade local preserva a terminologia e a rastreabilidade do XSD, enquanto rdfs:subPropertyOf dbo:birthPlace permite consultas interoperáveis com a DBpedia Ontology sem afirmar equivalência integral."@pt ;
    skos:scopeNote
        "O objeto deve ser um recurso odd:LocalNaturalidade. Não preencher esta propriedade com texto literal e não criar um local fictício para representar Naturalidade_Indisponivel."@pt .

odd:issuedBy
    a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label
        "emitido por"@pt ,
        "issued by"@en ;
    rdfs:comment
        "Relaciona o diploma digital à instituição que exerce o papel de emissora. Essa relação identifica a função de emissão e não exige, por si só, que a instituição seja distinta daquela que exerce o papel de registradora."@pt ,
        "Relates the digital diploma to the institution that performs the issuing role. This relation identifies the issuing function and does not, by itself, require the institution to be different from the one performing the registering role."@en ;
    rdfs:domain odd:DiplomaDigital ;
    rdfs:range odd:IesEmissora ;
    rdfs:subPropertyOf prov:wasAttributedTo ;
    owl:inverseOf odd:issuesDiploma .

odd:issuesDiploma
    a owl:ObjectProperty ;
    rdfs:label
        "emite diploma"@pt ,
        "issues diploma"@en ;
    rdfs:comment
        "Relaciona a IES emissora ao diploma digital emitido."@pt ,
        "Relates the issuing HEI to the digital diploma it issues."@en ;
    rdfs:domain odd:IesEmissora ;
    rdfs:range odd:DiplomaDigital .

odd:registeredBy
    a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label
        "registrado por"@pt ,
        "registered by"@en ;
    rdfs:comment
        "Relaciona o diploma digital à instituição que exerce o papel de registradora. Essa relação identifica a função de registro e não exige, por si só, que a instituição seja distinta daquela que exerce o papel de emissora."@pt ,
        "Relates the digital diploma to the institution that performs the registering role. This relation identifies the registering function and does not, by itself, require the institution to be different from the one performing the issuing role."@en ;
    rdfs:domain odd:DiplomaDigital ;
    rdfs:range odd:IesRegistradora ;
    owl:inverseOf odd:registersDiploma .

odd:registersDiploma
    a owl:ObjectProperty ;
    rdfs:label
        "registra diploma"@pt ,
        "registers diploma"@en ;
    rdfs:comment
        "Relaciona a IES registradora ao diploma digital que ela registra."@pt ,
        "Relates the registering HEI to the digital diploma it registers."@en ;
    rdfs:domain odd:IesRegistradora ;
    rdfs:range odd:DiplomaDigital .

odd:hasProgram
    a owl:ObjectProperty ;
    rdfs:label
        "tem curso"@pt ,
        "has program"@en ;
    rdfs:comment
        "Relaciona o diploma digital ao curso concluído pelo diplomado."@pt ,
        "Relates the digital diploma to the program completed by the graduate."@en ;
    rdfs:domain odd:DiplomaDigital ;
    rdfs:range odd:Curso ;
    owl:inverseOf odd:isProgramOfDiploma .

odd:isProgramOfDiploma
    a owl:ObjectProperty ;
    rdfs:label
        "vinculado ao diploma"@pt ,
        "is program of diploma"@en ;
    rdfs:comment
        "Relaciona o curso ao diploma digital ao qual está vinculado."@pt ,
        "Relates the program to the digital diploma to which it is linked."@en ;
    rdfs:domain odd:Curso ;
    rdfs:range odd:DiplomaDigital .

odd:completedBy
    a owl:ObjectProperty ;
    rdfs:label
        "concluído por"@pt ,
        "completed by"@en ;
    rdfs:comment
        "Relaciona o curso ao diplomado que o concluiu."@pt ,
        "Relates the academic program to the graduate who completed it."@en ;
    rdfs:domain odd:Curso ;
    rdfs:range odd:Diplomado ;
    owl:inverseOf odd:completedProgram .

odd:completedProgram
    a owl:ObjectProperty ;
    rdfs:label
        "concluiu curso"@pt ,
        "completed program"@en ;
    rdfs:comment
        "Relaciona o diplomado ao curso concluído."@pt ,
        "Relates the graduate to the completed academic program."@en ;
    rdfs:domain odd:Diplomado ;
    rdfs:range odd:Curso .

odd:hasRegistration
    a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label
        "tem registro"@pt ,
        "has registration"@en ;
    rdfs:comment
        "Relaciona o diploma digital ao seu ato formal de registro."@pt ,
        "Relates the digital diploma to its formal registration act."@en ;
    rdfs:domain odd:DiplomaDigital ;
    rdfs:range odd:RegistroDiploma ;
    owl:inverseOf odd:isRegistrationOf .

odd:isRegistrationOf
    a owl:ObjectProperty ;
    rdfs:label
        "registro de"@pt ,
        "is registration of"@en ;
    rdfs:comment
        "Relaciona o registro formal ao diploma digital correspondente."@pt ,
        "Relates the formal registration to the corresponding digital diploma."@en ;
    rdfs:domain odd:RegistroDiploma ;
    rdfs:range odd:DiplomaDigital .

odd:hasAcademicDocumentationRequest
    a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label
        "tem requisição de documentação acadêmica"@pt ,
        "has academic documentation request"@en ;
    rdfs:comment
        "Relaciona o registro do diploma à requisição de documentação acadêmica identificada no XSD."@pt ,
        "Relates the diploma registration to the academic documentation request identified in the XSD."@en ;
    rdfs:domain odd:RegistroDiploma ;
    rdfs:range odd:RequisicaoDocumentacaoAcademica ;
    owl:inverseOf odd:isAcademicDocumentationRequestOf ;
    dcterms:source odd:FonteXsdLeiauteDiplomaDigital , odd:FonteXsdLeiauteDocumentacaoAcademicaRegistro ;
    odd:xsdPath "TDadosRegistro/IdDocumentacaoAcademica" ;
    odd:xsdElement "IdDocumentacaoAcademica" ;
    odd:modelingRationale
        "A relação promove a requisição a recurso próprio para que seu identificador descreva o sujeito correto."@pt .

odd:isAcademicDocumentationRequestOf
    a owl:ObjectProperty ;
    rdfs:label
        "é requisição de documentação acadêmica de"@pt ,
        "is academic documentation request of"@en ;
    rdfs:domain odd:RequisicaoDocumentacaoAcademica ;
    rdfs:range odd:RegistroDiploma .

odd:hasAdministrativeProcess
    a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label
        "tem processo administrativo"@pt ,
        "has administrative process"@en ;
    rdfs:comment
        "Relaciona o registro do diploma ao processo administrativo associado ao registro ou à expedição."@pt ,
        "Relates the diploma registration to the administrative process associated with registration or issuance."@en ;
    rdfs:domain odd:RegistroDiploma ;
    rdfs:range odd:ProcessoAdministrativo ;
    owl:inverseOf odd:isAdministrativeProcessOf ;
    dcterms:source odd:FonteXsdLeiauteDiplomaDigital , odd:FonteXsdTiposBasicos ;
    odd:xsdPath "TDadosRegistro/LivroRegistro/ProcessoDoDiploma" ;
    odd:xsdElement "ProcessoDoDiploma" ;
    odd:modelingRationale
        "A relação separa a identidade do processo administrativo da identidade do registro do diploma."@pt .

odd:isAdministrativeProcessOf
    a owl:ObjectProperty ;
    rdfs:label
        "é processo administrativo de"@pt ,
        "is administrative process of"@en ;
    rdfs:domain odd:ProcessoAdministrativo ;
    rdfs:range odd:RegistroDiploma .

odd:hasRegistrationResponsible
    a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label
        "tem responsável pelo registro"@pt ,
        "has registration responsible person"@en ;
    rdfs:comment
        "Relaciona o registro do diploma à pessoa responsável indicada no bloco ResponsavelRegistro do XSD."@pt ,
        "Relates the diploma registration to the responsible person indicated in the XSD ResponsavelRegistro block."@en ;
    rdfs:domain odd:RegistroDiploma ;
    rdfs:range odd:ResponsavelRegistro ;
    rdfs:subPropertyOf prov:wasAssociatedWith ;
    owl:inverseOf odd:isRegistrationResponsibleOf ;
    dcterms:source odd:FonteXsdLeiauteDiplomaDigital ;
    odd:xsdPath "TDadosRegistro/LivroRegistro/ResponsavelRegistro" ;
    odd:xsdElement "ResponsavelRegistro" ;
    odd:modelingRationale
        "prov:wasAssociatedWith foi adotada porque odd:RegistroDiploma representa uma prov:Activity e a pessoa responsável é um prov:Agent associado à atividade de registro."@pt .

odd:isRegistrationResponsibleOf
    a owl:ObjectProperty ;
    rdfs:label
        "responsável pelo registro de"@pt ,
        "is registration responsible of"@en ;
    rdfs:comment
        "Relaciona a pessoa responsável ao registro do diploma correspondente."@pt ,
        "Relates the responsible person to the corresponding diploma registration."@en ;
    rdfs:domain odd:ResponsavelRegistro ;
    rdfs:range odd:RegistroDiploma .

odd:hasRegistrationSigner
    a owl:ObjectProperty ;
    rdfs:label
        "assinado administrativamente por"@pt ,
        "has registration signer"@en ;
    rdfs:comment
        "Relaciona o registro do diploma ao assinante administrativo indicado no bloco Assinantes."@pt ,
        "Relates the diploma registration to the administrative signer indicated in the Assinantes block."@en ;
    rdfs:domain odd:RegistroDiploma ;
    rdfs:range odd:AssinanteRegistro ;
    rdfs:subPropertyOf prov:wasAssociatedWith ;
    owl:inverseOf odd:isRegistrationSignerOf ;
    dcterms:source odd:FonteXsdLeiauteDiplomaDigital ;
    odd:xsdPath "TDadosRegistro/Assinantes/Assinante" ;
    odd:xsdElement "Assinantes" , "Assinante" ;
    odd:xsdType "TInfoAssinantes" ;
    odd:modelingRationale
        "Foi criada separadamente de odd:hasSignature para distinguir o agente administrativo informado no XML da assinatura criptografica. prov:wasAssociatedWith foi adotada porque o registro representa uma prov:Activity e o assinante administrativo é um prov:Agent associado a essa atividade."@pt .

odd:isRegistrationSignerOf
    a owl:ObjectProperty ;
    rdfs:label
        "assina administrativamente"@pt ,
        "is registration signer of"@en ;
    rdfs:comment
        "Relaciona o assinante administrativo ao registro do diploma correspondente."@pt ,
        "Relates the administrative signer to the corresponding diploma registration."@en ;
    rdfs:domain odd:AssinanteRegistro ;
    rdfs:range odd:RegistroDiploma .

odd:hasIssuanceSigner
    a owl:ObjectProperty ;
    rdfs:label
        "tem assinante da emissão"@pt ,
        "has issuance signer"@en ;
    rdfs:comment
        "Relaciona o diploma digital ao assinante administrativo indicado no bloco Assinantes da emissão."@pt ,
        "Relates the digital diploma to the administrative signer indicated in the issuance Assinantes block."@en ;
    rdfs:domain odd:DiplomaDigital ;
    rdfs:range odd:AssinanteEmissao ;
    owl:inverseOf odd:isIssuanceSignerOf ;
    dcterms:source odd:FonteXsdLeiauteDiplomaDigital ;
    odd:xsdPath
        "TDadosDiploma/Assinantes/Assinante" ,
        "TDadosDiplomaNSF/Assinantes/Assinante" ,
        "TDadosDiplomaPorDecisaoJudicial/Assinantes/Assinante" ;
    odd:xsdElement "Assinantes" , "Assinante" ;
    odd:xsdType "TInfoAssinantes" ;
    odd:modelingRationale
        "Foi criada separadamente de odd:hasSignature para distinguir o agente administrativo informado no XML da assinatura criptografica."@pt .

odd:isIssuanceSignerOf
    a owl:ObjectProperty ;
    rdfs:label
        "é assinante da emissão de"@pt ,
        "is issuance signer of"@en ;
    rdfs:comment
        "Relaciona o assinante administrativo da emissão ao diploma digital correspondente."@pt ,
        "Relates the administrative issuance signer to the corresponding digital diploma."@en ;
    rdfs:domain odd:AssinanteEmissao ;
    rdfs:range odd:DiplomaDigital .

odd:hasIssuanceResponsibilitySigner
    a owl:ObjectProperty ;
    rdfs:label
        "tem signatário do termo de responsabilidade da emissora"@pt ,
        "has issuance responsibility statement signer"@en ;
    rdfs:comment
        "Relaciona a documentação acadêmica ao agente humano identificado no termo de responsabilidade da IES emissora associado ao pacote documental usado no registro do diploma."@pt ,
        "Relates the academic documentation to the human agent identified in the issuing HEI responsibility statement associated with the documentary package used in diploma registration."@en ;
    rdfs:domain odd:DocumentacaoAcademica ;
    rdfs:range odd:SignatarioTermoResponsabilidadeEmissora ;
    owl:inverseOf odd:isIssuanceResponsibilitySignerOf ;
    dcterms:source odd:FonteXsdLeiauteDocumentacaoAcademicaRegistro , odd:FonteXsdDocumentacaoAcademicaRegistro ;
    odd:xsdPath
        "TRegistroReq/TermoResponsabilidadeEmissora" ,
        "TRegistroReqNSF/TermoResponsabilidadeEmissora" ,
        "TRegistroPorDecisaoJudicialReq/TermoResponsabilidadeEmissora" ,
        "TRegistroSegundaViaReq/TermoResponsabilidadeEmissora" ;
    odd:xsdElement "TermoResponsabilidadeEmissora" ;
    odd:xsdType "TTermoResponsabilidade" ;
    odd:sourceNote
        "No XSD, TermoResponsabilidadeEmissora é irmão de DocumentacaoComprobatoria dentro da requisição de registro. Esta propriedade usa DocumentacaoAcademica como ponto de acesso semântico controlado porque o TTL atual ainda não individualiza a classe do envelope DocumentacaoAcademicaRegistro."@pt ;
    odd:modelingRationale
        "Foi ancorada em odd:DocumentacaoAcademica para viabilizar consulta e instancia operacional sem confundir o signatario do termo com a IES emissora, o assinante da emissao ou a assinatura digital."@pt .

odd:isIssuanceResponsibilitySignerOf
    a owl:ObjectProperty ;
    rdfs:label
        "é signatário do termo de responsabilidade de"@pt ,
        "is issuance responsibility statement signer of"@en ;
    rdfs:comment
        "Relaciona o signatário do termo de responsabilidade da emissora à documentação acadêmica correspondente."@pt ,
        "Relates the issuance responsibility statement signer to the corresponding academic documentation."@en ;
    rdfs:domain odd:SignatarioTermoResponsabilidadeEmissora ;
    rdfs:range odd:DocumentacaoAcademica .

odd:hasSignature
    a owl:ObjectProperty ;
    rdfs:label
        "tem assinatura"@pt ,
        "has signature"@en ;
    rdfs:comment
        "Relaciona o diploma digital à assinatura digital associada."@pt ,
        "Relates the digital diploma to the associated digital signature."@en ;
    rdfs:domain odd:DiplomaDigital ;
    rdfs:range odd:AssinaturaDigital ;
    owl:inverseOf odd:isSignatureOf .

odd:isSignatureOf
    a owl:ObjectProperty ;
    rdfs:label
        "assinatura de"@pt ,
        "is signature of"@en ;
    rdfs:comment
        "Relaciona a assinatura digital ao diploma digital correspondente."@pt ,
        "Relates the digital signature to the corresponding digital diploma."@en ;
    rdfs:domain odd:AssinaturaDigital ;
    rdfs:range odd:DiplomaDigital .

odd:hasTimestamp
    a owl:ObjectProperty ;
    rdfs:label
        "tem carimbo de tempo"@pt ,
        "has timestamp"@en ;
    rdfs:comment
        "Relaciona a assinatura digital ao carimbo de tempo associado."@pt ,
        "Relates the digital signature to the associated timestamp."@en ;
    rdfs:domain odd:AssinaturaDigital ;
    rdfs:range odd:CarimboTempo ;
    owl:inverseOf odd:isTimestampOf .

odd:isTimestampOf
    a owl:ObjectProperty ;
    rdfs:label
        "carimbo de tempo de"@pt ,
        "is timestamp of"@en ;
    rdfs:comment
        "Relaciona o carimbo de tempo à assinatura digital correspondente."@pt ,
        "Relates the timestamp to the corresponding digital signature."@en ;
    rdfs:domain odd:CarimboTempo ;
    rdfs:range odd:AssinaturaDigital .

odd:hasValidationCode
    a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label
        "tem código de validação"@pt ,
        "has validation code"@en ;
    rdfs:comment
        "Relaciona o diploma digital ao código de validação utilizado na consulta pública."@pt ,
        "Relates the digital diploma to the validation code used in public verification."@en ;
    rdfs:domain odd:DiplomaDigital ;
    rdfs:range odd:CodigoValidacao ;
    owl:inverseOf odd:validatesDiploma .

odd:validatesDiploma
    a owl:ObjectProperty ;
    rdfs:label
        "valida diploma"@pt ,
        "validates diploma"@en ;
    rdfs:comment
        "Relaciona o código de validação ao diploma digital que ele permite verificar."@pt ,
        "Relates the validation code to the digital diploma it allows to verify."@en ;
    rdfs:domain odd:CodigoValidacao ;
    rdfs:range odd:DiplomaDigital .

odd:hasTranscript
    a owl:ObjectProperty ;
    rdfs:label
        "tem histórico"@pt ,
        "has transcript"@en ;
    rdfs:comment
        "Relaciona o diploma digital ao histórico escolar digital do diplomado."@pt ,
        "Relates the digital diploma to the graduate's digital academic transcript."@en ;
    rdfs:domain odd:DiplomaDigital ;
    rdfs:range odd:HistoricoEscolarDigital .

odd:hasAcademicDocumentation
    a owl:ObjectProperty ;
    rdfs:label
        "tem documentação acadêmica"@pt ,
        "has academic documentation"@en ;
    rdfs:comment
        "Relaciona o diploma digital ao conjunto de documentos acadêmicos que o fundamentam."@pt ,
        "Relates the digital diploma to the set of academic documents that ground it."@en ;
    rdfs:domain odd:DiplomaDigital ;
    rdfs:range odd:DocumentacaoAcademica .

odd:awardsDegree
    a owl:ObjectProperty ;
    rdfs:label
        "confere grau"@pt ,
        "awards degree"@en ;
    rdfs:comment
        "Relaciona o curso ao conceito SKOS que representa o grau conferido ao diplomado."@pt ,
        "Relates the program to the SKOS concept that represents the degree type awarded to the graduate."@en ;
    rdfs:domain odd:Curso ;
    rdfs:range odd:ConceitoGrauConferido ;
    rdfs:subPropertyOf odd:hasControlledValue ;
    odd:controlledByScheme vocab:EsquemaValoresControladosDiploma ;
    odd:controlledConceptCategory vocab:CategoriaGrauConferido ;
    odd:competencyQuestion odd:QC5 ;
    dcterms:source odd:FonteXsdLeiauteDiplomaDigital , odd:FonteXsdTiposBasicos ;
    odd:xsdPath "TDadosCurso/GrauConferido" ;
    odd:xsdElement "GrauConferido" ;
    odd:xsdType "TGrauConferido" ;
    odd:sourceNote
        "Rastreabilidade XSD declarada por dcterms:source, odd:xsdPath, odd:xsdElement e odd:xsdType."@pt ;
    odd:modelingRationale
        "Foi modelada como propriedade de valor controlado porque o grau conferido e uma categoria geral e reutilizavel entre cursos."@pt .

odd:awardsTitle
    a owl:ObjectProperty ;
    rdfs:label
        "confere título"@pt ,
        "awards title"@en ;
    rdfs:comment
        "Relaciona o curso ao conceito SKOS que representa o título conferido ao diplomado."@pt ,
        "Relates the program to the SKOS concept that represents the title awarded to the graduate."@en ;
    rdfs:domain odd:Curso ;
    rdfs:range odd:ConceitoTituloConferido ;
    rdfs:subPropertyOf odd:hasControlledValue ;
    odd:controlledByScheme vocab:EsquemaValoresControladosDiploma ;
    odd:controlledConceptCategory vocab:CategoriaTituloConferido ;
    odd:competencyQuestion odd:QC5 ;
    dcterms:source odd:FonteXsdLeiauteDiplomaDigital , odd:FonteXsdTiposBasicos ;
    odd:xsdPath "TDadosCurso/TituloConferido" ;
    odd:xsdElement "TituloConferido" ;
    odd:xsdType "TTituloConferido" ;
    odd:sourceNote
        "Rastreabilidade XSD declarada por dcterms:source, odd:xsdPath, odd:xsdElement e odd:xsdType."@pt ;
    odd:modelingRationale
        "Foi modelada para apontar apenas titulos gerais controlados do nucleo; titulacoes especificas de curso permanecem fora do vocabulario nuclear."@pt .

odd:hasQualification
    a owl:ObjectProperty ;
    rdfs:label
        "tem habilitação"@pt ,
        "has qualification track"@en ;
    rdfs:comment
        "Relaciona o curso às habilitações específicas registradas no leiaute do diploma."@pt ,
        "Relates the academic program to the specific qualification tracks recorded in the diploma layout."@en ;
    rdfs:domain odd:Curso ;
    rdfs:range odd:Habilitacao ;
    owl:inverseOf odd:isQualificationOf .

odd:isQualificationOf
    a owl:ObjectProperty ;
    rdfs:label
        "habilitação de"@pt ,
        "is qualification of"@en ;
    rdfs:comment
        "Relaciona a habilitação ao curso ao qual está associada."@pt ,
        "Relates the qualification track to the academic program with which it is associated."@en ;
    rdfs:domain odd:Habilitacao ;
    rdfs:range odd:Curso .

odd:hasEmecProcessingInfo
    a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label
        "tem informações de tramitação e-MEC"@pt ,
        "has e-MEC processing information"@en ;
    rdfs:comment
        "Relaciona o curso à estrutura usada quando não há código e-MEC disponível, mas há informação de tramitação processual."@pt ,
        "Relates the academic program to the structure used when no e-MEC code is available but processing information exists."@en ;
    rdfs:domain odd:Curso ;
    rdfs:range odd:InformacoesTramitacaoEmec ;
    dcterms:source odd:FonteXsdLeiauteDiplomaDigital ;
    odd:xsdPath "TDadosCurso/SemCodigoCursoEMEC" ;
    odd:xsdElement "SemCodigoCursoEMEC" ;
    odd:xsdType "TInformacoesTramitacaoEMEC" .

odd:hasModeOfDelivery
    a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label
        "tem modalidade de oferta"@pt ,
        "has mode of delivery"@en ;
    rdfs:comment
        "Relaciona o curso ao conceito SKOS que representa sua modalidade de oferta."@pt ,
        "Relates the program to the SKOS concept representing its mode of delivery."@en ;
    rdfs:domain odd:Curso ;
    rdfs:range odd:ConceitoModalidadeOferta ;
    rdfs:subPropertyOf odd:hasControlledValue ;
    odd:controlledByScheme vocab:EsquemaValoresControladosDiploma ;
    odd:controlledConceptCategory vocab:CategoriaModalidadeOferta ;
    odd:competencyQuestion odd:QC5 ;
    dcterms:source odd:FonteXsdLeiauteDiplomaDigital , odd:FonteXsdTiposBasicos ;
    odd:xsdPath "TDadosCurso/Modalidade" ;
    odd:xsdElement "Modalidade" ;
    odd:xsdType "TModalidadeCurso" , "TModalidadeCursoNSF" ;
    odd:sourceNote
        "Rastreabilidade XSD declarada por dcterms:source, odd:xsdPath, odd:xsdElement e odd:xsdType."@pt .

odd:hasStatus
    a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label
        "tem situação"@pt ,
        "has status"@en ;
    rdfs:comment
        "Relaciona o diploma digital ao conceito SKOS que representa sua situação administrativa ou jurídica."@pt ,
        "Relates the digital diploma to the SKOS concept representing its administrative or legal status."@en ;
    rdfs:domain odd:DiplomaDigital ;
    rdfs:range odd:ConceitoSituacaoDiploma ;
    rdfs:subPropertyOf odd:hasControlledValue ;
    odd:controlledByScheme vocab:EsquemaValoresControladosDiploma ;
    odd:controlledConceptCategory vocab:CategoriaSituacaoDiploma ;
    odd:competencyQuestion odd:QC5 ;
    odd:modelingRationale
        "Foi mantida como propriedade de vocabulario controlado para representar a situacao administrativa do diploma sem depender apenas do leiaute principal."@pt .

odd:hasSignatureFormat
    a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label
        "tem formato de assinatura"@pt ,
        "has signature format"@en ;
    rdfs:comment
        "Relaciona a assinatura digital ao conceito SKOS que representa seu formato técnico."@pt ,
        "Relates the digital signature to the SKOS concept representing its technical format."@en ;
    rdfs:domain odd:AssinaturaDigital ;
    rdfs:range odd:ConceitoFormatoAssinatura ;
    rdfs:subPropertyOf odd:hasControlledValue ;
    odd:controlledByScheme vocab:EsquemaValoresControladosDiploma ;
    odd:controlledConceptCategory vocab:CategoriaFormatoAssinatura ;
    odd:competencyQuestion odd:QC5 ;
    dcterms:source odd:FonteXsdXmlDsigCore , odd:FonteXsdLeiauteDiplomaDigital ;
    odd:xsdElement "ds:Signature" ;
    odd:xsdType "SignatureType" ;
    odd:sourceNote
        "Rastreabilidade XSD declarada por dcterms:source, odd:xsdElement e odd:xsdType."@pt ;
    odd:modelingRationale
        "Foi modelada como valor controlado para apoiar interoperabilidade tecnica sem substituir a validacao criptografica do XMLDSig."@pt .

odd:hasSignatureRole
    a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label
        "tem papel da assinatura"@pt ,
        "has signature role"@en ;
    rdfs:comment
        "Relaciona a assinatura digital ao conceito SKOS que representa seu papel semântico-administrativo no fluxo do diploma."@pt ,
        "Relates the digital signature to the SKOS concept representing its semantic-administrative role in the diploma workflow."@en ;
    rdfs:domain odd:AssinaturaDigital ;
    rdfs:range odd:ConceitoPapelAssinatura ;
    rdfs:subPropertyOf odd:hasControlledValue ;
    odd:controlledByScheme vocab:EsquemaValoresControladosDiploma ;
    odd:controlledConceptCategory vocab:CategoriaPapelAssinatura ;
    odd:competencyQuestion odd:QC5 ;
    odd:sourceNote
        "Propriedade introduzida como extensao semantica controlada para distinguir o papel administrativo-regulatorio da assinatura de seu formato tecnico, a partir da leitura integrada da IN 05, dos XSDs e da separacao PF/PJ adotada nesta ontologia."@pt ;
    odd:modelingRationale
        "Foi modelada separadamente do formato para distinguir papel administrativo, agente e camada criptografica da assinatura."@pt .

odd:institutionallySignedBy
    a owl:ObjectProperty ;
    rdfs:label
        "assinado institucionalmente por"@pt ,
        "institutionally signed by"@en ;
    rdfs:comment
        "Relaciona a assinatura digital à instituição de ensino superior que a chancela institucionalmente como pessoa jurídica."@pt ,
        "Relates the digital signature to the higher education institution that institutionally endorses it as a legal entity."@en ;
    rdfs:domain odd:AssinaturaDigital ;
    rdfs:range odd:InstituicaoEnsinoSuperior ;
    rdfs:subPropertyOf prov:wasAttributedTo ;
    owl:inverseOf odd:institutionallySigns ;
    odd:sourceNote
        "Extensao semantica criada para representar o reconhecimento institucional PJ associado a certas assinaturas do fluxo do diploma, conforme leitura integrada da IN 05 com os papeis administrativos explicitados no XSD."@pt ;
    odd:modelingRationale
        "Foi criada para representar a chancela institucional da assinatura. A distincao entre emissora e registradora depende da tipagem da instituicao e de odd:hasSignatureRole."@pt .

odd:institutionallySigns
    a owl:ObjectProperty ;
    rdfs:label
        "assina institucionalmente"@pt ,
        "institutionally signs"@en ;
    rdfs:comment
        "Relaciona a instituição de ensino superior à assinatura digital que ela chancela institucionalmente."@pt ,
        "Relates the higher education institution to the digital signature that it institutionally endorses."@en ;
    rdfs:domain odd:InstituicaoEnsinoSuperior ;
    rdfs:range odd:AssinaturaDigital ;
    odd:sourceNote
        "Na aplicacao concreta, o sujeito desta propriedade deve estar tipado como odd:IesEmissora ou odd:IesRegistradora, conforme o papel semantico da assinatura."@pt .

odd:certifiedBy
    a owl:ObjectProperty ;
    rdfs:label
        "tem certificador técnico"@pt ,
        "has technical certifier"@en ;
    rdfs:comment
        "Relaciona a assinatura digital a um agente certificador apenas quando se deseja explicitar, de forma complementar, a cadeia técnica de confiança ou certificação da assinatura."@pt ,
        "Relates the digital signature to a certifying agent only when one wishes to explicitly represent, as a complement, the technical trust or certification chain of the signature."@en ;
    rdfs:domain odd:AssinaturaDigital ;
    rdfs:range odd:AgenteCertificador ;
    owl:inverseOf odd:certifiesSignature ;
    odd:sourceNote
        "Propriedade mantida como relacao tecnica opcional. Ela nao representa a responsabilidade administrativa da emissora nem da registradora."@pt ;
    odd:modelingRationale
        "Foi mantida como relacao tecnica opcional para explicitar o certificador da assinatura sem usá-la para papeis institucionais ou administrativos."@pt .

odd:certifiesSignature
    a owl:ObjectProperty ;
    rdfs:label
        "certifica tecnicamente assinatura"@pt ,
        "technically certifies signature"@en ;
    rdfs:comment
        "Relaciona o agente certificador à assinatura digital somente no plano técnico complementar da cadeia de confiança."@pt ,
        "Relates the certifying agent to the digital signature only in the complementary technical layer of the trust chain."@en ;
    rdfs:domain odd:AgenteCertificador ;
    rdfs:range odd:AssinaturaDigital ;
    odd:sourceNote
        "Inversa de odd:certifiedBy, preservada por compatibilidade semantica, mas rebaixada ao plano tecnico residual do modelo."@pt .

odd:isAccessibleVia
    a owl:ObjectProperty ;
    rdfs:label
        "acessível via"@pt ,
        "is accessible via"@en ;
    rdfs:comment
        "Relaciona o diploma digital à plataforma governamental por meio da qual pode ser consultado interoperavelmente."@pt ,
        "Relates the digital diploma to the government platform through which it can be consulted interoperably."@en ;
    rdfs:domain odd:DiplomaDigital ;
    rdfs:range odd:PlataformaGoverno ;
    odd:competencyQuestion odd:QC7 .

odd:hasAddress
    a owl:ObjectProperty ;
    rdfs:label
        "tem endereço"@pt ,
        "has address"@en ;
    rdfs:comment
        "Relaciona instituição de ensino superior ou curso ao endereço postal correspondente."@pt ,
        "Relates a higher education institution or academic program to its corresponding postal address."@en ;
    rdfs:range odd:Endereco ;
    rdfs:subPropertyOf locn:address , vcard:hasAddress ;
    dcterms:source odd:FonteXsdLeiauteDiplomaDigital ;
    odd:xsdElement "Endereco" , "EnderecoCurso" ;
    odd:xsdType "TEndereco" ;
    odd:modelingRationale
        "O dominio foi mantido amplo para permitir uso com odd:InstituicaoEnsinoSuperior e odd:Curso sem criar uma uniao OWL especifica."@pt .

#################################################################
# Datatype properties
#################################################################

# Propriedades de dados ligam um recurso a valores literais,
# como texto, data, número, código, CPF, CNPJ, CEP ou nome de curso.
# Explicação didática: são campos de informação, como preencher o CPF, a data de registro
# ou o nome do curso.

odd:courseAddressUnavailable
    a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label
        "endereço do curso indisponível"@pt ,
        "program address unavailable"@en ;
    rdfs:comment
        "Materializa a declaração expressa de que o endereço do curso está indisponível no ramo por decisão judicial."@pt ,
        "Materializes the explicit declaration that the academic program address is unavailable in the court-decision branch."@en ;
    rdfs:domain odd:CursoPorDecisaoJudicial ;
    rdfs:range xsd:boolean ;
    dcterms:source odd:FonteXsdLeiauteDiplomaDigital ;
    odd:xsdElement "EnderecoCurso_Indisponivel" ;
    odd:xsdType "TVazio" ;
    odd:xsdPath "TDadosCursoPorDecisaoJudicial/EnderecoCurso_Indisponivel" ;
    odd:sourceNote
        "O elemento vazio do XSD é representado operacionalmente pelo literal true. O valor false não substitui EnderecoCurso e não deve ser materializado como alternativa válida."@pt ;
    odd:modelingRationale
        "A propriedade booleana evita criar um endereço fictício para representar ausência e permite que o SHACL valide a escolha exclusiva entre endereço e indisponibilidade."@pt .

odd:identifier
    a owl:DatatypeProperty ;
    rdfs:label
        "identificador"@pt ,
        "identifier"@en ;
    rdfs:comment
        "Identificador textual único atribuído a um recurso."@pt ,
        "Unique textual identifier assigned to a resource."@en ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf dcterms:identifier , schema:identifier ;
    dcterms:source odd:FonteXsdLeiauteDiplomaDigital ;
    odd:xsdElement "@id" ;
    odd:xsdPath "TInfDiploma/@id" ;
    odd:sourceNote
        "Abstração dos atributos id tipados nos XSDs do MEC. O alinhamento com dcterms:identifier e schema:identifier foi mantido como subPropertyOf."@pt .

odd:version
    a owl:DatatypeProperty ;
    rdfs:label
        "versão"@pt ,
        "version"@en ;
    rdfs:comment
        "Versão do diploma digital ou de um recurso relacionado."@pt ,
        "Version of the digital diploma or a related resource."@en ;
    rdfs:domain odd:DiplomaDigital ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf dcat:version ;
    dcterms:source odd:FonteXsdLeiauteDiplomaDigital , odd:FonteXsdTiposBasicos ;
    odd:xsdPath "TInfDiploma/@versao" ;
    odd:xsdElement "@versao" ;
    odd:xsdType "TVersao" ;
    odd:modelingRationale
        "dcat:version foi mantida porque representa um indicador literal de versão. dcterms:hasVersion foi removida porque relaciona o recurso descrito a outro recurso que constitui uma versão, não a um literal como 1.05."@pt ;
    odd:sourceNote
        "Rastreabilidade XSD declarada por dcterms:source, odd:xsdPath, odd:xsdElement e odd:xsdType."@pt .

odd:environment
    a owl:DatatypeProperty ;
    owl:deprecated "true"^^xsd:boolean ;
    rdfs:label
        "ambiente"@pt ,
        "environment"@en ;
    rdfs:comment
        "Ambiente do recurso, como produção ou homologação."@pt ,
        "Resource environment, such as production or testing."@en ;
    rdfs:domain odd:DiplomaDigital ;
    rdfs:range xsd:string ;
    dcterms:source odd:FonteXsdLeiauteDiplomaDigital , odd:FonteXsdTiposBasicos ;
    odd:xsdPath "TInfDiploma/@ambiente" ;
    odd:xsdElement "@ambiente" ;
    odd:xsdType "TAmb" ;
    odd:modelingRationale
        "Propriedade legada preservada para compatibilidade. Foi substituída por odd:hasEnvironment com conceitos SKOS porque produção e homologação são ambientes operacionais, não a natureza ou o gênero do diploma."@pt ;
    odd:sourceNote
        "Rastreabilidade XSD declarada por dcterms:source, odd:xsdPath, odd:xsdElement e odd:xsdType."@pt .

odd:fullName
    a owl:DatatypeProperty ;
    rdfs:label
        "nome completo"@pt ,
        "full name"@en ;
    rdfs:comment
        "Nome completo de uma pessoa ou instituição."@pt ,
        "Full name of a person or institution."@en ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf foaf:name , schema:name ;
    odd:sourceNote
        "Generaliza elementos nominais do leiaute oficial, como Nome e RazaoSocial. O alinhamento com foaf:name e schema:name foi mantido como especialização, não equivalência."@pt .

odd:nationality
    a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label
        "nacionalidade"@pt ,
        "nationality"@en ;
    rdfs:comment
        "Nacionalidade declarada para o diplomado no elemento Nacionalidade do XSD do Diploma Digital."@pt ,
        "Nationality declared for the graduate in the Nacionalidade element of the Digital Diploma XSD."@en ;
    rdfs:domain odd:Diplomado ;
    rdfs:range xsd:string ;
    dcterms:source odd:FonteXsdLeiauteDiplomaDigital , odd:FonteXsdTiposBasicos , odd:FonteXsdNormalizado ;
    odd:xsdPath
        "TDadosDiplomado/Nacionalidade" ,
        "TDadosDiplomadoPorDecisaoJudicial/Nacionalidade" ;
    odd:xsdElement "Nacionalidade" ;
    odd:xsdType "TNacionalidade" ;
    odd:sourceNote
        "TNacionalidade é um tipo simples derivado de TString, com comprimento entre 1 e 255 caracteres. No ramo por decisão judicial, Nacionalidade pode ser substituída por Nacionalidade_Indisponivel."@pt ;
    odd:modelingRationale
        "A nacionalidade foi mantida como literal para preservar a correspondência direta com o tipo simples TNacionalidade. Ela não deve ser inferida a partir do município de naturalidade."@pt ;
    skos:scopeNote
        "Preencher com a nacionalidade declarada no documento de origem. Não usar este campo para município, país de endereço ou local de naturalidade e não criar valor fictício para Nacionalidade_Indisponivel."@pt .

odd:cpf
    a owl:DatatypeProperty ;
    rdfs:label
        "CPF"@pt ,
        "CPF"@en ;
    rdfs:comment
        "Cadastro de Pessoa Física do diplomado."@pt ,
        "Brazilian individual taxpayer registry number of the graduate."@en ;
    rdfs:domain odd:Diplomado ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf dcterms:identifier , schema:identifier .

odd:ibgeMunicipalityCode
    a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label
        "código IBGE do município de naturalidade"@pt ,
        "IBGE birthplace municipality code"@en ;
    rdfs:comment
        "Código de sete dígitos do município brasileiro de naturalidade conforme a tabela do IBGE."@pt ,
        "Seven-digit code of the Brazilian birthplace municipality according to the IBGE table."@en ;
    rdfs:domain odd:LocalNaturalidade ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf dcterms:identifier , schema:identifier ;
    dcterms:source odd:FonteXsdTiposBasicos , odd:FonteXsdNormalizado ;
    odd:xsdPath "TNaturalidade/GMunicipio/CodigoMunicipio" ;
    odd:xsdElement "CodigoMunicipio" ;
    odd:xsdType "TCodMunIBGE" ;
    odd:sourceNote
        "TCodMunIBGE restringe o valor ao padrão de sete algarismos. O campo não integra a alternativa estrangeira de GMunicipio."@pt .

odd:birthMunicipalityName
    a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label
        "nome do município brasileiro de naturalidade"@pt ,
        "Brazilian birthplace municipality name"@en ;
    rdfs:comment
        "Nome do município brasileiro informado na naturalidade do diplomado."@pt ,
        "Name of the Brazilian municipality reported as the graduate's birthplace."@en ;
    rdfs:domain odd:LocalNaturalidade ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf schema:name ;
    dcterms:source odd:FonteXsdTiposBasicos , odd:FonteXsdNormalizado ;
    odd:xsdPath "TNaturalidade/GMunicipio/NomeMunicipio" ;
    odd:xsdElement "NomeMunicipio" ;
    odd:xsdType "TNomeMun" .

odd:birthFederativeUnitCode
    a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label
        "UF do município de naturalidade"@pt ,
        "birthplace federative unit code"@en ;
    rdfs:comment
        "Sigla da unidade federativa do município brasileiro de naturalidade."@pt ,
        "Federative unit abbreviation of the Brazilian birthplace municipality."@en ;
    rdfs:domain odd:LocalNaturalidade ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf locn:adminUnitL2 , vcard:region ;
    dcterms:source odd:FonteXsdTiposBasicos , odd:FonteXsdNormalizado ;
    odd:xsdPath "TNaturalidade/GMunicipio/UF" ;
    odd:xsdElement "UF" ;
    odd:xsdType "TUf" ;
    odd:modelingRationale
        "locn:adminUnitL2 foi adotada porque a UF representa estado ou região administrativa secundária; locn:adminUnitL1 foi removida porque corresponde ao nível superior, quase sempre o país."@pt .

odd:foreignBirthMunicipalityName
    a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label
        "nome do município estrangeiro de naturalidade"@pt ,
        "foreign birthplace municipality name"@en ;
    rdfs:comment
        "Nome do município estrangeiro informado na naturalidade do diplomado quando não se aplica a identificação municipal brasileira."@pt ,
        "Name of the foreign municipality reported as the graduate's birthplace when Brazilian municipality identification does not apply."@en ;
    rdfs:domain odd:LocalNaturalidade ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf schema:name ;
    dcterms:source odd:FonteXsdTiposBasicos , odd:FonteXsdNormalizado ;
    odd:xsdPath "TNaturalidade/GMunicipio/NomeMunicipioEstrangeiro" ;
    odd:xsdElement "NomeMunicipioEstrangeiro" ;
    odd:xsdType "TNomeMun" ;
    odd:sourceNote
        "Na alternativa estrangeira, GMunicipio fornece apenas NomeMunicipioEstrangeiro; o XSD não autoriza inferir código IBGE, UF ou país a partir desse campo."@pt .

odd:conclusionDate
    a owl:DatatypeProperty ;
    rdfs:label
        "data de conclusão"@pt ,
        "conclusion date"@en ;
