odd:diplomaExpeditionDate
    a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label
        "data de expedição do diploma"@pt ,
        "diploma expedition date"@en ;
    rdfs:comment
        "Data de expedição do diploma registrada no livro de registro."@pt ,
