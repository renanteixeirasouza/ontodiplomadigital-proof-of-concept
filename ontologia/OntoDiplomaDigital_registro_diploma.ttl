odd:emecProcessType
    a owl:DatatypeProperty ;
    rdfs:label
        "tipo do processo e-MEC"@pt ,
        "e-MEC process type"@en ;
    rdfs:comment
        "Tipo textual do processo de tramitação e-MEC associado ao curso."@pt ,
        "Textual type of the e-MEC processing procedure associated with the academic program."@en ;
    rdfs:domain odd:InformacoesTramitacaoEmec ;
    rdfs:range xsd:string ;
    dcterms:source odd:FonteXsdLeiauteDiplomaDigital , odd:FonteXsdTiposBasicos ;
    odd:xsdPath "TInformacoesTramitacaoEMEC/TipoProcesso" ;
