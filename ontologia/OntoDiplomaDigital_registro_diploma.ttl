    dcterms:source odd:FonteXsdLeiauteDocumentacaoAcademicaRegistro , odd:FonteXsdTiposBasicos ;
    odd:xsdPath
        "TRegistroReq/TermoResponsabilidadeEmissora/Cargo" ,
        "TRegistroReqNSF/TermoResponsabilidadeEmissora/Cargo" ,
        "TRegistroPorDecisaoJudicialReq/TermoResponsabilidadeEmissora/Cargo" ,
        "TRegistroSegundaViaReq/TermoResponsabilidadeEmissora/Cargo" ;
    odd:xsdElement "Cargo" ;
    odd:xsdType "TString" ;
    odd:modelingRationale
        "vcard:role foi adotada porque a propriedade local registra diretamente, como texto, a função desempenhada pela pessoa. schema:roleName foi removida porque se aplica a um recurso schema:Role."@pt .

odd:issuanceResponsibilitySignerDesignationAct
    a owl:DatatypeProperty ;
    rdfs:label
        "ato de designação do signatário do termo de responsabilidade da emissora"@pt ,
        "issuance responsibility statement signer designation act"@en ;
    rdfs:comment
        "Representação literal do PDF/A opcional que comprova o ato de designação da pessoa identificada no termo de responsabilidade da IES emissora."@pt ,
        "Literal representation of the optional PDF/A that proves the act of designation of the person identified in the issuing HEI responsibility statement."@en ;
    rdfs:domain odd:SignatarioTermoResponsabilidadeEmissora ;
    rdfs:range xsd:string ;
    dcterms:source odd:FonteXsdLeiauteDocumentacaoAcademicaRegistro , odd:FonteXsdTiposBasicos ;
    odd:xsdPath
        "TRegistroReq/TermoResponsabilidadeEmissora/AtoDesignacao" ,
        "TRegistroReqNSF/TermoResponsabilidadeEmissora/AtoDesignacao" ,
        "TRegistroPorDecisaoJudicialReq/TermoResponsabilidadeEmissora/AtoDesignacao" ,
        "TRegistroSegundaViaReq/TermoResponsabilidadeEmissora/AtoDesignacao" ;
    odd:xsdElement "AtoDesignacao" ;
    odd:xsdType "TPdfA" ;
    odd:sourceNote
        "Mantida como literal nesta etapa para preservar a rastreabilidade ao XSD sem ainda promover o PDF/A a recurso documental próprio."@pt .

odd:signatureDateTime
    a owl:DatatypeProperty ;
    rdfs:label
        "data e hora da assinatura"@pt ,
        "signature date and time"@en ;
    rdfs:comment
        "Data e hora em que a assinatura digital foi aplicada."@pt ,
        "Date and time at which the digital signature was applied."@en ;
    rdfs:domain odd:AssinaturaDigital ;
    rdfs:range xsd:dateTime ;
    rdfs:subPropertyOf dcterms:date ;
    odd:modelingRationale
        "dcterms:date foi adotada porque o valor representa um instante associado ao ciclo de vida da assinatura digital que ocupa a posição de sujeito."@pt .

odd:timestampDateTime
    a owl:DatatypeProperty ;
    rdfs:label
        "data e hora do carimbo de tempo"@pt ,
        "timestamp date and time"@en ;
    rdfs:comment
        "Data e hora registradas pelo carimbo de tempo."@pt ,
        "Date and time recorded by the timestamp."@en ;
    rdfs:domain odd:CarimboTempo ;
    rdfs:range xsd:dateTime ;
    rdfs:subPropertyOf dcterms:date ;
    odd:modelingRationale
        "dcterms:date foi adotada porque o valor representa um instante associado ao ciclo de vida do carimbo de tempo que ocupa a posição de sujeito."@pt .

odd:validationCodeValue
    a owl:DatatypeProperty ;
    rdfs:label
        "valor do código de validação"@pt ,
        "validation code value"@en ;
    rdfs:comment
        "Valor textual do código de validação do diploma digital."@pt ,
        "Textual value of the digital diploma validation code."@en ;
