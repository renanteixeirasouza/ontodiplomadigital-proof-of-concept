    odd:xsdType "TString" .

odd:emecRegistrationDate
    a owl:DatatypeProperty ;
    rdfs:label
        "data de cadastro e-MEC"@pt ,
        "e-MEC registration date"@en ;
    rdfs:comment
        "Data de cadastro do processo e-MEC associada ao curso."@pt ,
        "Registration date of the e-MEC process associated with the academic program."@en ;
    rdfs:domain odd:InformacoesTramitacaoEmec ;
    rdfs:range xsd:date ;
    rdfs:subPropertyOf dcterms:date ;
