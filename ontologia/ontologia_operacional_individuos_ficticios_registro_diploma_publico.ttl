@prefix ont: <https://w3id.org/ufes/ontodiplomadigital#> .
@prefix vocab: <https://w3id.org/ufes/ontodiplomadigital#> .
@prefix rec: <https://w3id.org/ufes/ontodiplomadigital/instancias-ficticias#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

<https://w3id.org/ufes/ontodiplomadigital/instancias-ficticias/1.0>
    a owl:Ontology ;
    dcterms:title "OntoDiplomaDigital - individuos ficticios de exemplo"@pt ;
    dcterms:description "Extensao ABox derivada do TTL canonico de leiaute_miro para demonstrar a ontologia operacional com individuos e dados ficticios."@pt ;
    dcterms:created "2026-06-17"^^xsd:date ;
    dcterms:source <https://w3id.org/ufes/ontodiplomadigital> ;
    owl:imports <https://w3id.org/ufes/ontodiplomadigital> ;
    rdfs:comment "Os dados pessoais, institucionais e acadêmicos desta extensão são fictícios e servem apenas para demonstração semântica. Os nomes e códigos de municípios usados na naturalidade correspondem a referências geográficas públicas do IBGE ou a nomes de municípios estrangeiros, sem identificar pessoas reais."@pt .

#################################################################
# Infraestrutura compartilhada
#################################################################

rec:plataformaConsultaPublicaFicticia
    a ont:PlataformaGoverno ;
    rdfs:label "Plataforma publica ficticia de consulta de diplomas"@pt ;
    ont:fullName "Portal Publico Ficticio de Consulta de Diplomas" ;
    ont:identifier "https://consulta-diploma.exemplo.gov.br" .

rec:agenteCertificadorFicticio
    a ont:AgenteCertificador ;
    rdfs:label "Agente certificador ficticio"@pt ;
    ont:fullName "Autoridade Certificadora Ficticia Raiz do Conhecimento" .

